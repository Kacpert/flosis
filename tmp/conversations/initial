  - external_reference: string (nullable) -- Phase 2: Jira issue key
  - external_type: string (nullable) -- Phase 2: "jira"
  - external_url: string (nullable) -- Phase 2: Jira issue URL

Tag
  - workspace_id: references
  - name: string
  - color: string (hex)

TimeEntry
  - workspace_id: references
  - user_id: references
  - project_id: references (nullable)
  - task_id: references (nullable)
  - description: text
  - start_time: datetime
  - end_time: datetime (nullable -- null means timer is running)
  - duration: integer (seconds, computed on stop)
  - billable: boolean
  - created_at / updated_at

TimeEntryTag (join table)
  - time_entry_id: references
  - tag_id: references

Integration (stub for Phase 2)
  - workspace_id: references
  - type: string (e.g., "jira")
  - config: jsonb (encrypted -- store API tokens, base URL, sync settings)
  - active: boolean (default: false)
