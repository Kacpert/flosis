<div class="max-w-lg mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)">Add Team Member</h1>
    <%= link_to "Back", workspace_members_path, class: "m3-btn m3-btn-text" %>
  </div>

  <%= form_with url: workspace_members_path, method: :post, class: "space-y-6" do |f| %>
    <div class="m3-card-elevated p-6 space-y-4">
      <div class="space-y-1">
        <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Name</label>
        <%= f.text_field :name, class: "m3-text-field w-full", required: true, placeholder: "Full name" %>
      </div>

      <div class="space-y-1">
        <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Email</label>
        <%= f.email_field :email_address, class: "m3-text-field w-full", required: true, placeholder: "email@example.com" %>
        <p class="text-xs" style="color: var(--color-outline)">New users will receive an invitation email to set their password. Existing users will be notified they've been added.</p>
      </div>

      <div class="space-y-1">
        <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Role</label>
        <%= f.select :role, [["Employee", "employee"], ["Admin", "admin"], ["Client", "client"], ["Workspace Client", "workspace_client"]],
            {}, class: "m3-text-field w-full" %>
        <div class="text-xs space-y-1 mt-2" style="color: var(--color-outline)">
          <p><strong>Admin</strong> &mdash; Full access to everything including settings and user management</p>
          <p><strong>Employee</strong> &mdash; Time entries, timesheet, tags, and reports (no monetary values)</p>
          <p><strong>Client</strong> &mdash; Reports only</p>
          <p><strong>Workspace Client</strong> &mdash; Full Workspace access (incl. pricing); manages everything but users; no Time &amp; HR</p>
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Add Member", class: "m3-btn m3-btn-filled" %>
    </div>
  <% end %>
</div>
