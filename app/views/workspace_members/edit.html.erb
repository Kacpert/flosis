<div class="max-w-lg mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)">Edit Member</h1>
    <%= link_to "Back", workspace_members_path, class: "m3-btn m3-btn-text" %>
  </div>

  <%= form_with url: workspace_member_path(@membership), method: :patch, class: "space-y-6" do |f| %>
    <div class="m3-card-elevated p-6 space-y-4">
      <div class="flex items-center gap-3 pb-4" style="border-bottom: 1px solid var(--color-outline-variant)">
        <div class="m3-avatar m3-avatar-md"><%= @membership.user.name.first(2).upcase %></div>
        <div>
          <div class="font-semibold" style="color: var(--color-on-surface)"><%= @membership.user.name %></div>
          <div class="text-sm" style="color: var(--color-on-surface-variant)"><%= @membership.user.email_address %></div>
        </div>
      </div>

      <div class="space-y-1">
        <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Role</label>
        <%= f.select :role,
            [["Employee", "employee"], ["Admin", "admin"], ["Client", "client"]],
            { selected: @membership.role }, class: "m3-text-field w-full" %>
        <div class="text-xs space-y-1 mt-2" style="color: var(--color-outline)">
          <p><strong>Admin</strong> &mdash; Full access to everything including settings and user management</p>
          <p><strong>Employee</strong> &mdash; Time entries, timesheet, tags, and reports (no monetary values)</p>
          <p><strong>Client</strong> &mdash; Reports only</p>
        </div>
      </div>

      <div class="space-y-2 pt-4" style="border-top: 1px solid var(--color-outline-variant)">
        <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Product access</label>
        <p class="text-xs" style="color: var(--color-outline)">Which products this member can open. Clients are always Jira-Tasks-only (Workshop).</p>
        <input type="hidden" name="time_hr_access" value="0">
        <label class="flex items-center justify-between gap-4 cursor-pointer">
          <span class="text-sm" style="color: var(--color-on-surface)">Time &amp; HR</span>
          <input type="checkbox" name="time_hr_access" value="1" class="m3-checkbox" <%= "checked" if @membership.time_hr_access %>>
        </label>
        <input type="hidden" name="workshop_access" value="0">
        <label class="flex items-center justify-between gap-4 cursor-pointer">
          <span class="text-sm" style="color: var(--color-on-surface)">Workshop</span>
          <input type="checkbox" name="workshop_access" value="1" class="m3-checkbox" <%= "checked" if @membership.workshop_access %>>
        </label>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Update Member", class: "m3-btn m3-btn-filled" %>
    </div>
  <% end %>
</div>
