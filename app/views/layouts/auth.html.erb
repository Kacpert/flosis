<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Sign in · Flosis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Flosis">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/flosis-icon.png" type="image/png">
    <link rel="icon" href="/flosis-icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/flosis-icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
      (function(){
        try {
          var t = localStorage.getItem("clarTheme");
          if (t === "dark" || t === "light") {
            document.documentElement.dataset.clarThemePending = t;
          }
        } catch (e) {}
      })();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <%# Scoped under .clar-app so the auth screens get the Flosis tokens, font
        and theming — the signed-in shell uses the same scope. %>
    <div class="clar-app flex h-screen overflow-hidden" data-controller="clar-theme" data-clar-theme="light">
      <script>
        (function(el){
          var t = el.ownerDocument.documentElement.dataset.clarThemePending;
          if (t) el.setAttribute("data-clar-theme", t);
        })(document.currentScript.closest(".clar-app"));
      </script>

      <%# Left: brand row, the form, and the access note. %>
      <div class="flex-1 min-w-0 flex flex-col overflow-y-auto py-7 px-8">
        <div class="flex items-center justify-between">
          <%# Bigger than the topbar's mark, and on a viewBox cropped to the
              artwork so the extra size isn't eaten by whitespace. %>
          <div class="flex items-center gap-2">
            <svg width="34" height="29" viewBox="3.5 1 39 33.5" class="flex-none block">
              <g stroke-linecap="round">
                <line x1="6" y1="10" x2="22" y2="10" stroke="var(--ai)" stroke-width="5"/>
                <circle cx="28.4" cy="9.6" r="2.7" fill="var(--mk1)"/>
                <circle cx="34.39" cy="8" r="2.2" fill="var(--mk2)"/>
                <circle cx="38.12" cy="2.68" r="1.7" fill="var(--mk3)"/>
                <line x1="6" y1="21" x2="40" y2="21" stroke="var(--text)" stroke-width="5" opacity=".85"/>
                <line x1="6" y1="32" x2="30" y2="32" stroke="var(--text)" stroke-width="5" opacity=".5"/>
              </g>
            </svg>
            <span class="clar-wordmark clar-wordmark-lg">Flos<span class="dotless">&#305;</span>s</span>
          </div>
          <button type="button" data-action="click->clar-theme#toggle" title="Toggle theme"
                  class="w-8 h-8 rounded-[8px] border flex items-center justify-center cursor-pointer"
                  style="border-color: var(--border); background: var(--surface); color: var(--muted);">
            <svg data-clar-theme-target="sunIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg data-clar-theme-target="moonIcon" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </div>

        <div class="flex-1 flex items-center justify-center py-10">
          <div class="w-full max-w-[368px]">
            <% if flash[:notice] %>
              <div class="flex items-center gap-[7px] text-[12.5px] rounded-[9px] border clar-divider py-[9px] px-[11px] mb-3.5"
                   style="color: var(--success); background: var(--success-soft);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
                <span><%= flash[:notice] %></span>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="flex items-center gap-[7px] text-[12.5px] rounded-[9px] border clar-divider py-[9px] px-[11px] mb-3.5"
                   style="color: var(--danger); background: var(--danger-soft);">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                <span><%= flash[:alert] %></span>
              </div>
            <% end %>

            <%= yield %>
          </div>
        </div>

        <div class="text-[11.5px] clar-text-faint">app.flosis.com &middot; Administrator &amp; Product Owner access</div>
      </div>

      <%# Right: the pitch. Hidden below lg — on a phone the form is the page. %>
      <div class="hidden lg:flex flex-none w-[46%] min-w-0 flex-col justify-center gap-[26px] p-11 border-l clar-divider"
           style="background: var(--surface);">
        <div>
          <div class="text-[11.5px] font-bold tracking-[.1em] clar-text-ai">FROM ROUGH IDEAS TO READY TICKETS</div>
          <h2 class="mt-3 mb-0 text-[29px] font-bold tracking-[-.9px] leading-[1.25] clar-text-text">An AI teammate that reads your code before it asks anything.</h2>
        </div>

        <div class="flex flex-col gap-3">
          <%
            features = [
              ["Briefing &amp; Details Gathering", "Turns a one-line idea into an implementation-ready Jira description.",
               '<path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/>'],
              ["Scheduled agents with memory", "Prompt-driven automations that remember what they already reported, so you only hear what changed.",
               '<path d="M12 2a5 5 0 0 1 5 5v1a4 4 0 0 1 0 8v1a5 5 0 0 1-10 0v-1a4 4 0 0 1 0-8V7a5 5 0 0 1 5-5zM12 2v20"/>'],
              ["Reporting &amp; bug attribution", "Throughput, cost and who introduced each bug &mdash; with confidence.",
               '<path d="M3 3v18h18"/><rect x="7" y="11" width="3" height="6"/><rect x="13" y="7" width="3" height="10"/>'],
              ["AI PR reviews &amp; estimates", "Comments on every pull request and writes story points to Jira.",
               '<path d="M21 12a9 9 0 1 1-6.2-8.5"/><path d="M21 4v5h-5"/>']
            ]
          %>
          <% features.each do |title, body, icon| %>
            <div class="flex gap-3 items-start rounded-[12px] border clar-divider py-3.5 px-[15px]" style="background: var(--bg);">
              <span class="w-[30px] h-[30px] flex-none rounded-[8px] flex items-center justify-center clar-badge-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><%= icon.html_safe %></svg>
              </span>
              <div>
                <div class="text-[13.5px] font-[650] clar-text-text"><%= title.html_safe %></div>
                <div class="text-[12.5px] clar-text-muted leading-[1.5] mt-[3px]"><%= body.html_safe %></div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="flex items-center gap-2.5 text-[12px] clar-text-faint">
          <span class="inline-flex items-center gap-1.5"><span class="w-[7px] h-[7px] rounded-full" style="background: var(--ai);"></span>Claude Opus</span>
          <span>&middot;</span><span>Jira Cloud</span><span>&middot;</span><span>GitHub</span><span>&middot;</span><span>Figma</span>
        </div>
      </div>
    </div>
  </body>
</html>
