<%# Clar workshop top bar: logo, project switcher, integration chips,
    theme toggle, user chip. Structure/icons ported from redesign.html. %>
<header class="clar-topbar">
  <%# Flosis mark: three stacked rules (the "backlog") with the top one clearing
      into three shrinking dots, plus the wordmark whose dotless ı carries the
      mark's primary dot. Ported 1:1 from ClearBacklog.html. %>
  <div class="flex items-center gap-1.5 pr-1.5">
    <svg width="28" height="22" viewBox="0 0 56 44" class="flex-none">
      <g stroke-linecap="round">
        <line x1="6" y1="10" x2="22" y2="10" stroke="var(--ai)" stroke-width="5"/>
        <circle cx="28.4" cy="9.6" r="2.7" fill="var(--mk1)"/>
        <circle cx="34.39" cy="8" r="2.2" fill="var(--mk2)"/>
        <circle cx="38.12" cy="2.68" r="1.7" fill="var(--mk3)"/>
        <line x1="6" y1="21" x2="40" y2="21" stroke="var(--text)" stroke-width="5" opacity=".85"/>
        <line x1="6" y1="32" x2="30" y2="32" stroke="var(--text)" stroke-width="5" opacity=".5"/>
      </g>
    </svg>
    <span class="clar-wordmark">Flos<span class="dotless">&#305;</span>s</span>
  </div>

  <div class="relative" data-controller="clar-dropdown">
    <button type="button" data-action="click->clar-dropdown#toggle"
            class="flex items-center gap-2 h-8 px-2.5 rounded-[8px] border cursor-pointer"
            style="border-color: var(--border); background: var(--surface-2); color: var(--text);">
      <span class="w-1.5 h-1.5 rounded-full" style="background: var(--success);"></span>
      <span class="font-semibold text-[12.5px]"><%= current_workshop_project&.name || "No project selected" %></span>
      <% if current_workshop_project&.client %>
        <span class="text-[10.5px] font-normal clar-text-faint"><%= current_workshop_project.client.name %></span>
      <% end %>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
    </button>

    <div data-clar-dropdown-target="panel" class="hidden absolute top-10 left-0 w-[300px] clar-card clar-fade" style="box-shadow: var(--shadow-lg); padding: 6px; z-index: 50;">
      <div class="text-[10.5px] font-bold tracking-wide px-2.5 pt-2 pb-1 clar-text-faint" style="letter-spacing: .6px;">SWITCH PROJECT &middot; SWAPS EVERYTHING</div>
      <% workshop_projects.each do |project| %>
        <%= button_to switch_workshop_project_path, params: { project_id: project.id }, method: :post,
              class: "flex items-center justify-between w-full px-2.5 py-2.5 rounded-lg border-0 text-left #{'bg-black/[.03]' if project == current_workshop_project}",
              style: project == current_workshop_project ? "background: var(--surface-2);" : "background: transparent;" do %>
          <div class="flex flex-col gap-0.5 text-left">
            <span class="font-semibold text-[13.5px]"><%= project.name %></span>
            <span class="text-[11.5px] clar-text-faint"><%= [project.client&.name, project.external_reference].compact.join(" · ") %></span>
          </div>
          <% if project == current_workshop_project %>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-[7px]">
    <%
      jira_on = current_workshop_project&.jira_connected?
      github_on = Current.workspace.github_repo.present? && Current.workspace.github_status_ok
      discord_on = Current.workspace.discord_channel_id.present?
      figma_on = Current.workspace.figma_read_enabled
      chips = { "Jira" => jira_on, "GitHub" => github_on, "Discord" => discord_on, "Figma" => figma_on }
    %>
    <% chips.each do |label, on| %>
      <div title="<%= label %><%= on ? ' connected' : ' not connected' %>"
           class="flex items-center gap-[5px] text-[11px] font-semibold rounded-[7px] border px-2 py-1 <%= on ? 'clar-text-muted' : 'clar-text-faint' %>"
           style="background: var(--surface-2); border-color: var(--border);">
        <span class="w-1.5 h-1.5 rounded-full" style="background: <%= on ? 'var(--success)' : 'var(--faint)' %>;"></span><%= label %>
      </div>
    <% end %>
  </div>

  <div class="flex-1"></div>

  <button type="button" data-action="click->clar-theme#toggle" title="Toggle theme"
          class="w-9 h-9 rounded-[9px] border flex items-center justify-center cursor-pointer"
          style="border-color: var(--border); background: var(--surface-2); color: var(--text);">
    <svg data-clar-theme-target="sunIcon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    <svg data-clar-theme-target="moonIcon" class="hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  </button>

  <%# No card/border around the account chip — the design renders it as bare
      avatar + two lines. The avatar itself is the primary→ai gradient. %>
  <div class="relative" data-controller="clar-dropdown">
    <button type="button" data-action="click->clar-dropdown#toggle"
            class="flex items-center gap-[9px] pl-1 bg-transparent border-0 cursor-pointer"
            style="color: var(--text);" title="Account menu">
      <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-[12px] flex-none"
           style="background: linear-gradient(135deg, var(--primary), var(--ai));">
        <%= clar_initials(current_user.name) %>
      </div>
      <div class="flex flex-col text-left" style="line-height: 1.15;">
        <span class="text-[12.5px] font-semibold"><%= current_user.name %></span>
        <span class="text-[10.5px] font-normal clar-text-faint">
          <%= current_user.admin_or_owner?(Current.workspace) ? "Administrator" : "Product Owner" %>
        </span>
      </div>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="clar-text-faint"><path d="M6 9l6 6 6-6"/></svg>
    </button>

    <div data-clar-dropdown-target="panel" class="hidden absolute top-[42px] right-0 w-[240px] clar-card clar-fade" style="box-shadow: var(--shadow-lg); padding: 6px; z-index: 50;">
      <% if current_user.can_access_product?(current_workspace, :time_hr) %>
        <%= button_to switch_product_path, params: { product: "time_hr" }, method: :post,
              class: "flex items-center gap-2.5 w-full px-2.5 py-2.5 rounded-lg border-0 text-left clar-btn",
              style: "background: transparent;" do %>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="clar-text-primary"><path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
          <span class="font-semibold text-[13px]">Switch to Time &amp; HR</span>
        <% end %>
        <div class="my-1.5 border-t" style="border-color: var(--border);"></div>
      <% end %>

      <%= button_to session_path, method: :delete,
            class: "flex items-center gap-2.5 w-full px-2.5 py-2.5 rounded-lg border-0 text-left clar-btn",
            style: "background: transparent;" do %>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="clar-text-danger"><path d="M17 16l4-4m0 0l-4-4m4 4H7M13 16v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
        <span class="font-semibold text-[13px]">Log out</span>
      <% end %>
    </div>
  </div>
</header>
