<%# flash[:notice]/flash[:alert] rendering for the Clar workshop shell.
    flash[:clar_toast] is handled separately by clar_toast_controller.js. %>
<% if flash[:notice] %>
  <div class="clar-badge clar-badge-success mb-4" style="display: flex; padding: 10px 14px; font-size: 13px;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
    <span><%= flash[:notice] %></span>
  </div>
<% end %>
<% if flash[:alert] %>
  <div class="clar-badge clar-badge-danger mb-4" style="display: flex; padding: 10px 14px; font-size: 13px;">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    <span><%= flash[:alert] %></span>
  </div>
<% end %>
