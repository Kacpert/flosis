<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Hidmin · Flosis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/flosis-icon.png" type="image/png">
    <link rel="icon" href="/flosis-icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
      (function(){
        try {
          var t = localStorage.getItem("clarTheme");
          if (t === "dark" || t === "light") {
            document.documentElement.dataset.clarThemePending = t;
          }
        } catch (e) {}
      })();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <%# The Workshop's tokens and theming, without its sidebar: hidmin stands
        outside every workspace, so nothing here is about the current one. %>
    <div class="clar-app flex flex-col h-screen overflow-hidden" data-controller="clar-theme" data-clar-theme="light">
      <script>
        (function(el){
          var t = el.ownerDocument.documentElement.dataset.clarThemePending;
          if (t) el.setAttribute("data-clar-theme", t);
        })(document.currentScript.closest(".clar-app"));
      </script>

      <header class="clar-topbar">
        <%= link_to hidmin_root_path, class: "flex items-center gap-1.5 no-underline" do %>
          <svg width="28" height="22" viewBox="0 0 56 44" class="flex-none">
            <g stroke-linecap="round">
              <line x1="6" y1="10" x2="22" y2="10" stroke="var(--ai)" stroke-width="5"/>
              <circle cx="28.4" cy="9.6" r="2.7" fill="var(--mk1)"/>
              <circle cx="34.39" cy="8" r="2.2" fill="var(--mk2)"/>
              <circle cx="38.12" cy="2.68" r="1.7" fill="var(--mk3)"/>
              <line x1="6" y1="21" x2="40" y2="21" stroke="var(--text)" stroke-width="5" opacity=".85"/>
              <line x1="6" y1="32" x2="30" y2="32" stroke="var(--text)" stroke-width="5" opacity=".5"/>
            </g>
          </svg>
          <span class="clar-wordmark">Flos<span class="dotless">&#305;</span>s</span>
          <span class="clar-badge clar-badge-warn ml-1.5">Hidmin</span>
        <% end %>

        <nav class="clar-tabs">
          <% [ [ "Overview", hidmin_root_path, controller_name == "dashboard" ],
               [ "Organizations", hidmin_workspaces_path, controller_name.in?(%w[workspaces memberships]) ],
               [ "People", hidmin_users_path, controller_name == "users" ] ].each do |label, path, active| %>
            <%= link_to label, path, class: "clar-tab no-underline #{'clar-tab-active' if active}" %>
          <% end %>
        </nav>

        <div class="flex-1"></div>

        <%= link_to "Back to the app", root_path, class: "text-[13px] font-semibold clar-text-muted no-underline" %>
        <button type="button" data-action="click->clar-theme#toggle" title="Toggle theme"
                class="w-8 h-8 rounded-[8px] border clar-divider flex items-center justify-center cursor-pointer clar-text-muted bg-transparent">
          <svg data-clar-theme-target="sunIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg data-clar-theme-target="moonIcon" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <span class="text-[13px] clar-text-muted"><%= current_user.name %></span>
      </header>

      <main class="flex-1 min-h-0 overflow-y-auto">
        <div class="max-w-[1120px] mx-auto px-[30px] pt-[26px] pb-[60px]">
          <%= render "layouts/clar_flash" %>
          <%= yield %>
        </div>
      </main>
    </div>
  </body>
</html>
