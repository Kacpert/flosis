<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Flosis admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/flosis-icon.png" type="image/png">
    <link rel="icon" href="/flosis-icon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <script>
      (function(){
        try {
          var t = localStorage.getItem("clarTheme");
          if (t === "dark" || t === "light") {
            document.documentElement.dataset.clarThemePending = t;
          }
        } catch (e) {}
      })();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen">
    <%# The Workshop's tokens and theming, without its sidebar: hidmin stands
        outside every workspace, so nothing here is about the current one. %>
    <%# clar-toast: the confirmations the billing pages leave in flash[:clar_toast]. %>
    <div class="clar-app flex flex-col h-screen overflow-hidden" data-controller="clar-theme clar-toast" data-clar-theme="light"
         data-clar-toast-initial-value="<%= flash[:clar_toast] %>" data-clar-toast-link-value="<%= flash[:clar_toast_link] %>">
      <script>
        (function(el){
          var t = el.ownerDocument.documentElement.dataset.clarThemePending;
          if (t) el.setAttribute("data-clar-theme", t);
        })(document.currentScript.closest(".clar-app"));
      </script>

      <%# The Flosis-admin shell (SCRUM-70, the accepted flosis-admin-shell):
          staff stand outside every organization, so nothing here is about
          the current one. The FLOSIS ADMIN badge is the warning that cost,
          margins and other organizations' figures live only here. %>
      <header class="clar-topbar">
        <%= link_to hidmin_plans_path, class: "flex items-center gap-1.5 no-underline" do %>
          <svg width="28" height="22" viewBox="0 0 56 44" class="flex-none" role="img" aria-label="Flosis">
            <g stroke-linecap="round">
              <line x1="6" y1="10" x2="22" y2="10" stroke="var(--ai)" stroke-width="5"/>
              <circle cx="28.4" cy="9.6" r="2.7" fill="var(--mk1)"/>
              <circle cx="34.39" cy="8" r="2.2" fill="var(--mk2)"/>
              <circle cx="38.12" cy="2.68" r="1.7" fill="var(--mk3)"/>
              <line x1="6" y1="21" x2="40" y2="21" stroke="var(--text)" stroke-width="5" opacity=".85"/>
              <line x1="6" y1="32" x2="30" y2="32" stroke="var(--text)" stroke-width="5" opacity=".5"/>
            </g>
          </svg>
          <span class="clar-wordmark">Flos<span class="dotless">&#305;</span>s</span>
        <% end %>
        <span class="clar-badge clar-badge-ai ml-1.5 tracking-[.4px]">FLOSIS ADMIN</span>

        <div class="flex-1"></div>

        <%= link_to "Back to the app", root_path, class: "text-[13px] font-semibold clar-text-muted no-underline" %>
        <button type="button" data-action="click->clar-theme#toggle" title="Toggle theme"
                class="w-8 h-8 rounded-[8px] border clar-divider flex items-center justify-center cursor-pointer clar-text-muted bg-transparent">
          <svg data-clar-theme-target="sunIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg data-clar-theme-target="moonIcon" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        <span class="flex items-center gap-2.25">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full text-[12px] font-bold text-white"
                style="background: linear-gradient(135deg, var(--primary), var(--ai));"><%= current_user.name.split.map(&:first).first(2).join.upcase %></span>
          <span class="flex flex-col text-left leading-[1.2]">
            <span class="text-[12.5px] font-semibold clar-text-text"><%= current_user.name %></span>
            <span class="text-[10.5px] clar-text-faint">Flosis staff</span>
          </span>
        </span>
      </header>

      <div class="flex min-h-0 flex-1">
        <%# Billing first — it is what this place is for — then the staff pages
            that were here before it (organizations' products and people). %>
        <nav class="clar-sidebar" aria-label="Flosis admin">
          <div class="flex flex-col gap-[3px]">
            <span class="clar-nav-label">BILLING</span>
            <% [ [ "Plans", hidmin_plans_path, controller_name == "plans",
                   '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>' ],
                 [ "Models & prices", hidmin_ai_models_path, controller_name == "ai_models",
                   '<path d="M12 2l3 6.5 7 1-5 5 1.2 7L12 18l-6.2 3.5L7 14.5l-5-5 7-1z"/>' ],
                 [ "Organizations", hidmin_workspaces_path, controller_name.in?(%w[workspaces memberships]),
                   '<path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6"/>' ] ].each do |label, path, active, icon| %>
              <%= link_to path, class: "clar-nav-item no-underline #{'clar-nav-item-active' if active}" do %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-none"><%= icon.html_safe %></svg>
                <span class="flex-1 text-left"><%= label %></span>
              <% end %>
            <% end %>

            <span class="clar-nav-label mt-3">STAFF</span>
            <% [ [ "Overview", hidmin_root_path, controller_name == "dashboard",
                   '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>' ],
                 [ "People", hidmin_users_path, controller_name == "users",
                   '<circle cx="9" cy="7" r="4"/><path d="M2 21v-2a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v2M16 3.1a4 4 0 0 1 0 7.8M22 21v-2a4 4 0 0 0-3-3.9"/>' ] ].each do |label, path, active, icon| %>
              <%= link_to path, class: "clar-nav-item no-underline #{'clar-nav-item-active' if active}" do %>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-none"><%= icon.html_safe %></svg>
                <span class="flex-1 text-left"><%= label %></span>
              <% end %>
            <% end %>
          </div>
        </nav>

        <main class="flex-1 min-h-0 min-w-0 overflow-y-auto">
          <div class="max-w-[1180px] mx-auto px-[30px] pt-[26px] pb-[60px]">
            <%= render "layouts/clar_flash" %>
            <%= yield %>
          </div>
        </main>
      </div>
    </div>
  </body>
</html>
