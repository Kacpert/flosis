<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
  </head>
  <%# The billing emails (SCRUM-71, design email-frame): the mark, the message,
      one button, and why this person got it. Light theme only and inline
      styles: mail clients take neither the page's tokens nor <style>. %>
  <body style="margin:0; padding:0; background:#f6f7f9;">
    <div style="max-width:560px; margin:0 auto; padding:32px 20px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif; color:#1a1d24;">
      <div style="background:#ffffff; border:1px solid #e6e8ec; border-radius:14px; padding:28px 28px 24px;">
        <div style="font-size:18px; font-weight:700; letter-spacing:-.3px; margin:0 0 18px; color:#1a1d24;">Flosis</div>
        <%= yield %>
        <% if @cta %>
          <p style="margin:22px 0 0;">
            <a href="<%= @cta_url %>" style="display:inline-block; background:#3b5bdb; color:#ffffff; text-decoration:none; font-weight:600; font-size:14px; padding:11px 18px; border-radius:9px;"><%= @cta %></a>
          </p>
        <% end %>
      </div>
      <p style="margin:18px 0 0; font-size:12px; line-height:1.5; color:#9aa3af; text-align:center;">
        <%= @why %><br><%= Billing::Seller.footer %>
      </p>
    </div>
  </body>
</html>
