<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Clar" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Clar">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <script>
      (function(){var t=localStorage.getItem("theme");if(t&&t!=="light"){document.documentElement.setAttribute("data-theme",t)}else if(!t&&window.matchMedia("(prefers-color-scheme:dark)").matches){document.documentElement.setAttribute("data-theme","dark")}})();
    </script>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen" data-controller="keyboard-shortcuts">
    <% if current_user && Current.workspace %>
      <%# Top App Bar — full width %>
      <header class="sticky top-0 z-50 m3-top-bar <%= @running_timer ? 'navbar-timer-running' : '' %>">
        <div class="flex items-center gap-3 px-5 h-14">
          <div class="flex-1 min-w-0">
            <% if current_user.at_least_employee?(current_workspace) %>
              <%= render "shared/timer_bar" %>
            <% else %>
              <span class="text-sm font-medium" style="color: var(--color-on-surface)"><%= current_workspace.name %></span>
            <% end %>
          </div>
        </div>
      </header>

      <div class="flex h-[calc(100vh-3.5rem)]">
        <%# Mobile drawer %>
        <input type="checkbox" id="sidebar-toggle" class="m3-drawer-toggle">
        <label for="sidebar-toggle" class="m3-drawer-overlay"></label>

        <%# Sidebar / Nav Rail %>
        <aside id="app-sidebar" class="m3-drawer-side m3-nav-rail w-64 lg:block flex-shrink-0 h-full flex flex-col overflow-y-auto">
          <%# Navigation %>
          <nav class="flex-1 px-3 pt-4 space-y-0.5 overflow-y-auto">
            <% unless current_user.client_role?(current_workspace) %>
              <%= link_to time_entries_path, class: "m3-nav-item #{current_page?(time_entries_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>Time Entries</span>
              <% end %>

              <%= link_to timesheet_path, class: "m3-nav-item #{current_page?(timesheet_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0112 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M10.875 12c-.621 0-1.125.504-1.125 1.125M12 10.875c-.621 0-1.125.504-1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 1.5v-1.5" /></svg>
                <span>Timesheet</span>
              <% end %>

              <% if current_workspace.projects.active.where(external_type: "jira").exists? %>
                <%= link_to jira_tasks_path, class: "m3-nav-item #{request.path.start_with?('/jira_tasks') ? 'active' : ''}" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4.5v15m6-15v15m-10.875 0h15.75c.621 0 1.125-.504 1.125-1.125V5.625c0-.621-.504-1.125-1.125-1.125H4.125C3.504 4.5 3 5.004 3 5.625v12.75c0 .621.504 1.125 1.125 1.125z" /></svg>
                  <span>Jira Tasks</span>
                <% end %>
              <% end %>
            <% end %>

            <% if current_user.admin_or_owner?(current_workspace) %>
              <div class="pt-7 pb-2">
                <div class="m3-nav-section">Manage</div>
              </div>

              <%= link_to projects_path, class: "m3-nav-item #{current_page?(projects_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" /></svg>
                <span>Projects</span>
              <% end %>

              <%= link_to clients_path, class: "m3-nav-item #{current_page?(clients_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                <span>Clients</span>
              <% end %>

              <%= link_to workspace_members_path, class: "m3-nav-item #{current_page?(workspace_members_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" /></svg>
                <span>Team</span>
              <% end %>
            <% end %>

            <% unless current_user.client_role?(current_workspace) %>
              <%= link_to holiday_requests_path, class: "m3-nav-item #{request.path.start_with?('/holiday') ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zm6.75-4.5h.008v.008h-.008v-.008zm0 2.25h.008v.008h-.008V15zm0 2.25h.008v.008h-.008v-.008zm2.25-4.5h.008v.008H16.5v-.008zm0 2.25h.008v.008H16.5V15z" /></svg>
                <span>Holidays</span>
              <% end %>

              <%= link_to feedback_meetings_path, class: "m3-nav-item #{request.path.start_with?('/feedback_meetings') ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>
                <span>Feedback</span>
              <% end %>
            <% end %>

            <% unless current_user.client_role?(current_workspace) %>
              <div class="pt-4"></div>
              <%= link_to tags_path, class: "m3-nav-item #{current_page?(tags_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
                <span>Tags</span>
              <% end %>
            <% end %>

            <% if current_user.admin_or_owner?(current_workspace) %>
              <div class="pt-7 pb-2">
                <div class="m3-nav-section">Reports</div>
              </div>

              <%= link_to reports_summary_path, class: "m3-nav-item #{current_page?(reports_summary_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                <span>Summary</span>
              <% end %>

              <%= link_to reports_detailed_path, class: "m3-nav-item #{current_page?(reports_detailed_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                <span>Detailed</span>
              <% end %>

              <%= link_to reports_weekly_path, class: "m3-nav-item #{current_page?(reports_weekly_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                <span>Weekly</span>
              <% end %>
            <% end %>

            <div class="pt-4 pb-1 relative" data-controller="theme">
              <button class="m3-nav-item w-full" data-action="click->theme#toggleMenu">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" data-theme-target="icon"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
                <span data-theme-target="label">Theme</span>
              </button>
              <div class="hidden absolute bottom-full left-0 mb-2 m3-menu z-50 w-52" data-theme-target="menu">
                <button class="m3-menu-item" data-action="click->theme#select" data-theme="light">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" /></svg>
                  Light
                </button>
                <button class="m3-menu-item" data-action="click->theme#select" data-theme="dark">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" /></svg>
                  Dark
                </button>
                <hr class="m3-menu-divider">
                <button class="m3-menu-item" data-action="click->theme#select" data-theme="purple-light">
                  <span class="inline-block w-4 h-4 rounded-full" style="background: linear-gradient(135deg, #7C4DFF, #A78BFA)"></span>
                  Purple
                </button>
                <button class="m3-menu-item" data-action="click->theme#select" data-theme="purple-dark">
                  <span class="inline-block w-4 h-4 rounded-full" style="background: linear-gradient(135deg, #5635A2, #7C4DFF)"></span>
                  Purple Dark
                </button>
              </div>
            </div>
          </nav>

          <%# Bottom user section — pinned to bottom %>
          <div class="px-3 py-3 border-t mt-auto" style="border-color: var(--color-outline-variant)">
            <div class="relative">
              <button class="flex items-center gap-2.5 px-2 py-1.5 rounded-[var(--radius-md)] w-full transition-colors" style="color: var(--color-on-surface-variant)" onclick="this.nextElementSibling.classList.toggle('hidden')" type="button">
                <div class="m3-avatar m3-avatar-sm"><%= current_user.name.first(2).upcase %></div>
                <span class="flex-1 min-w-0 text-[0.8125rem] font-medium truncate" style="color: var(--color-on-surface)"><%= current_user.name %></span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.204-.107-.397.165-.71.505-.78.929l-.15.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
              </button>
              <div class="hidden absolute bottom-full left-0 mb-2 m3-menu z-50 w-56">
                <%= link_to "Profile", profile_path, class: "m3-menu-item" %>
                <hr class="m3-menu-divider">
                <div class="m3-menu-label">Switch Workspace</div>
                <% current_user.workspaces.each do |ws| %>
                  <% unless ws == Current.workspace %>
                    <%= button_to ws.name, switch_workspace_path(ws), method: :post, class: "m3-menu-item" %>
                  <% end %>
                <% end %>
                <%= link_to "New Workspace", new_workspace_path, class: "m3-menu-item" %>
                <hr class="m3-menu-divider">
                <%= button_to "Sign Out", session_path, method: :delete, class: "m3-menu-item" %>
              </div>
            </div>
          </div>
        </aside>

        <%# Main content %>
        <main class="flex-1 p-5 lg:p-8 min-w-0 overflow-y-auto">
          <div class="<%= content_for?(:full_width) ? '' : 'max-w-5xl' %> mx-auto">
            <% if flash[:notice] %>
              <div class="m3-alert m3-alert-success mb-4" data-controller="flash">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span><%= flash[:notice] %></span>
              </div>
            <% end %>
            <% if flash[:alert] %>
              <div class="m3-alert m3-alert-error mb-4" data-controller="flash">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                <span><%= flash[:alert] %></span>
              </div>
            <% end %>
            <%= yield %>
          </div>
        </main>
      </div>

    <% else %>
      <%# Guest layout %>
      <div class="min-h-screen flex items-center justify-center" style="background: var(--color-surface-container-low)">
        <div class="w-full max-w-md px-4">
          <div class="text-center mb-8">
            <div class="flex items-center justify-center gap-2 mb-3">
              <div class="w-10 h-10 rounded-[var(--radius-lg)] flex items-center justify-center" style="background: var(--color-primary)">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" style="color: var(--color-on-primary)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
            </div>
            <h1 class="text-3xl font-bold" style="color: var(--color-on-surface)">Clar</h1>
            <p class="mt-1" style="color: var(--color-on-surface-variant)">Track time. Ship faster.</p>
          </div>

          <% if flash[:notice] %>
            <div class="m3-alert m3-alert-success mb-4"><span><%= flash[:notice] %></span></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="m3-alert m3-alert-error mb-4"><span><%= flash[:alert] %></span></div>
          <% end %>

          <div class="m3-card-elevated" style="padding: 2rem; border-radius: var(--radius-xl);">
            <%= yield %>
          </div>

          <p class="text-center text-xs mt-8" style="color: var(--color-outline)">Clar Time Tracking</p>
        </div>
      </div>
    <% end %>
  </body>
</html>
