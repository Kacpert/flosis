<!DOCTYPE html>
<html data-theme="corporate">
  <head>
    <title><%= content_for(:title) || "Gold" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Gold">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#f5f3f8]" data-controller="keyboard-shortcuts">
    <% if current_user && Current.workspace %>
      <%# Timer bar — full width on top %>
      <header class="sticky top-0 z-50 bg-white shadow-sm <%= @running_timer ? 'navbar-timer-running' : '' %>">
        <div class="flex items-center gap-3 px-5 h-[3.5rem]">
          <div class="flex-none lg:hidden">
            <label for="sidebar-drawer" class="btn btn-ghost btn-sm btn-square">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="w-5 h-5 stroke-current"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </label>
          </div>
          <div class="flex-1 min-w-0">
            <%= render "shared/timer_bar" %>
          </div>
        </div>
      </header>

      <div class="drawer lg:drawer-open">
        <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" />

        <div class="drawer-content flex flex-col">
          <!-- Main content -->
          <main class="flex-1 p-5 lg:p-8">
            <div class="max-w-5xl mx-auto">
              <% if flash[:notice] %>
                <div class="alert alert-success mb-4 rounded-xl shadow-sm" data-controller="flash">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                  <span><%= flash[:notice] %></span>
                </div>
              <% end %>
              <% if flash[:alert] %>
                <div class="alert alert-error mb-4 rounded-xl shadow-sm" data-controller="flash">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
                  <span><%= flash[:alert] %></span>
                </div>
              <% end %>

              <%= yield %>
            </div>
          </main>
        </div>

        <!-- Sidebar -->
        <div class="drawer-side z-40">
          <label for="sidebar-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
          <aside class="sidebar-light min-h-full w-[16.5rem] flex flex-col">
            <!-- User avatar + name -->
            <div class="px-5 pt-6 pb-5">
              <div class="flex items-center gap-3">
                <div class="user-avatar user-avatar-md">
                  <%= current_user.name.first.upcase %>
                </div>
                <span class="text-[0.9375rem] font-semibold text-[#2d2b3a] truncate"><%= current_user.name.split.first %></span>
              </div>
            </div>

            <!-- Navigation -->
            <nav class="flex-1 px-3 space-y-0.5 overflow-y-auto">
              <%= link_to root_path, class: "sidebar-nav-item #{current_page?(root_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
                <span>Dashboard</span>
              <% end %>

              <%= link_to time_entries_path, class: "sidebar-nav-item #{current_page?(time_entries_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                <span>Time Entries</span>
              <% end %>

              <%= link_to timesheet_path, class: "sidebar-nav-item #{current_page?(timesheet_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 01-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625m0 12.75v-1.5c0-.621.504-1.125 1.125-1.125m18.375 2.625V5.625m0 12.75c0 .621-.504 1.125-1.125 1.125m1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125m0 3.75h-7.5A1.125 1.125 0 0112 18.375m9.75-12.75c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125m19.5 0v1.5c0 .621-.504 1.125-1.125 1.125M2.25 5.625v1.5c0 .621.504 1.125 1.125 1.125m0 0h17.25m-17.25 0h7.5c.621 0 1.125.504 1.125 1.125M3.375 8.25c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125m17.25-3.75h-7.5c-.621 0-1.125.504-1.125 1.125m8.625-1.125c.621 0 1.125.504 1.125 1.125v1.5c0 .621-.504 1.125-1.125 1.125m-17.25 0h7.5m-7.5 0c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125M12 10.875v-1.5m0 1.5c0 .621-.504 1.125-1.125 1.125M12 10.875c0 .621.504 1.125 1.125 1.125m-2.25 0c.621 0 1.125.504 1.125 1.125M10.875 12c-.621 0-1.125.504-1.125 1.125M12 10.875c-.621 0-1.125.504-1.125 1.125m0 1.5v-1.5m0 0c0-.621.504-1.125 1.125-1.125m0 1.5v-1.5" /></svg>
                <span>Timesheet</span>
              <% end %>

              <div class="pt-7 pb-2">
                <div class="sidebar-section-label">Manage</div>
              </div>

              <%= link_to projects_path, class: "sidebar-nav-item #{current_page?(projects_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" /></svg>
                <span>Projects</span>
              <% end %>

              <%= link_to clients_path, class: "sidebar-nav-item #{current_page?(clients_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" /></svg>
                <span>Clients</span>
              <% end %>

              <%= link_to tags_path, class: "sidebar-nav-item #{current_page?(tags_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
                <span>Tags</span>
              <% end %>

              <div class="pt-7 pb-2">
                <div class="sidebar-section-label">Reports</div>
              </div>

              <%= link_to reports_summary_path, class: "sidebar-nav-item #{current_page?(reports_summary_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                <span>Summary</span>
              <% end %>

              <%= link_to reports_detailed_path, class: "sidebar-nav-item #{current_page?(reports_detailed_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                <span>Detailed</span>
              <% end %>

              <%= link_to reports_weekly_path, class: "sidebar-nav-item #{current_page?(reports_weekly_path) ? 'active' : ''}" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                <span>Weekly</span>
              <% end %>

              <div class="pt-5 pb-1">
                <button class="sidebar-nav-item w-full" data-action="click->keyboard-shortcuts#showHelp">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" /></svg>
                  <span>Shortcuts</span>
                  <span class="ml-auto text-[10px] text-base-content/25 font-mono">?</span>
                </button>
              </div>
            </nav>

            <!-- Bottom user section -->
            <div class="px-3 py-3 border-t border-[#e8e5ec]">
              <div class="dropdown dropdown-top w-full">
                <div tabindex="0" role="button" class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg hover:bg-[#f0ecf5] cursor-pointer w-full transition-colors">
                  <div class="user-avatar user-avatar-sm">
                    <%= current_user.name.first(2).upcase %>
                  </div>
                  <span class="flex-1 min-w-0 text-[0.8125rem] font-medium truncate text-[#4a4a5a]"><%= current_user.name %></span>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#9090a0]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M10.343 3.94c.09-.542.56-.94 1.11-.94h1.093c.55 0 1.02.398 1.11.94l.149.894c.07.424.384.764.78.93.398.164.855.142 1.205-.108l.737-.527a1.125 1.125 0 011.45.12l.773.774c.39.389.44 1.002.12 1.45l-.527.737c-.25.35-.272.806-.107 1.204.165.397.505.71.93.78l.893.15c.543.09.94.56.94 1.109v1.094c0 .55-.397 1.02-.94 1.11l-.893.149c-.425.07-.765.383-.93.78-.165.398-.143.854.107 1.204l.527.738c.32.447.269 1.06-.12 1.45l-.774.773a1.125 1.125 0 01-1.449.12l-.738-.527c-.35-.25-.806-.272-1.204-.107-.397.165-.71.505-.78.929l-.15.894c-.09.542-.56.94-1.11.94h-1.094c-.55 0-1.019-.398-1.11-.94l-.148-.894c-.071-.424-.384-.764-.781-.93-.398-.164-.854-.142-1.204.108l-.738.527c-.447.32-1.06.269-1.45-.12l-.773-.774a1.125 1.125 0 01-.12-1.45l.527-.737c.25-.35.273-.806.108-1.204-.165-.397-.506-.71-.93-.78l-.894-.15c-.542-.09-.94-.56-.94-1.109v-1.094c0-.55.398-1.02.94-1.11l.894-.149c.424-.07.765-.383.93-.78.165-.398.143-.854-.108-1.204l-.526-.738a1.125 1.125 0 01.12-1.45l.773-.773a1.125 1.125 0 011.45-.12l.737.527c.35.25.807.272 1.204.107.397-.165.71-.505.78-.929l.15-.894z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
                </div>
                <ul tabindex="0" class="dropdown-content z-50 menu p-2 shadow-lg bg-base-100 text-base-content rounded-xl w-56 mb-2 border border-base-300/50">
                  <li><%= link_to "Profile", profile_path %></li>
                  <li><%= link_to "Workspace Settings", workspace_settings_path %></li>
                  <div class="divider my-1"></div>
                  <li class="menu-title text-xs">Switch Workspace</li>
                  <% current_user.workspaces.each do |ws| %>
                    <% unless ws == Current.workspace %>
                      <li><%= button_to ws.name, switch_workspace_path(ws), method: :post, class: "text-sm" %></li>
                    <% end %>
                  <% end %>
                  <li><%= link_to "New Workspace", new_workspace_path %></li>
                  <div class="divider my-1"></div>
                  <li><%= button_to "Sign Out", session_path, method: :delete %></li>
                </ul>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <%# Keyboard shortcuts help modal %>
      <dialog class="modal" data-keyboard-shortcuts-target="modal">
        <div class="modal-box rounded-2xl shadow-2xl">
          <h3 class="font-bold text-lg mb-4">Keyboard Shortcuts</h3>
          <div class="grid grid-cols-2 gap-y-3 gap-x-4 text-sm">
            <div><kbd class="kbd kbd-sm">s</kbd></div><div>Start/focus timer</div>
            <div><kbd class="kbd kbd-sm">n</kbd></div><div>New time entry</div>
            <div><kbd class="kbd kbd-sm">g</kbd> <kbd class="kbd kbd-sm">d</kbd></div><div>Go to Dashboard</div>
            <div><kbd class="kbd kbd-sm">g</kbd> <kbd class="kbd kbd-sm">t</kbd></div><div>Go to Time Entries</div>
            <div><kbd class="kbd kbd-sm">g</kbd> <kbd class="kbd kbd-sm">p</kbd></div><div>Go to Projects</div>
            <div><kbd class="kbd kbd-sm">g</kbd> <kbd class="kbd kbd-sm">r</kbd></div><div>Go to Reports</div>
            <div><kbd class="kbd kbd-sm">g</kbd> <kbd class="kbd kbd-sm">s</kbd></div><div>Go to Timesheet</div>
            <div><kbd class="kbd kbd-sm">g</kbd> <kbd class="kbd kbd-sm">c</kbd></div><div>Go to Clients</div>
            <div><kbd class="kbd kbd-sm">?</kbd></div><div>Show this help</div>
          </div>
          <div class="modal-action">
            <button class="btn btn-sm rounded-lg" data-action="click->keyboard-shortcuts#closeHelp">Close</button>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop">
          <button>close</button>
        </form>
      </dialog>
    <% else %>
      <%# Guest layout %>
      <div class="min-h-screen flex items-center justify-center bg-gradient-to-br from-base-200 via-base-100 to-base-200 relative overflow-hidden">
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
          <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-gradient-to-br from-violet-400/10 to-purple-500/5 blur-3xl"></div>
          <div class="absolute -bottom-24 -left-24 w-96 h-96 rounded-full bg-gradient-to-tr from-violet-600/10 to-purple-300/5 blur-3xl"></div>
        </div>

        <div class="w-full max-w-md relative z-10 px-4">
          <div class="text-center mb-8">
            <div class="flex items-center justify-center gap-2 mb-3">
              <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-violet-500 to-purple-700 flex items-center justify-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
            </div>
            <h1 class="text-3xl font-bold">Gold</h1>
            <p class="text-base-content/50 mt-1">Track time. Ship faster.</p>
          </div>

          <% if flash[:notice] %>
            <div class="alert alert-success mb-4 rounded-xl shadow-sm"><span><%= flash[:notice] %></span></div>
          <% end %>
          <% if flash[:alert] %>
            <div class="alert alert-error mb-4 rounded-xl shadow-sm"><span><%= flash[:alert] %></span></div>
          <% end %>

          <div class="card bg-base-100 shadow-xl border border-base-300/50 rounded-2xl">
            <div class="card-body p-8"><%= yield %></div>
          </div>

          <p class="text-center text-base-content/30 text-xs mt-8">Gold Time Tracking</p>
        </div>
      </div>
    <% end %>
  </body>
</html>
