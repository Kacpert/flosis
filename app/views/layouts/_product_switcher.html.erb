<%# Product switcher — Time & HR / Workshop. Shows a dropdown when the user can
    access more than one product; a static label otherwise. %>
<% products = current_user.accessible_products(current_workspace)
   labels = { time_hr: "Time & HR", workshop: "Workshop" } %>
<% if products.size > 1 %>
  <div class="relative px-1 pb-3 mb-1" style="border-bottom: 1px solid var(--color-outline-variant)">
    <button type="button"
            class="flex items-center gap-2.5 px-2.5 py-2 rounded-[var(--radius-md)] w-full transition-colors"
            style="background: var(--color-surface-container); color: var(--color-on-surface)"
            onclick="this.nextElementSibling.classList.toggle('hidden')">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" style="color: var(--color-primary)"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
      <span class="flex-1 min-w-0 text-[0.8125rem] font-semibold truncate text-left"><%= labels[current_product] %></span>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" /></svg>
    </button>
    <div class="hidden absolute top-full left-1 right-1 mt-1 m3-menu z-50">
      <% products.each do |p| %>
        <%= button_to switch_product_path, params: { product: p }, class: "m3-menu-item w-full #{'font-semibold' if p == current_product}" do %>
          <%= labels[p] %><% if p == current_product %> <span style="color: var(--color-primary)">●</span><% end %>
        <% end %>
      <% end %>
    </div>
  </div>
<% elsif products.any? %>
  <div class="px-3 pb-3 mb-1 flex items-center gap-2" style="border-bottom: 1px solid var(--color-outline-variant)">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" style="color: var(--color-primary)"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6z" /></svg>
    <span class="text-[0.8125rem] font-semibold" style="color: var(--color-on-surface)"><%= labels[products.first] %></span>
  </div>
<% end %>
