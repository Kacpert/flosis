<%= turbo_frame_tag "time_entry_#{entry.id}" do %>
  <% is_running = entry.stopped_at.nil? %>
  <div class="m3-entry-card group <%= 'running-entry-card' if is_running %>" data-controller="inline-edit<%= ' timer' if is_running %>" data-action="keydown->inline-edit#submitOnEscape" <%= "data-timer-started-at-value=#{entry.started_at.iso8601}" if is_running %>>
    <% if is_running %>
      <span class="flex h-5 w-5 items-center justify-center flex-shrink-0">
        <span class="inline-flex rounded-full h-2.5 w-2.5" style="background: var(--color-primary)"></span>
      </span>
    <% else %>
      <input type="checkbox" class="m3-checkbox-round" value="<%= entry.id %>"
             data-bulk-select-target="checkbox" data-action="change->bulk-select#toggle">
    <% end %>

    <%# Display mode %>
    <div class="flex items-center gap-3 flex-1 min-w-0" data-inline-edit-target="display">
      <span class="w-[3px] h-8 rounded-full flex-shrink-0" style="background-color: <%= entry.project&.color || '#CEC8BC' %>"></span>

      <div class="flex-1 min-w-0">
        <div class="m3-entry-title truncate"><%= linkify_jira_keys(entry.description.presence || "No description") %></div>
        <% if entry.project %>
          <div class="m3-entry-subtitle">
            <%= entry.project.name %><% if entry.task %> · <%= entry.task.name %><% end %>
          </div>
        <% end %>
      </div>

      <%# Tags %>
      <% unless is_running %>
        <div class="hidden sm:flex items-center gap-1.5 flex-shrink-0">
          <% entry.tags.first(2).each do |tag| %>
            <span class="m3-tag-chip" style="color: <%= tag.color %>; border-color: <%= tag.color %>30; background-color: <%= tag.color %>10">
              <%= tag.name %>
            </span>
          <% end %>
          <% if entry.tags.size > 2 %>
            <span class="text-[10px]" style="color: var(--color-outline)">+<%= entry.tags.size - 2 %></span>
          <% end %>
        </div>
      <% end %>

      <span class="m3-entry-time flex-shrink-0">
        <%= entry.started_at.strftime("%H:%M") %> – <%= is_running ? "now" : entry.stopped_at.strftime("%H:%M") %>
      </span>

      <% if is_running %>
        <span class="m3-entry-duration flex-shrink-0" data-timer-target="display">00:00:00</span>
        <%= button_to stop_timer_path, method: :patch, class: "flex-shrink-0 flex items-center justify-center w-8 h-8 rounded-full", style: "background: var(--color-error-container); color: var(--color-error);",
            data: { turbo_frame: "_top" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><rect x="7" y="7" width="10" height="10" rx="1.5"/></svg>
        <% end %>
      <% else %>
        <span class="m3-entry-duration flex-shrink-0"><%= entry.formatted_duration %></span>

        <%# Hover actions %>
        <div class="flex gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">
          <%= button_to start_timer_path(description: entry.description, project_id: entry.project_id, task_id: entry.task_id),
              method: :post, class: "m3-icon-btn m3-icon-btn-sm", title: "Continue",
              data: { turbo_frame: "_top" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          <% end %>
          <button type="button" class="m3-icon-btn m3-icon-btn-sm" data-action="click->inline-edit#edit" title="Edit">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
          </button>
          <%= button_to time_entry_path(entry), method: :delete, class: "m3-icon-btn m3-icon-btn-sm",
              style: "color: var(--color-error)",
              data: { turbo_confirm: "Delete this entry?" } do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Edit mode (inline) %>
    <% unless is_running %>
      <div class="<%= local_assigns[:editing] ? '' : 'hidden' %> flex-1" data-inline-edit-target="form">
        <%= form_with model: entry, url: time_entry_path(entry), method: :patch, class: "flex items-center gap-2 flex-wrap w-full", data: { action: "keydown->inline-edit#submitOnEnter" } do |f| %>
          <%= f.text_field :description, placeholder: "Description",
              class: "m3-input-compact flex-1 min-w-[120px]" %>
          <%= f.collection_select :project_id,
              available_projects, :id, :name,
              { include_blank: "No project" },
              class: "m3-input-compact",
              data: { controller: "task-loader", action: "change->task-loader#load" } %>
          <%= f.collection_select :task_id,
              (entry.project ? entry.project.tasks.active : []), :id, :name,
              { include_blank: "No task" },
              class: "m3-input-compact" %>
          <%= f.datetime_local_field :started_at, class: "m3-input-compact w-[165px]" %>
          <%= f.datetime_local_field :stopped_at, class: "m3-input-compact w-[165px]" %>
          <%= f.submit "Save", class: "m3-btn m3-btn-filled m3-btn-sm" %>
          <button type="button" class="m3-btn m3-btn-text m3-btn-sm" data-action="click->inline-edit#cancel">Cancel</button>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
