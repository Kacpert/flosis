<%= turbo_frame_tag "time_entry_#{entry.id}" do %>
  <div class="entry-row group" data-controller="inline-edit" data-action="keydown->inline-edit#submitOnEscape">
    <input type="checkbox" class="entry-checkbox" value="<%= entry.id %>"
           data-bulk-select-target="checkbox" data-action="change->bulk-select#toggle">

    <%# Display mode %>
    <div class="flex items-center gap-3 flex-1 min-w-0" data-inline-edit-target="display">
      <span class="w-[3px] h-10 rounded-full flex-shrink-0" style="background-color: <%= entry.project&.color || '#CBD5E1' %>"></span>

      <div class="flex-1 min-w-0">
        <div class="text-[0.9375rem] font-medium text-[#2d2b3a] truncate"><%= entry.description.presence || "No description" %></div>
        <% if entry.project %>
          <div class="entry-project-text">
            <%= entry.project.name %><% if entry.task %> · <%= entry.task.name %><% end %>
          </div>
        <% end %>
      </div>

      <%# Tags %>
      <div class="hidden sm:flex items-center gap-1.5 flex-shrink-0">
        <% entry.tags.first(2).each do |tag| %>
          <span class="tag-pill" style="color: <%= tag.color %>; border-color: <%= tag.color %>30; background-color: <%= tag.color %>10">
            <%= tag.name %>
          </span>
        <% end %>
        <% if entry.tags.size > 2 %>
          <span class="text-[10px] text-[#b0adb8]">+<%= entry.tags.size - 2 %></span>
        <% end %>
      </div>

      <span class="entry-time-range flex-shrink-0">
        <%= entry.started_at.strftime("%H:%M") %> – <%= entry.stopped_at.strftime("%H:%M") %>
      </span>

      <span class="entry-duration flex-shrink-0"><%= entry.formatted_duration %></span>

      <%# Hover actions %>
      <div class="flex gap-0.5 opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">
        <%= button_to start_timer_path(description: entry.description, project_id: entry.project_id, task_id: entry.task_id),
            method: :post, class: "btn btn-ghost btn-xs btn-circle", title: "Continue" do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <% end %>
        <button type="button" class="btn btn-ghost btn-xs btn-circle" data-action="click->inline-edit#edit" title="Edit">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
        </button>
        <%= button_to time_entry_path(entry), method: :delete, class: "btn btn-ghost btn-xs btn-circle text-error/60 hover:text-error",
            data: { turbo_confirm: "Delete this entry?" } do %>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
        <% end %>
      </div>
    </div>

    <%# Edit mode (inline) %>
    <div class="<%= local_assigns[:editing] ? '' : 'hidden' %> flex-1" data-inline-edit-target="form">
      <%= form_with model: entry, url: time_entry_path(entry), method: :patch, class: "flex items-center gap-2 flex-wrap w-full", data: { action: "keydown->inline-edit#submitOnEnter" } do |f| %>
        <%= f.text_field :description, placeholder: "Description",
            class: "input input-sm input-bordered flex-1 min-w-[120px] rounded-lg" %>
        <%= f.collection_select :project_id,
            (Current.workspace&.projects&.active&.order(:name) || []), :id, :name,
            { include_blank: "No project" },
            class: "select select-sm select-bordered rounded-lg",
            data: { controller: "task-loader", action: "change->task-loader#load" } %>
        <%= f.collection_select :task_id,
            (entry.project ? entry.project.tasks.active : []), :id, :name,
            { include_blank: "No task" },
            class: "select select-sm select-bordered rounded-lg" %>
        <%= f.datetime_local_field :started_at, class: "input input-sm input-bordered w-[165px] rounded-lg" %>
        <%= f.datetime_local_field :stopped_at, class: "input input-sm input-bordered w-[165px] rounded-lg" %>
        <label class="flex items-center gap-1">
          <%= f.check_box :billable, class: "checkbox checkbox-sm checkbox-primary" %>
          <span class="text-xs">$</span>
        </label>
        <%= f.submit "Save", class: "btn btn-primary btn-xs rounded-lg" %>
        <button type="button" class="btn btn-ghost btn-xs" data-action="click->inline-edit#cancel">Cancel</button>
      <% end %>
    </div>
  </div>
<% end %>
