<div class="max-w-md mx-auto">
  <div class="card bg-base-100 shadow-xl">
    <div class="card-body">
      <h2 class="card-title">Create Workspace</h2>

      <%= form_with model: @workspace, url: workspaces_path, class: "space-y-4" do |f| %>
        <% if @workspace.errors.any? %>
          <div class="alert alert-error">
            <ul>
              <% @workspace.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="form-control">
          <label class="label"><span class="label-text">Workspace Name</span></label>
          <%= f.text_field :name, required: true, autofocus: true,
              class: "input input-bordered w-full" %>
        </div>

        <div class="form-control mt-6">
          <%= f.submit "Create Workspace", class: "btn btn-primary w-full" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
