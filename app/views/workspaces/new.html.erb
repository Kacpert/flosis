<div class="max-w-md mx-auto">
  <div class="m3-card-elevated p-6">
    <h2 class="text-xl font-bold mb-4" style="color: var(--color-on-surface)">Create Workspace</h2>

    <%= form_with model: @workspace, url: workspaces_path, class: "space-y-4" do |f| %>
      <% if @workspace.errors.any? %>
        <div class="m3-alert m3-alert-error">
          <ul>
            <% @workspace.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="space-y-1">
        <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Workspace Name</label>
        <%= f.text_field :name, required: true, autofocus: true,
            class: "m3-text-field w-full" %>
      </div>

      <div class="mt-6">
        <%= f.submit "Create Workspace", class: "m3-btn m3-btn-filled w-full" %>
      </div>
    <% end %>
  </div>
</div>
