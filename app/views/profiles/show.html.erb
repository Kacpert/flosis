<div class="max-w-2xl mx-auto space-y-6">
  <h1 class="text-2xl font-bold">Profile Settings</h1>

  <%= form_with model: current_user, url: profile_path, method: :patch, class: "space-y-6" do |f| %>
    <% if current_user.errors.any? %>
      <div class="alert alert-error">
        <ul><% current_user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>

    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title text-lg">Personal Information</h2>

        <div class="form-control">
          <label class="label"><span class="label-text">Name</span></label>
          <%= f.text_field :name, class: "input input-bordered w-full", required: true %>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">Email</span></label>
          <%= f.email_field :email_address, class: "input input-bordered w-full", required: true %>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">Timezone</span></label>
          <%= f.select :timezone,
              ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] },
              { include_blank: "Select timezone" },
              class: "select select-bordered w-full" %>
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">Default Hourly Rate ($)</span></label>
          <input type="number" name="user[default_hourly_rate_dollars]" step="0.01" min="0"
                 value="<%= current_user.default_hourly_rate_cents ? (current_user.default_hourly_rate_cents / 100.0) : '' %>"
                 class="input input-bordered w-full"
                 placeholder="Your default hourly rate">
        </div>
      </div>
    </div>

    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title text-lg">Change Password</h2>
        <p class="text-sm text-base-content/60">Leave blank to keep current password.</p>

        <div class="form-control">
          <label class="label"><span class="label-text">Current Password</span></label>
          <input type="password" name="user[current_password]" class="input input-bordered w-full" autocomplete="current-password">
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">New Password</span></label>
          <input type="password" name="user[password]" class="input input-bordered w-full" autocomplete="new-password">
        </div>

        <div class="form-control">
          <label class="label"><span class="label-text">Confirm New Password</span></label>
          <input type="password" name="user[password_confirmation]" class="input input-bordered w-full" autocomplete="new-password">
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Save Changes", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
