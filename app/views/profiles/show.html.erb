<div class="max-w-2xl mx-auto space-y-6">
  <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)">Profile Settings</h1>

  <%= form_with model: current_user, url: profile_path, method: :patch, class: "space-y-6" do |f| %>
    <% if current_user.errors.any? %>
      <div class="m3-alert m3-alert-error">
        <ul><% current_user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>

    <div class="m3-card-elevated p-6">
      <h2 class="text-lg font-semibold mb-4" style="color: var(--color-on-surface)">Personal Information</h2>

      <div class="space-y-4">
        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Name</label>
          <%= f.text_field :name, class: "m3-text-field w-full", required: true %>
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Email</label>
          <%= f.email_field :email_address, class: "m3-text-field w-full", required: true %>
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Timezone</label>
          <%= f.select :timezone,
              ActiveSupport::TimeZone.all.map { |tz| [tz.to_s, tz.name] },
              { include_blank: "Select timezone" },
              class: "m3-text-field w-full" %>
        </div>

      </div>
    </div>

    <div class="m3-card-elevated p-6">
      <h2 class="text-lg font-semibold mb-1" style="color: var(--color-on-surface)">Change Password</h2>
      <p class="text-sm mb-4" style="color: var(--color-on-surface-variant)">Leave blank to keep current password.</p>

      <div class="space-y-4">
        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Current Password</label>
          <input type="password" name="user[current_password]" class="m3-text-field w-full" autocomplete="current-password">
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">New Password</label>
          <input type="password" name="user[password]" class="m3-text-field w-full" autocomplete="new-password">
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Confirm New Password</label>
          <input type="password" name="user[password_confirmation]" class="m3-text-field w-full" autocomplete="new-password">
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Save Changes", class: "m3-btn m3-btn-filled" %>
    </div>
  <% end %>
</div>
