<%# AI costs (SCRUM-70): whether this person sees what Claude costs on the thing
    itself. It saves the moment it is flipped — what the product shows you is
    yours, not something to Save. While the organization hides costs for
    everyone (Configuration › AI) the switch is off and unusable. Ported from
    the accepted designs' ai-costs-card, in this page's m3 markup. %>
<% allowed = current_workspace&.ai_costs_enabled? != false %>
<% wallet = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-none" aria-hidden="true"><path d="M3 7h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 7V6a2 2 0 0 1 2-2h11"/></svg>'.html_safe %>
<div class="m3-card-elevated p-6" data-ai-costs-card>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-60 flex-1">
      <h2 class="text-lg font-semibold mb-1" style="color: var(--color-on-surface)">AI costs</h2>
      <p class="text-sm" style="color: var(--color-on-surface-variant)">
        Show what Claude costs on the thing itself: a task conversation, a PR review, an AI estimate, a design
        thread, a design import and a bug analysis &mdash; and each area&rsquo;s month in its own tab.
      </p>
    </div>

    <%= form_with model: current_user, url: profile_path, method: :patch, data: { controller: "auto-save" },
          class: "flex flex-col items-end gap-1.5" do |f| %>
      <%= f.hidden_field :show_ai_costs, value: "0", id: nil %>
      <%= f.check_box :show_ai_costs, { checked: allowed && current_user.show_ai_costs?, disabled: !allowed,
            class: "m3-switch", role: "switch", data: { action: "change->auto-save#save" },
            aria: { label: allowed ? "Show AI costs on my screens" : "Show AI costs on my screens — off for the whole organization" } },
            "1", nil %>
      <% unless allowed %>
        <span class="text-[11px] font-bold tracking-wide" style="color: var(--color-on-surface-variant)">UNAVAILABLE</span>
      <% end %>
    <% end %>
  </div>

  <% if allowed %>
    <div class="mt-4 flex flex-col gap-1.5 rounded-lg border px-3 py-2.5 text-xs"
         style="border-color: var(--color-outline-variant); color: var(--color-on-surface-variant)">
      <span class="inline-flex items-center gap-1.5"><%= wallet %><b style="color: var(--color-on-surface)">$0.68</b> &mdash; the total so far, all of it spent this month.</span>
      <span class="inline-flex items-center gap-1.5"><%= wallet %><b style="color: var(--color-on-surface)">$1.86 ($0.94 this month)</b> &mdash; older than this month, so the month is named.</span>
      <span class="inline-flex items-center gap-1.5"><%= wallet %><b style="color: var(--color-on-surface)">$0.74 (none this month)</b> &mdash; nothing has been spent on it since the month turned.</span>
    </div>
    <p class="mt-3 border-t pt-3 text-xs" style="border-color: var(--color-outline-variant); color: var(--color-on-surface-variant)">
      <b style="color: var(--color-on-surface)"><%= current_workspace&.name %> shows AI costs.</b>
      An organization administrator can turn them off for everyone in Configuration &rsaquo; AI; this setting only
      works while that one is on.<% if workspace_admin? %> What the organization spends in total is on Consumption.<% end %>
    </p>
  <% else %>
    <div class="mt-4 rounded-lg px-3 py-2.5 text-sm" style="background: var(--color-warning-container, #fff4e5); color: var(--color-on-surface)">
      <b>Costs are off for the whole organization.</b>
      <%= current_workspace&.name %> has turned cost display off in Configuration &rsaquo; AI, so nobody sees a price
      or a token figure anywhere in the product &mdash; whatever each person has chosen here.
    </div>
    <% if workspace_admin? %>
      <p class="mt-3 border-t pt-3 text-xs" style="border-color: var(--color-outline-variant); color: var(--color-on-surface-variant)">
        You are an organization administrator, so you can turn it back on in Configuration &rsaquo; AI. The
        organization&rsquo;s own total is on Consumption, which this switch never hides.
      </p>
    <% end %>
  <% end %>
</div>
