<h2 class="text-xl font-bold text-center tracking-tight">Welcome back</h2>
<p class="text-center text-base-content/45 text-sm mb-6">Sign in to continue tracking</p>

<%= form_with url: session_path, class: "space-y-4" do |f| %>
  <div class="form-control">
    <label class="label"><span class="label-text text-sm font-medium">Email</span></label>
    <%= f.email_field :email_address, class: "input input-bordered w-full rounded-lg focus:input-primary", required: true, autofocus: true, autocomplete: "email", placeholder: "you@company.com" %>
  </div>
  <div class="form-control">
    <div class="flex items-center justify-between">
      <label class="label"><span class="label-text text-sm font-medium">Password</span></label>
      <%= link_to "Forgot?", new_password_path, class: "text-xs text-primary hover:underline" %>
    </div>
    <%= f.password_field :password, class: "input input-bordered w-full rounded-lg focus:input-primary", required: true, autocomplete: "current-password", placeholder: "••••••••" %>
  </div>
  <%= f.submit "Sign In", class: "btn btn-primary w-full rounded-lg" %>
<% end %>

<div class="divider text-xs text-base-content/25 my-5">OR</div>
<p class="text-center text-sm text-base-content/50">
  Don't have an account? <%= link_to "Create one", new_registration_path, class: "text-primary font-medium hover:underline" %>
</p>
