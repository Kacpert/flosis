<div class="card bg-base-100 shadow-xl">
  <div class="card-body">
    <h2 class="card-title justify-center">Sign In</h2>

    <%= form_with url: session_path, class: "space-y-4" do |f| %>
      <div class="form-control">
        <label class="label"><span class="label-text">Email</span></label>
        <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
            class: "input input-bordered w-full", placeholder: "you@example.com" %>
      </div>

      <div class="form-control">
        <label class="label"><span class="label-text">Password</span></label>
        <%= f.password_field :password, required: true, autocomplete: "current-password",
            class: "input input-bordered w-full" %>
      </div>

      <div class="form-control mt-6">
        <%= f.submit "Sign In", class: "btn btn-primary w-full" %>
      </div>
    <% end %>

    <div class="divider">OR</div>

    <p class="text-center text-sm">
      Don't have an account?
      <%= link_to "Sign up", new_registration_path, class: "link link-primary" %>
    </p>
  </div>
</div>
