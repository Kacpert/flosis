<%= form_with model: client, url: url, class: "space-y-4" do |f| %>
  <% if client.errors.any? %>
    <div class="alert alert-error">
      <ul><% client.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-control">
    <label class="label"><span class="label-text">Name</span></label>
    <%= f.text_field :name, class: "input input-bordered w-full", required: true %>
  </div>

  <div class="form-control">
    <label class="label"><span class="label-text">Notes</span></label>
    <%= f.text_area :notes, class: "textarea textarea-bordered w-full", rows: 3 %>
  </div>

  <div class="form-control">
    <label class="label cursor-pointer justify-start gap-3">
      <%= f.check_box :archived, class: "checkbox" %>
      <span class="label-text">Archived</span>
    </label>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", clients_path, class: "btn btn-ghost" %>
  </div>
<% end %>
