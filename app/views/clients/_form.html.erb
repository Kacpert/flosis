<%= form_with model: client, url: url, class: "space-y-4" do |f| %>
  <% if client.errors.any? %>
    <div class="m3-alert m3-alert-error">
      <ul><% client.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Name</label>
    <%= f.text_field :name, class: "m3-text-field w-full", required: true %>
  </div>

  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Notes</label>
    <%= f.text_area :notes, class: "m3-text-field w-full", rows: 3 %>
  </div>

  <label class="flex items-center gap-3 cursor-pointer">
    <%= f.check_box :archived, class: "m3-checkbox" %>
    <span class="text-sm font-medium" style="color: var(--color-on-surface)">Archived</span>
  </label>

  <div class="flex gap-2">
    <%= f.submit class: "m3-btn m3-btn-filled" %>
    <%= link_to "Cancel", clients_path, class: "m3-btn m3-btn-text" %>
  </div>
<% end %>
