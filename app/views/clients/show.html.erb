<div class="space-y-4">
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)"><%= @client.name %></h1>
      <% if @client.notes.present? %>
        <p class="mt-1" style="color: var(--color-on-surface-variant)"><%= @client.notes %></p>
      <% end %>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_client_path(@client), class: "m3-btn m3-btn-text" %>
      <%= link_to "Back", clients_path, class: "m3-btn m3-btn-text" %>
    </div>
  </div>

  <div class="m3-card-elevated p-6">
    <h2 class="text-lg font-semibold mb-3" style="color: var(--color-on-surface)">Projects</h2>
    <% if @projects.any? %>
      <div class="space-y-2">
        <% @projects.each do |project| %>
          <div class="flex items-center justify-between p-2 rounded-[var(--radius-sm)]" onmouseover="this.style.background='var(--color-surface-container)'" onmouseout="this.style.background='transparent'">
            <span class="flex items-center gap-2">
              <%= project_color_dot(project.color) %>
              <%= link_to project.name, project_path(project), class: "font-medium", style: "color: var(--color-on-surface); text-decoration: none;" %>
            </span>
            <span class="text-xs font-medium px-2 py-0.5 rounded-full" style="color: var(--color-outline); background: var(--color-surface-container)"><%= project.tasks.size %> tasks</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm" style="color: var(--color-on-surface-variant)">No projects for this client.</p>
    <% end %>
  </div>
</div>
