<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Clients</h1>
    <%= link_to "New Client", new_client_path, class: "btn btn-primary btn-sm" %>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body p-0">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Projects</th>
            <th>Notes</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @clients.each do |client| %>
            <tr class="hover">
              <td class="font-medium"><%= link_to client.name, client_path(client), class: "link" %></td>
              <td><span class="badge badge-ghost"><%= client.projects.size %></span></td>
              <td class="text-sm text-base-content/60"><%= client.notes.to_s.truncate(50) %></td>
              <td class="text-right">
                <%= link_to "Edit", edit_client_path(client), class: "btn btn-ghost btn-xs" %>
                <%= button_to "Delete", client_path(client), method: :delete,
                    class: "btn btn-ghost btn-xs text-error",
                    data: { turbo_confirm: "Delete #{client.name}?" } %>
              </td>
            </tr>
          <% end %>
          <% if @clients.empty? %>
            <tr><td colspan="4" class="text-center py-8 text-base-content/50">No clients yet. Create your first client!</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
