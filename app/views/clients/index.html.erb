<div class="space-y-5">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold tracking-tight">Clients</h1>
    <%= link_to "New Client", new_client_path, class: "btn btn-primary btn-sm" %>
  </div>

  <div class="refined-table">
    <table class="table">
      <thead>
        <tr>
          <th>Name</th>
          <th>Projects</th>
          <th>Notes</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @clients.each do |client| %>
          <tr class="hover">
            <td class="font-medium"><%= link_to client.name, client_path(client), class: "hover:text-primary transition-colors" %></td>
            <td><span class="text-xs font-medium text-base-content/50 bg-base-200/80 px-2 py-0.5 rounded-full"><%= client.projects.size %></span></td>
            <td class="text-sm text-base-content/50"><%= client.notes.to_s.truncate(50) %></td>
            <td class="text-right">
              <div class="flex justify-end gap-1">
                <%= link_to "Edit", edit_client_path(client), class: "btn btn-ghost btn-xs text-base-content/50" %>
                <%= button_to "Delete", client_path(client), method: :delete,
                    class: "btn btn-ghost btn-xs text-error/60 hover:text-error",
                    data: { turbo_confirm: "Delete #{client.name}?" } %>
              </div>
            </td>
          </tr>
        <% end %>
        <% if @clients.empty? %>
          <tr>
            <td colspan="4">
              <div class="empty-state">
                <div class="empty-state-icon">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                </div>
                <p class="empty-state-title">No clients yet</p>
                <p class="empty-state-desc">Create your first client to organize projects</p>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
