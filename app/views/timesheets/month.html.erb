<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)">Timesheet</h1>
    <div class="inline-flex rounded-full p-0.5" style="background: var(--color-surface-variant)">
      <%= link_to timesheet_path(week_of: @month_start.beginning_of_week(:monday)), class: "px-4 py-1.5 rounded-full text-sm font-medium transition-colors", style: "color: var(--color-on-surface-variant)" do %>
        Week
      <% end %>
      <%= link_to month_timesheet_path(month: @month_date.strftime("%Y-%m")), class: "px-4 py-1.5 rounded-full text-sm font-medium transition-colors", style: "background: var(--color-primary-container); color: var(--color-on-primary-container)" do %>
        Month
      <% end %>
    </div>
  </div>

  <!-- Month navigation -->
  <div class="flex items-center justify-between">
    <%= link_to month_timesheet_path(month: (@month_date - 1.month).strftime("%Y-%m")), class: "m3-btn m3-btn-text m3-btn-sm" do %>
      &larr; Previous
    <% end %>
    <span class="font-medium" style="color: var(--color-on-surface)">
      <%= @month_date.strftime("%B %Y") %>
    </span>
    <% if @month_date < Date.current.beginning_of_month %>
      <%= link_to month_timesheet_path(month: (@month_date + 1.month).strftime("%Y-%m")), class: "m3-btn m3-btn-text m3-btn-sm" do %>
        Next &rarr;
      <% end %>
    <% else %>
      <span class="m3-btn m3-btn-text m3-btn-sm invisible">Next &rarr;</span>
    <% end %>
  </div>

  <div class="m3-card-outlined overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr>
          <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |day_name| %>
            <th class="py-3 px-2 text-center text-sm font-medium" style="color: var(--color-on-surface-variant); width: 12.5%"><%= day_name %></th>
          <% end %>
          <th class="py-3 px-2 text-center text-sm font-medium" style="color: var(--color-on-surface-variant); width: 12.5%">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @weeks.each do |week_start| %>
          <% week_total_seconds = 0 %>
          <% week_has_month_days = (0..6).any? { |i| (week_start + i.days).month == @month_date.month } %>
          <% next unless week_has_month_days %>
          <tr class="group cursor-pointer border-t transition-colors"
              style="border-color: var(--color-outline-variant)"
              onclick="window.location='<%= timesheet_path(week_of: week_start) %>'">
            <% (0..6).each do |i| %>
              <% day = week_start + i.days %>
              <% in_month = day.month == @month_date.month && day.year == @month_date.year %>
              <% is_today = day == Date.current %>
              <% seconds = in_month ? @day_totals[day] : 0 %>
              <% week_total_seconds += seconds %>
              <td class="py-3 px-2 text-center align-top group-hover:!bg-[rgba(74,103,65,0.08)] transition-colors"
                  style="<%= is_today ? 'background: rgba(74, 103, 65, 0.12)' : '' %>">
                <% if in_month %>
                  <div class="text-xs font-medium mb-1 <%= is_today ? 'inline-flex items-center justify-center w-6 h-6 rounded-full' : '' %>"
                       style="color: var(--color-on-surface); <%= is_today ? 'background: var(--color-primary); color: var(--color-on-primary)' : '' %>">
                    <%= day.day %>
                  </div>
                  <% if seconds > 0 %>
                    <div class="text-sm font-mono font-medium" style="color: var(--color-primary)">
                      <%= format("%d:%02d", seconds / 3600, (seconds % 3600) / 60) %>
                    </div>
                  <% end %>
                <% end %>
              </td>
            <% end %>
            <td class="py-3 px-2 text-center align-middle font-mono font-bold text-sm group-hover:!bg-[rgba(74,103,65,0.08)] transition-colors" style="color: var(--color-on-surface)">
              <%= week_total_seconds > 0 ? format("%d:%02d", week_total_seconds / 3600, (week_total_seconds % 3600) / 60) : "" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="border-t" style="border-color: var(--color-outline-variant)">
          <td colspan="7" class="py-3 px-2 text-right font-bold text-sm" style="color: var(--color-on-surface)">Month Total</td>
          <td class="py-3 px-2 text-center font-mono font-bold text-sm" style="color: var(--color-on-surface)">
            <%= @grand_total > 0 ? format("%d:%02d", @grand_total / 3600, (@grand_total % 3600) / 60) : "0:00" %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <% if @entries.empty? %>
    <div class="text-center py-8" style="color: var(--color-on-surface-variant)">
      <p>No time entries for this month.</p>
    </div>
  <% end %>
</div>
