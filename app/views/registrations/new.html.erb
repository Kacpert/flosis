<h2 class="text-xl font-bold text-center tracking-tight" style="color: var(--color-on-surface)">Create your account</h2>
<p class="text-center text-sm mb-6" style="color: var(--color-on-surface-variant)">Start tracking time in seconds</p>

<%= form_with model: @user, url: registration_path, class: "space-y-4" do |f| %>
  <% if @user.errors.any? %>
    <div class="m3-alert m3-alert-error">
      <ul class="text-sm">
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Name</label>
    <%= f.text_field :name, class: "m3-text-field w-full", required: true, autofocus: true, placeholder: "Your name" %>
  </div>
  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Email</label>
    <%= f.email_field :email_address, class: "m3-text-field w-full", required: true, autocomplete: "email", placeholder: "you@company.com" %>
  </div>
  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Password</label>
    <%= f.password_field :password, class: "m3-text-field w-full", required: true, autocomplete: "new-password", placeholder: "Min. 8 characters" %>
  </div>
  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Confirm Password</label>
    <%= f.password_field :password_confirmation, class: "m3-text-field w-full", required: true, autocomplete: "new-password" %>
  </div>
  <%= f.submit "Get Started", class: "m3-btn m3-btn-filled w-full" %>
<% end %>

<p class="text-center text-sm mt-5" style="color: var(--color-on-surface-variant)">
  Already have an account? <%= link_to "Sign in", new_session_path, style: "color: var(--color-primary); font-weight: 500; text-decoration: none;", onmouseover: "this.style.textDecoration='underline'", onmouseout: "this.style.textDecoration='none'" %>
</p>
