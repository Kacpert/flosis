<% content_for :title, "Plans · Flosis admin" %>
<%# Plans (SCRUM-70, flosis-admin/plans.html), in dollars. %>
<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="clar-h1">Plans</h1>
    <p class="clar-text-muted text-[13px] mt-1">A plan is a monthly price, a margin and the models it includes. Its price is the organization&rsquo;s monthly limit.</p>
  </div>
  <%= link_to "New plan", new_hidmin_plan_path, class: "clar-btn clar-btn-primary no-underline" %>
</div>

<div class="clar-card overflow-hidden">
  <div class="clar-table-head">
    <span class="flex-1">PLAN</span>
    <span class="w-32 text-right">MONTHLY PRICE</span>
    <span class="w-20 text-right">MARGIN</span>
    <span class="w-56 pl-6">MODELS</span>
    <span class="w-64 pl-6">ORGANIZATIONS</span>
  </div>
  <div class="divide-y divide-[color:var(--border)]">
    <% @plans.each do |plan| %>
      <% orgs = plan.workspaces.sort_by(&:name) %>
      <%= link_to edit_hidmin_plan_path(plan), class: "flex items-start px-5 py-3.5 no-underline text-[13px] clar-row-hover", data: { plan_row: plan.id } do %>
        <span class="flex-1 min-w-0 font-semibold text-[13.5px] clar-text-text"><%= plan.name %></span>
        <span class="w-32 text-right font-semibold clar-text-text"><%= AiCostFormatter.money(plan.monthly_price_usd) %></span>
        <span class="w-20 text-right clar-text-muted"><%= number_to_percentage(plan.margin_percent, precision: 2, strip_insignificant_zeros: true) %></span>
        <span class="w-56 pl-6 flex flex-col gap-0.5 clar-text-muted">
          <% plan.ai_models.sort_by(&:model_id).each do |model| %><span><%= model.name %></span><% end %>
          <% if plan.ai_models.empty? %><span class="clar-text-faint">&mdash;</span><% end %>
        </span>
        <span class="w-64 pl-6 clar-text-muted">
          <% if orgs.any? %><%= orgs.first.name %><%= " · +#{orgs.size - 1}" if orgs.size > 1 %><% else %><span class="clar-text-faint">None yet</span><% end %>
        </span>
      <% end %>
    <% end %>
    <% if @plans.empty? %>
      <div class="p-8 text-center clar-text-muted text-[13.5px]">No plans yet.</div>
    <% end %>
  </div>
</div>

<div class="mt-4.5 grid grid-cols-1 gap-4.5 md:grid-cols-2">
  <div class="clar-card p-4.5">
    <div class="font-bold text-[14px] clar-text-text mb-1">How a plan is charged</div>
    <p class="text-[12.5px] leading-[1.5] clar-text-muted m-0">
      A run&rsquo;s cost is what Anthropic reported for it. The organization is charged price: that cost plus the plan&rsquo;s
      margin &mdash; $10.00 at 30% is $13.00. The plan&rsquo;s monthly price is the limit the organization is measured against,
      and going over it blocks nothing.
    </p>
  </div>
  <div class="clar-card p-4.5">
    <div class="font-bold text-[14px] clar-text-text mb-1">Changing a margin</div>
    <p class="text-[12.5px] leading-[1.5] clar-text-muted m-0">
      Every run keeps the margin of the day it ran, so a new margin only touches runs from here on &mdash; a month already
      closed never moves. Model prices are read daily: <%= link_to "Models & prices", hidmin_ai_models_path, class: "font-semibold clar-text-primary no-underline" %>.
    </p>
  </div>
</div>
