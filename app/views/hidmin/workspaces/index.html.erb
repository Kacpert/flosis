<% content_for :title, "Organizations · Flosis admin" %>
<%# Organizations (SCRUM-70, flosis-admin/organizations.html), in dollars:
    this month's cost (Flosis only), price, margin and limit per organization.
    Each name opens the organization: its billing, people and settings. %>
<% month = Date.current %>
<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="clar-h1">Organizations</h1>
    <p class="clar-text-muted text-[13px] mt-1">
      <%= month.strftime("%B %Y") %>. <b class="clar-text-text">Cost</b> is what Anthropic reported and is only ever seen here;
      <b class="clar-text-text">price</b> is cost plus the plan&rsquo;s margin, and is what the organization sees and is measured against.
    </p>
  </div>
  <%= link_to "New organization", new_hidmin_workspace_path, class: "clar-btn clar-btn-primary no-underline flex-none" %>
</div>

<div class="clar-card overflow-x-auto">
  <div class="min-w-[1000px]">
    <div class="clar-table-head">
      <span class="flex-1">ORGANIZATION</span>
      <span class="w-56">PLAN</span>
      <span class="w-16 text-right">MARGIN</span>
      <span class="w-24 text-right">COST</span>
      <span class="w-24 text-right">PRICE</span>
      <span class="w-40 text-right">AGAINST LIMIT</span>
      <span class="w-24 text-right">RUNS</span>
    </div>
    <div class="divide-y divide-[color:var(--border)]">
      <% @workspaces.each do |workspace| %>
        <% figures = @billing[workspace.id] || AiBilling::Organization.new(cost: 0, price: 0, runs: 0, unknown: 0) %>
        <% plan = workspace.ai_plan %>
        <% percent = consumption_percent(figures.price, plan&.monthly_price_usd) %>
        <% over = plan && figures.price > plan.monthly_price_usd %>
        <% projects = @project_counts.fetch(workspace.id, 0) %>
        <% own = @own_key_counts.fetch(workspace.id, 0) %>
        <div class="flex items-center px-5 py-3 text-[13px] <%= 'bg-[color:var(--warn-soft)]' unless plan %>" data-organization-row="<%= workspace.id %>">
          <span class="flex-1 min-w-0">
            <%= link_to workspace.name, hidmin_workspace_path(workspace), class: "font-semibold text-[13.5px] clar-text-primary no-underline" %>
            <span class="block text-[11.5px] clar-text-faint"><%= pluralize(projects, "project") %><%= " · #{own} on its own key" if own.positive? %></span>
          </span>
          <span class="w-56">
            <% if plan %>
              <span class="clar-text-text"><%= plan.name %> &middot; <%= AiCostFormatter.money(plan.monthly_price_usd) %></span>
            <% else %>
              <%= form_with url: assign_plan_hidmin_workspace_path(workspace), method: :patch, class: "flex items-center gap-2" do %>
                <%= select_tag :ai_plan_id, options_from_collection_for_select(@plans, :id, :name), prompt: "No plan",
                      class: "clar-input !w-32 !py-1 !text-[12.5px]", required: true, aria: { label: "Plan for #{workspace.name}" } %>
                <%= submit_tag "Assign", class: "clar-btn clar-btn-primary !py-1 !px-2.5 !text-[12px]" %>
              <% end %>
            <% end %>
          </span>
          <span class="w-16 text-right clar-text-muted"><%= number_to_percentage(plan&.margin_percent || AiRun.default_margin_percent, precision: 2, strip_insignificant_zeros: true) %></span>
          <span class="w-24 text-right clar-mono text-[12px] clar-text-muted"><%= AiCostFormatter.money(figures.cost) %></span>
          <span class="w-24 text-right font-bold clar-text-text"><%= AiCostFormatter.money(figures.price) %></span>
          <span class="w-40 pl-4 text-right">
            <% if percent %>
              <span class="block text-[11.5px] <%= over ? 'font-semibold clar-text-warn' : 'clar-text-muted' %>"><%= over ? "over by #{AiCostFormatter.money(figures.price - plan.monthly_price_usd)}" : "#{percent}% of the limit" %></span>
              <span class="mt-1 block h-1.5 w-full overflow-hidden rounded-full bg-[var(--surface-2)]">
                <span class="block h-full rounded-full <%= over ? 'bg-[var(--warn)]' : 'bg-[var(--primary)]' %>" style="width: <%= [ percent, 100 ].min %>%;"></span>
              </span>
            <% else %>
              <span class="text-[11.5px] font-semibold clar-text-warn">no plan &middot; no limit</span>
            <% end %>
          </span>
          <span class="w-24 text-right">
            <span class="block clar-text-muted"><%= number_with_delimiter(figures.runs) %></span>
            <% if figures.unknown.positive? %><span class="clar-badge clar-badge-warn !py-[1px] !px-1.5 !text-[10px]"><%= figures.unknown %> UNKNOWN</span><% end %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% unknown = @billing.values.sum(&:unknown) %>
<div class="mt-4.5 grid grid-cols-1 gap-4.5 md:grid-cols-3">
  <div class="clar-card p-4.5">
    <div class="font-bold text-[14px] clar-text-text mb-1">Unknown costs</div>
    <p class="m-0 text-[12.5px] leading-[1.5] clar-text-muted">
      <% if unknown.positive? %>
        <b class="clar-text-text"><%= pluralize(unknown, "run") %></b> came back with no cost and nobody has looked at them yet.
        Their tokens are recorded, their price reads unknown to the organization, and none of them is counted as $0.
      <% else %>
        Every run has a reported cost, or has been looked at.
      <% end %>
    </p>
  </div>
  <div class="clar-card p-4.5">
    <div class="font-bold text-[14px] clar-text-text mb-1">Own-key projects</div>
    <p class="m-0 text-[12.5px] leading-[1.5] clar-text-muted">
      <%= pluralize(@own_key_counts.values.sum, "project") %> carry their own Anthropic key. Their Designs runs are billed to them:
      Flosis records and shows that usage, charges nothing for it, and leaves it out of every limit.
    </p>
  </div>
  <div class="clar-card p-4.5">
    <div class="font-bold text-[14px] clar-text-text mb-1">Over the limit</div>
    <% over = @workspaces.select { |w| w.ai_plan && (@billing[w.id]&.price || 0) > w.ai_plan.monthly_price_usd } %>
    <p class="m-0 text-[12.5px] leading-[1.5] clar-text-muted">
      <%= over.any? ? "#{over.map(&:name).to_sentence} #{over.size == 1 ? 'is' : 'are'} over this month." : "Nobody is over this month." %>
      An organization paying for its plan is paused at its limit (or uses its top-up) instead of going over; one without an active plan is never paused.
    </p>
  </div>
</div>
