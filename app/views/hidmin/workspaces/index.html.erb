<% content_for :title, "Organizations · Hidmin" %>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="clar-h1">Organizations</h1>
    <p class="clar-text-muted text-[13px] mt-1"><%= pluralize(@workspaces.size, "organization") %>. In the app they are called workspaces.</p>
  </div>
  <%= link_to "New organization", new_hidmin_workspace_path, class: "clar-btn clar-btn-primary no-underline" %>
</div>

<div class="clar-card">
  <div class="clar-table-head">
    <span class="flex-1">NAME</span>
    <span class="w-24 text-right">PEOPLE</span>
    <span class="w-24 text-right">PROJECTS</span>
    <span class="w-64 pl-6">PRODUCTS</span>
    <span class="w-28 text-right">CREATED</span>
  </div>
  <div class="divide-y divide-[color:var(--border)]">
    <% @workspaces.each do |workspace| %>
      <%= link_to hidmin_workspace_path(workspace), class: "flex items-center px-5 py-3 no-underline text-[13px]" do %>
        <span class="flex-1 min-w-0 font-semibold text-[13.5px] clar-text-text truncate"><%= workspace.name %></span>
        <span class="w-24 text-right clar-text-muted"><%= @member_counts.fetch(workspace.id, 0) %></span>
        <span class="w-24 text-right clar-text-muted"><%= @project_counts.fetch(workspace.id, 0) %></span>
        <span class="w-64 pl-6 flex gap-1.5">
          <% if workspace.workshop_enabled? %><span class="clar-badge clar-badge-ai">Workshop</span><% end %>
          <% if workspace.hr_access? %><span class="clar-badge clar-badge-primary">Time &amp; HR</span><% end %>
          <% if workspace.clients_enabled? %><span class="clar-badge clar-badge-muted">Clients</span><% end %>
        </span>
        <span class="w-28 text-right clar-text-faint"><%= l(workspace.created_at.to_date, format: :long) %></span>
      <% end %>
    <% end %>
  </div>
</div>
