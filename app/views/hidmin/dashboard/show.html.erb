<% content_for :title, "Overview · Hidmin" %>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="clar-h1">Overview</h1>
    <p class="clar-text-muted text-[13px] mt-1">Every organization on Flosis. Only Flosis staff see this page.</p>
  </div>
  <%= link_to "New organization", new_hidmin_workspace_path, class: "clar-btn clar-btn-primary no-underline" %>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
  <% [ [ "Organizations", @workspace_count ], [ "People", @user_count ],
       [ "Active projects", @project_count ], [ "Signed in · last 7 days", @active_user_count ] ].each do |label, value| %>
    <div class="clar-card clar-metric">
      <div class="label"><%= label %></div>
      <div class="value clar-text-text"><%= number_with_delimiter(value) %></div>
    </div>
  <% end %>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <section>
    <div class="flex items-center justify-between mb-2.5">
      <h2 class="clar-section-label">Newest organizations</h2>
      <%= link_to "All", hidmin_workspaces_path, class: "text-[12.5px] font-semibold clar-text-primary no-underline" %>
    </div>
    <div class="clar-card divide-y divide-[color:var(--border)]">
      <% @newest_workspaces.each do |workspace| %>
        <%= link_to hidmin_workspace_path(workspace), class: "flex items-center gap-3 px-4 py-3 no-underline" do %>
          <span class="flex-1 min-w-0 font-semibold text-[13.5px] clar-text-text truncate"><%= workspace.name %></span>
          <span class="text-[12px] clar-text-faint"><%= time_ago_in_words(workspace.created_at) %> ago</span>
        <% end %>
      <% end %>
      <% if @newest_workspaces.empty? %>
        <p class="px-4 py-3 clar-text-faint text-[13px]">None yet.</p>
      <% end %>
    </div>
  </section>

  <section>
    <div class="flex items-center justify-between mb-2.5">
      <h2 class="clar-section-label">Newest people</h2>
      <%= link_to "All", hidmin_users_path, class: "text-[12.5px] font-semibold clar-text-primary no-underline" %>
    </div>
    <div class="clar-card divide-y divide-[color:var(--border)]">
      <% @newest_users.each do |user| %>
        <%= link_to hidmin_user_path(user), class: "flex items-center gap-3 px-4 py-3 no-underline" do %>
          <span class="flex-1 min-w-0">
            <span class="block font-semibold text-[13.5px] clar-text-text truncate"><%= user.name %></span>
            <span class="block text-[12px] clar-text-faint truncate"><%= user.email_address %></span>
          </span>
          <span class="text-[12px] clar-text-faint"><%= time_ago_in_words(user.created_at) %> ago</span>
        <% end %>
      <% end %>
    </div>
  </section>
</div>
