<% content_for(:title, "#{@task.external_reference} — #{@task.name.sub(/\A#{Regexp.escape(@task.external_reference.to_s)}\s*/, '')}") %>
<% content_for(:full_width, true) %>

<div class="space-y-5"
     data-controller="task-chat"
     data-task-chat-create-url-value="<%= jira_task_chat_session_path(@task) %>"
     data-task-chat-message-url-value="<%= message_jira_task_chat_session_path(@task) %>"
     data-task-chat-task-id-value="<%= @task.id %>"
     data-task-chat-current-user-name-value="<%= current_user.name %>"
     data-task-chat-has-session-value="<%= ChatSession.find_active_for(@task, current_user).present? %>">

  <%# Normal breadcrumb — visible in normal state %>
  <div class="flex items-center gap-2 text-sm clar-text-muted" data-task-chat-target="breadcrumb">
    <%= link_to "Jira Tasks", jira_tasks_path(project_id: @selected_project&.id, board_id: @selected_board&.id, sprint_id: @selected_sprint&.id), class: "hover:underline clar-text-primary" %>
    <span>/</span>
    <span class="clar-text-text"><%= @task.external_reference %></span>
    <button class="ml-auto flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg transition-colors clar-badge-primary border border-[color:var(--primary)]/20"
            data-action="click->task-chat#openChat">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
      Chat with AI
    </button>
  </div>

  <%# Chat breadcrumb — visible in sideBySide and fullscreen states %>
  <div class="flex items-center gap-3 text-sm clar-text-muted" data-task-chat-target="chatBreadcrumb" style="display: none">
    <button class="flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-lg transition-colors clar-text-muted bg-[color:var(--surface-2)] border clar-divider"
            data-action="click->task-chat#closeChat">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
      Close Chat
    </button>
    <span class="clar-text-text"><%= @task.external_reference %></span>
  </div>

  <%# Fullscreen chat header — only visible in fullscreen %>
  <div class="flex items-center gap-3 px-4 py-2 rounded-lg bg-[color:var(--surface-2)] border clar-divider"
       data-task-chat-target="chatHeader"
       style="display: none">
    <span class="text-sm font-semibold clar-text-primary"><%= @task.external_reference %></span>
    <span class="text-sm font-medium truncate clar-text-text">
      <%= @task.name.sub(/\A#{Regexp.escape(@task.external_reference.to_s)}\s*/, '') %>
    </span>
    <div class="ml-auto flex items-center gap-2">
      <span class="clar-badge clar-badge-primary">
        <%= @task.jira_status_name %>
      </span>
    </div>
  </div>

  <div class="flex gap-6 min-h-[calc(100vh-12rem)]">
    <%# Main content %>
    <div class="flex-1 min-w-0" data-task-chat-target="taskContent">
      <div class="clar-card p-6 space-y-5">
        <%# Header %>
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="text-sm font-semibold clar-text-primary">
              <%= @task.external_reference %>
            </span>
          </div>
          <h1 class="text-2xl font-bold clar-text-text">
            <%= @task.name.sub(/\A#{Regexp.escape(@task.external_reference.to_s)}\s*/, '') %>
          </h1>
        </div>

        <%# Status badges %>
        <div class="flex items-center gap-2">
          <span class="clar-badge clar-badge-primary">
            <%= @task.jira_status_name %>
          </span>
          <% if @task.issue_type.present? %>
            <span class="clar-badge clar-badge-ai">
              <%= @task.issue_type %>
            </span>
          <% end %>
        </div>

        <%# Description %>
        <% if @task.description.present? %>
          <div data-controller="lightbox">
            <h2 class="text-sm font-semibold mb-3 clar-text-muted">Description</h2>
            <div class="adf-content text-sm leading-relaxed p-4 rounded-lg clar-text-text bg-[color:var(--surface-2)]">
              <% if @task.description_adf.present? %>
                <%= adf_to_html(@task.description_adf, attachments: @task.attachments) %>
              <% else %>
                <div class="whitespace-pre-wrap"><%= @task.description %></div>
              <% end %>
            </div>

            <%# Lightbox overlay for description images %>
            <div data-lightbox-target="overlay"
                 data-action="click->lightbox#close keydown@window->lightbox#handleKeydown"
                 class="fixed inset-0 bg-black/85 z-[1000] items-center justify-center p-8 cursor-zoom-out"
                 style="display: none;">
              <div class="relative max-w-[95vw] max-h-[95vh] flex flex-col items-center gap-3"
                   data-action="click->lightbox#stopPropagation">
                <img data-lightbox-target="image" class="max-w-[95vw] max-h-[85vh] object-contain rounded-md">
                <div data-lightbox-target="caption" class="text-white text-sm"></div>
              </div>
              <button type="button"
                      data-action="click->lightbox#close"
                      aria-label="Close"
                      class="absolute top-4 right-4 bg-white/15 text-white border-none rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          </div>
        <% end %>

        <%# Attachments %>
        <% if @task.attachments.attached? %>
          <div data-controller="lightbox">
            <h2 class="text-sm font-semibold mb-3 clar-text-muted">
              Attachments <span class="clar-text-faint"><%= @task.attachments.count %></span>
            </h2>
            <div class="grid gap-2 [grid-template-columns:repeat(auto-fill,minmax(120px,1fr))]">
              <% @task.attachments.each do |att| %>
                <% is_image = att.content_type.to_s.start_with?("image/") %>
                <% url = rails_blob_path(att, disposition: "inline") %>
                <% if is_image %>
                  <button type="button"
                          class="block rounded-md overflow-hidden text-left transition-colors bg-[color:var(--surface-2)] border clar-divider cursor-zoom-in"
                          data-action="click->lightbox#open"
                          data-lightbox-src-param="<%= url %>"
                          data-lightbox-caption-param="<%= att.filename %>">
                    <div class="aspect-square overflow-hidden bg-[color:var(--surface-2)]">
                      <img src="<%= url %>"
                           alt="<%= att.filename %>"
                           class="w-full h-full object-cover"
                           loading="lazy">
                    </div>
                    <div class="px-1.5 py-1 text-xs truncate clar-text-text text-[0.6875rem]">
                      <%= att.filename %>
                    </div>
                  </button>
                <% else %>
                  <a href="<%= url %>" target="_blank" rel="noopener"
                     class="block rounded-md overflow-hidden transition-colors bg-[color:var(--surface-2)] border clar-divider">
                    <div class="flex items-center justify-center aspect-square bg-[color:var(--surface-2)]">
                      <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 clar-text-faint" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                      </svg>
                    </div>
                    <div class="px-1.5 py-1 text-xs truncate clar-text-text text-[0.6875rem]">
                      <%= att.filename %>
                    </div>
                  </a>
                <% end %>
              <% end %>
            </div>

            <%# Lightbox overlay %>
            <div data-lightbox-target="overlay"
                 data-action="click->lightbox#close keydown@window->lightbox#handleKeydown"
                 class="fixed inset-0 bg-black/85 z-[1000] items-center justify-center p-8 cursor-zoom-out"
                 style="display: none;">
              <div class="relative max-w-[95vw] max-h-[95vh] flex flex-col items-center gap-3"
                   data-action="click->lightbox#stopPropagation">
                <img data-lightbox-target="image" class="max-w-[95vw] max-h-[85vh] object-contain rounded-md">
                <div data-lightbox-target="caption" class="text-white text-sm"></div>
              </div>
              <button type="button"
                      data-action="click->lightbox#close"
                      aria-label="Close"
                      class="absolute top-4 right-4 bg-white/15 text-white border-none rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          </div>
        <% end %>

        <%# Comments %>
        <% if @task.jira_comments.any? %>
          <div data-controller="lightbox">
            <h2 class="text-sm font-semibold mb-3 clar-text-muted">
              Comments <span class="clar-text-faint"><%= @task.jira_comments.count %></span>
            </h2>
            <div class="space-y-3">
              <% @task.jira_comments.ordered.each do |comment| %>
                <div class="rounded-lg p-4 bg-[color:var(--surface-2)] border clar-divider">
                  <div class="flex items-center justify-between mb-2">
                    <div class="flex items-center gap-2">
                      <div class="clar-avatar w-6 h-6 text-[0.625rem] <%= clar_avatar_bg_class(comment.author_name || comment.author_email || "?") %>">
                        <%= (comment.author_name || comment.author_email || "?").split(/[\s@]/).map(&:first).join.first(2).upcase %>
                      </div>
                      <span class="text-sm font-medium clar-text-text">
                        <%= comment.author_name || comment.author_email || "Unknown" %>
                      </span>
                    </div>
                    <span class="text-xs clar-text-faint">
                      <%= comment.jira_created_at&.strftime("%b %d, %Y %H:%M") %>
                    </span>
                  </div>
                  <div class="adf-content text-sm leading-relaxed clar-text-text">
                    <% if comment.body_adf.present? %>
                      <%= adf_to_html(comment.body_adf, attachments: @task.attachments) %>
                    <% else %>
                      <div class="whitespace-pre-wrap"><%= comment.body %></div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <%# Lightbox overlay for comments %>
            <div data-lightbox-target="overlay"
                 data-action="click->lightbox#close keydown@window->lightbox#handleKeydown"
                 class="fixed inset-0 bg-black/85 z-[1000] items-center justify-center p-8 cursor-zoom-out"
                 style="display: none;">
              <div class="relative max-w-[95vw] max-h-[95vh] flex flex-col items-center gap-3"
                   data-action="click->lightbox#stopPropagation">
                <img data-lightbox-target="image" class="max-w-[95vw] max-h-[85vh] object-contain rounded-md">
                <div data-lightbox-target="caption" class="text-white text-sm"></div>
              </div>
              <button type="button"
                      data-action="click->lightbox#close"
                      aria-label="Close"
                      class="absolute top-4 right-4 bg-white/15 text-white border-none rounded-full w-9 h-9 flex items-center justify-center cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# Details sidebar — visible in normal state only %>
    <div class="w-72 flex-shrink-0" data-task-chat-target="details">
      <div class="clar-card p-5 space-y-4 sticky top-5">
        <h2 class="text-sm font-semibold clar-text-muted">Details</h2>

        <div class="space-y-3 text-sm">
          <div>
            <dt class="text-xs mb-0.5 clar-text-faint">Assignee</dt>
            <dd class="font-medium clar-text-text">
              <% if @task.assignee_name.present? || @task.assignee_email.present? %>
                <div class="flex items-center gap-2">
                  <div class="clar-avatar w-6 h-6 text-[0.6rem] <%= clar_avatar_bg_class(@task.assignee_name || @task.assignee_email) %>">
                    <%= (@task.assignee_name || @task.assignee_email).split(/[\s@]/).map(&:first).join.first(2).upcase %>
                  </div>
                  <%= @task.assignee_name || @task.assignee_email %>
                </div>
              <% else %>
                Unassigned
              <% end %>
            </dd>
          </div>

          <div>
            <dt class="text-xs mb-0.5 clar-text-faint">Reporter</dt>
            <dd class="font-medium clar-text-text"><%= @task.reporter_name || @task.reporter_email || "—" %></dd>
          </div>

          <div>
            <dt class="text-xs mb-0.5 clar-text-faint">Priority</dt>
            <dd class="font-medium flex items-center gap-1 clar-text-text">
              <% if @task.priority.present? %>
                <% case @task.priority.downcase %>
                <% when "highest", "high" %>
                  <svg class="h-4 w-4 clar-text-danger" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M14.77 12.79a.75.75 0 01-1.06-.02L10 8.832 6.29 12.77a.75.75 0 11-1.08-1.04l4.25-4.5a.75.75 0 011.08 0l4.25 4.5a.75.75 0 01-.02 1.06z" clip-rule="evenodd" /></svg>
                <% when "medium" %>
                  <svg class="h-4 w-4 clar-text-warn" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h12.5a.75.75 0 010 1.5H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
                <% when "low", "lowest" %>
                  <svg class="h-4 w-4 clar-text-primary" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
                <% end %>
                <%= @task.priority %>
              <% else %>
                —
              <% end %>
            </dd>
          </div>

          <div>
            <dt class="text-xs mb-0.5 clar-text-faint">Sprint</dt>
            <dd class="font-medium clar-text-text"><%= @task.sprint_name || "—" %></dd>
          </div>

          <% if @task.labels.present? %>
            <% labels = begin; JSON.parse(@task.labels); rescue; []; end %>
            <% if labels.any? %>
              <div>
                <dt class="text-xs mb-1 clar-text-faint">Labels</dt>
                <dd class="flex flex-wrap gap-1">
                  <% labels.each do |label| %>
                    <span class="clar-badge clar-badge-muted">
                      <%= label %>
                    </span>
                  <% end %>
                </dd>
              </div>
            <% end %>
          <% end %>

          <% if @task.time_estimate_seconds.present? && @task.time_estimate_seconds > 0 %>
            <div>
              <dt class="text-xs mb-0.5 clar-text-faint">Estimate</dt>
              <dd class="font-medium clar-text-text">
                <%= @task.time_estimate_seconds / 3600 %>h <%= (@task.time_estimate_seconds % 3600) / 60 %>m
              </dd>
            </div>
          <% end %>
        </div>

        <%# Chat button in details %>
        <div class="pt-2 space-y-2"
             data-controller="task-draft"
             data-task-draft-fetch-url-value="<%= jira_task_task_drafts_path(@task) %>">
          <button class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors clar-badge-primary border border-[color:var(--primary)]/20"
                  data-action="click->task-chat#openChat">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 01.865-.501 48.172 48.172 0 003.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" /></svg>
            Chat with AI
          </button>
          <button class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-[color:var(--surface-2)] clar-text-text border clar-divider"
                  data-action="click->task-draft#open">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
            AI refined ticket description
          </button>
          <%= link_to jira_task_breakdown_path(@task),
                      class: "w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-lg text-sm font-medium transition-colors bg-[color:var(--surface-2)] clar-text-text border clar-divider" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
            AI estimate &amp; breakdown
          <% end %>
          <a href="<%= @task.external_url %>" target="_blank" rel="noopener"
             class="clar-btn clar-btn-primary w-full inline-flex items-center justify-center gap-2">
            View in Jira
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>

          <%# AI draft modal %>
          <div data-task-draft-target="overlay"
               data-action="click->task-draft#close keydown@window->task-draft#handleKeydown"
               class="fixed inset-0 bg-black/55 z-[1100] items-start justify-center p-8 pt-20"
               style="display: none;">
            <div data-action="click->task-draft#stopPropagation"
                 class="bg-[color:var(--surface)] rounded-xl max-w-[900px] w-full max-h-[calc(100vh-7rem)] flex flex-col shadow-[0_24px_60px_rgba(0,0,0,0.35)]">
              <div class="flex items-center justify-between px-5 py-4 border-b clar-divider">
                <div class="flex items-center gap-3">
                  <h3 class="text-base font-semibold clar-text-text">AI refined ticket — <%= @task.external_reference %></h3>
                  <select data-task-draft-target="versionSelect"
                          data-action="change->task-draft#selectVersion"
                          class="clar-select text-xs rounded-md px-2 py-1"></select>
                </div>
                <div class="flex items-center gap-2">
                  <button type="button"
                          data-action="click->task-draft#copy"
                          data-task-draft-target="copyBtn"
                          class="text-xs px-3 py-1.5 rounded-md transition-colors bg-[color:var(--primary)] text-white border-none">
                    Copy to clipboard
                  </button>
                  <button type="button" data-action="click->task-draft#close" aria-label="Close"
                          class="bg-[color:var(--surface-2)] clar-text-text border-none rounded-full w-8 h-8 flex items-center justify-center cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                  </button>
                </div>
              </div>
              <div data-task-draft-target="content"
                   class="adf-content clar-text-text overflow-y-auto flex-1 text-sm leading-[1.55] px-6 py-5">
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# Chat panel (initially hidden) %>
    <%= render "jira_tasks/chat_panel", task: @task %>
  </div>
</div>
