<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Tags</h1>
    <%= link_to "New Tag", new_tag_path, class: "btn btn-primary btn-sm" %>
  </div>

  <div class="card bg-base-100 shadow">
    <div class="card-body">
      <% if @tags.any? %>
        <div class="flex flex-wrap gap-3">
          <% @tags.each do |tag| %>
            <div class="flex items-center gap-2 p-2 rounded-lg border border-base-300 hover:bg-base-200">
              <span class="w-3 h-3 rounded-full" style="background-color: <%= tag.color %>"></span>
              <span class="font-medium text-sm"><%= tag.name %></span>
              <div class="flex gap-1 ml-2">
                <%= link_to edit_tag_path(tag), class: "btn btn-ghost btn-xs" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                <% end %>
                <%= button_to tag_path(tag), method: :delete, class: "btn btn-ghost btn-xs text-error",
                    data: { turbo_confirm: "Delete #{tag.name}?" } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-center py-8 text-base-content/50">No tags yet. Create tags to categorize time entries.</p>
      <% end %>
    </div>
  </div>
</div>
