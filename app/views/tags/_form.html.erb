<%= form_with model: tag, url: url, class: "space-y-4" do |f| %>
  <% if tag.errors.any? %>
    <div class="m3-alert m3-alert-error">
      <ul><% tag.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Name</label>
    <%= f.text_field :name, class: "m3-text-field w-full", required: true %>
  </div>

  <div class="space-y-1">
    <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Color</label>
    <%= f.color_field :color, class: "m3-text-field w-20 h-10 p-1" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "m3-btn m3-btn-filled" %>
    <%= link_to "Cancel", tags_path, class: "m3-btn m3-btn-text" %>
  </div>
<% end %>
