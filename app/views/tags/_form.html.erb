<%= form_with model: tag, url: url, class: "space-y-4" do |f| %>
  <% if tag.errors.any? %>
    <div class="alert alert-error">
      <ul><% tag.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>

  <div class="form-control">
    <label class="label"><span class="label-text">Name</span></label>
    <%= f.text_field :name, class: "input input-bordered w-full", required: true %>
  </div>

  <div class="form-control">
    <label class="label"><span class="label-text">Color</span></label>
    <%= f.color_field :color, class: "input input-bordered w-20 h-10 p-1" %>
  </div>

  <div class="flex gap-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", tags_path, class: "btn btn-ghost" %>
  </div>
<% end %>
