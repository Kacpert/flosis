<div class="m3-card-elevated p-6">
  <h2 class="text-xl font-bold text-center mb-4" style="color: var(--color-on-surface)">Reset Password</h2>

  <%= form_with url: passwords_path, class: "space-y-4" do |f| %>
    <div class="space-y-1">
      <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Email</label>
      <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
          class: "m3-text-field w-full", placeholder: "you@example.com" %>
    </div>

    <div class="mt-6">
      <%= f.submit "Send Reset Instructions", class: "m3-btn m3-btn-filled w-full" %>
    </div>
  <% end %>

  <p class="text-center text-sm mt-4">
    <%= link_to "Back to sign in", new_session_path, style: "color: var(--color-primary); text-decoration: none;", onmouseover: "this.style.textDecoration='underline'", onmouseout: "this.style.textDecoration='none'" %>
  </p>
</div>
