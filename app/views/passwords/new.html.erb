<% content_for :title, "Reset password · Flosis" %>

<h1 class="m-0 text-[27px] font-bold tracking-[-.7px] clar-text-text">Reset password</h1>
<p class="mt-2 mb-[26px] text-[14px] clar-text-muted leading-[1.5]">We&rsquo;ll email you a link to choose a new one.</p>

<%= form_with url: passwords_path do |f| %>
  <label class="clar-field-label tracking-[.04em]">EMAIL</label>
  <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "email",
        placeholder: "you@company.com",
        class: "clar-input !text-[14px] !bg-[color:var(--surface)] mb-5" %>

  <%= f.submit "Send reset instructions", class: "clar-btn clar-btn-primary w-full !text-[14px] !rounded-[10px] !py-3" %>
<% end %>

<p class="mt-[22px] mb-0 text-[12.5px] clar-text-faint text-center">
  <%= link_to "Back to sign in", new_session_path, class: "clar-text-primary font-semibold no-underline" %>
</p>
