<div class="m3-card-elevated p-6">
  <h2 class="text-xl font-bold text-center mb-4" style="color: var(--color-on-surface)">Set New Password</h2>

  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4" do |f| %>
    <div class="space-y-1">
      <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">New Password</label>
      <%= f.password_field :password, required: true, autocomplete: "new-password",
          class: "m3-text-field w-full" %>
    </div>

    <div class="space-y-1">
      <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Confirm Password</label>
      <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
          class: "m3-text-field w-full" %>
    </div>

    <div class="mt-6">
      <%= f.submit "Update Password", class: "m3-btn m3-btn-filled w-full" %>
    </div>
  <% end %>
</div>
