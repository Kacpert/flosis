<% content_for :title, "Set a new password · Flosis" %>

<h1 class="m-0 text-[27px] font-bold tracking-[-.7px] clar-text-text">Set a new password</h1>
<p class="mt-2 mb-[26px] text-[14px] clar-text-muted leading-[1.5]">Choose something you haven&rsquo;t used before.</p>

<%= form_with url: password_path(params[:token]), method: :put do |f| %>
  <label class="clar-field-label tracking-[.04em]">NEW PASSWORD</label>
  <%= f.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
        placeholder: "••••••••",
        class: "clar-input !text-[14px] !bg-[color:var(--surface)] mb-4" %>

  <label class="clar-field-label tracking-[.04em]">CONFIRM PASSWORD</label>
  <%= f.password_field :password_confirmation, required: true, autocomplete: "new-password",
        placeholder: "••••••••",
        class: "clar-input !text-[14px] !bg-[color:var(--surface)] mb-5" %>

  <%= f.submit "Update password", class: "clar-btn clar-btn-primary w-full !text-[14px] !rounded-[10px] !py-3" %>
<% end %>
