<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Weekly Report</h1>
    <div class="flex gap-2">
      <%= link_to "CSV", export_csv_reports_weekly_path(request.query_parameters), class: "btn btn-ghost btn-sm" %>
      <%= link_to "PDF", export_pdf_reports_weekly_path(request.query_parameters), class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <!-- Week navigation -->
  <div class="flex items-center justify-between">
    <%= link_to reports_weekly_path(week_of: (@week_start - 7.days), group_by: @group_by), class: "btn btn-ghost btn-sm" do %>
      &larr; Previous
    <% end %>
    <span class="font-medium">
      <%= @week_start.strftime("%b %d") %> - <%= (@week_start + 6.days).strftime("%b %d, %Y") %>
    </span>
    <%= link_to reports_weekly_path(week_of: (@week_start + 7.days), group_by: @group_by), class: "btn btn-ghost btn-sm" do %>
      Next &rarr;
    <% end %>
  </div>

  <!-- Filters -->
  <%= form_with url: reports_weekly_path, method: :get, class: "flex gap-3 items-end" do |f| %>
    <%= f.hidden_field :week_of, value: @week_start %>
    <div class="form-control">
      <label class="label label-text text-xs">Group by</label>
      <%= f.select :group_by, [["User", "user"], ["Project", "project"]],
          { selected: @group_by }, class: "select select-bordered select-sm" %>
    </div>
    <div class="form-control">
      <label class="label label-text text-xs">Project</label>
      <%= f.select :project_id, @projects.map { |p| [p.name, p.id] },
          { include_blank: "All" }, class: "select select-bordered select-sm" %>
    </div>
    <%= f.submit "Apply", class: "btn btn-primary btn-sm" %>
  <% end %>

  <!-- Chart -->
  <% if @grid.any? %>
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <div class="h-64">
          <canvas data-controller="chart"
                  data-chart-type-value="bar"
                  data-chart-data-value='<%= {
                    labels: @week_days.map { |d| d.strftime("%a %d") },
                    datasets: @grid.map.with_index { |(name, days), i|
                      colors = %w[#3B82F6 #EF4444 #10B981 #F59E0B #8B5CF6 #EC4899 #06B6D4 #F97316]
                      {
                        label: name,
                        data: @week_days.map { |d| ((days[d] || 0) / 3600.0).round(2) },
                        backgroundColor: colors[i % colors.length]
                      }
                    }
                  }.to_json %>'
                  data-chart-options-value='<%= { scales: { x: { stacked: true }, y: { stacked: true, title: { display: true, text: "Hours" } } } }.to_json %>'></canvas>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Table -->
  <div class="card bg-base-100 shadow overflow-x-auto">
    <table class="table table-sm">
      <thead>
        <tr>
          <th><%= @group_by.titleize %></th>
          <% @week_days.each do |day| %>
            <th class="text-center <%= day == Date.current ? 'bg-primary/10' : '' %>">
              <div><%= day.strftime("%a") %></div>
              <div class="text-xs"><%= day.strftime("%d") %></div>
            </th>
          <% end %>
          <th class="text-center">Total</th>
        </tr>
      </thead>
      <tbody>
        <% @grid.each do |name, days| %>
          <tr>
            <td class="font-medium"><%= name %></td>
            <% @week_days.each do |day| %>
              <% seconds = days[day] || 0 %>
              <td class="text-center font-mono text-sm <%= day == Date.current ? 'bg-primary/10' : '' %>">
                <%= seconds > 0 ? format("%d:%02d", seconds / 3600, (seconds % 3600) / 60) : "" %>
              </td>
            <% end %>
            <td class="text-center font-mono font-bold">
              <% total = days.values.sum %>
              <%= format("%d:%02d", total / 3600, (total % 3600) / 60) %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="font-bold">
          <td>Total</td>
          <% @week_days.each do |day| %>
            <td class="text-center font-mono <%= day == Date.current ? 'bg-primary/10' : '' %>">
              <% total = @day_totals[day] || 0 %>
              <%= total > 0 ? format("%d:%02d", total / 3600, (total % 3600) / 60) : "" %>
            </td>
          <% end %>
          <td class="text-center font-mono">
            <% grand_total = @day_totals.values.sum %>
            <%= format("%d:%02d", grand_total / 3600, (grand_total % 3600) / 60) %>
          </td>
        </tr>
      </tfoot>
    </table>
  </div>

  <% if @grid.empty? %>
    <div class="text-center py-8 text-base-content/50">No data for this week.</div>
  <% end %>
</div>
