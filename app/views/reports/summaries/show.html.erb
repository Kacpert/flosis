<div class="space-y-5">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-on-surface)">Summary Report</h1>
    <div class="flex gap-2">
      <%= link_to "CSV", export_csv_reports_summary_path(request.query_parameters), class: "m3-btn m3-btn-text m3-btn-sm" %>
      <%= link_to "PDF", export_pdf_reports_summary_path(request.query_parameters), class: "m3-btn m3-btn-text m3-btn-sm" %>
    </div>
  </div>

  <%# Filters %>
  <%= form_with url: reports_summary_path, method: :get, class: "filter-panel" do |f| %>
    <%= render "shared/date_range_presets" %>
    <div class="flex flex-wrap gap-3 items-end">
      <div class="space-y-1">
        <label class="text-xs font-medium" style="color: var(--color-on-surface-variant)">From</label>
        <%= f.date_field :from, value: @from, class: "m3-text-field" %>
      </div>
      <div class="space-y-1">
        <label class="text-xs font-medium" style="color: var(--color-on-surface-variant)">To</label>
        <%= f.date_field :to, value: @to, class: "m3-text-field" %>
      </div>
      <div class="space-y-1">
        <label class="text-xs font-medium" style="color: var(--color-on-surface-variant)">Group by</label>
        <%= f.select :group_by, [["Project", "project"], ["Client", "client"], ["User", "user"], ["Tag", "tag"]],
            { selected: @group_by }, class: "m3-text-field" %>
      </div>
      <div class="space-y-1">
        <label class="text-xs font-medium" style="color: var(--color-on-surface-variant)">Project</label>
        <%= f.select :project_id, @projects.map { |p| [p.name, p.id] },
            { include_blank: "All" }, class: "m3-text-field" %>
      </div>
      <div class="space-y-1">
        <label class="text-xs font-medium" style="color: var(--color-on-surface-variant)">Billable</label>
        <%= f.select :billable, [["Yes", "1"], ["No", "0"]],
            { include_blank: "All" }, class: "m3-text-field" %>
      </div>
      <%= f.submit "Apply", class: "m3-btn m3-btn-filled m3-btn-sm" %>
    </div>
  <% end %>

  <%# Stats %>
  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
    <div class="stat-card">
      <div class="stat-label">Total Hours</div>
      <div class="stat-number"><%= format_duration_hm(@total_seconds) %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Billable Hours</div>
      <div class="stat-number" style="color: var(--color-success)"><%= format_duration_hm(@billable_seconds) %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Billable Amount</div>
      <div class="stat-number">$<%= '%.2f' % @billable_amount %></div>
    </div>
  </div>

  <% if @chart_data.any? %>
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem;">
      <%# Pie chart %>
      <div class="stat-card">
        <h2 class="section-header mb-3">Distribution</h2>
        <div class="h-72">
          <canvas data-controller="chart"
                  data-chart-type-value="pie"
                  data-chart-data-value='<%= {
                    labels: @chart_data.map { |d| d[:name] },
                    datasets: [{
                      data: @chart_data.map { |d| (d[:seconds] / 3600.0).round(2) },
                      backgroundColor: @chart_data.map { |d| d[:color] }
                    }]
                  }.to_json %>'></canvas>
        </div>
      </div>

      <%# Bar chart %>
      <div class="stat-card">
        <h2 class="section-header mb-3">Daily Breakdown</h2>
        <div class="h-72">
          <canvas data-controller="chart"
                  data-chart-type-value="bar"
                  data-chart-data-value='<%= {
                    labels: @daily_data.map { |d| d[:date] },
                    datasets: [{
                      label: "Hours",
                      data: @daily_data.map { |d| (d[:seconds] / 3600.0).round(2) },
                      backgroundColor: "#4A6741"
                    }]
                  }.to_json %>'></canvas>
        </div>
      </div>
    </div>

    <%# Data table %>
    <div class="m3-card-outlined overflow-hidden">
      <table class="m3-table">
        <thead>
          <tr>
            <th><%= @group_by.titleize %></th>
            <th class="text-right">Hours</th>
            <th class="text-right">%</th>
          </tr>
        </thead>
        <tbody>
          <% @chart_data.sort_by { |d| -d[:seconds] }.each do |data| %>
            <tr>
              <td class="flex items-center gap-2">
                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: <%= data[:color] %>"></span>
                <%= link_to data[:name], reports_detailed_path(from: @from, to: @to, "#{@group_by}_id": data[:id]),
                    style: "color: var(--color-on-surface); text-decoration: none; transition: color 0.15s;", onmouseover: "this.style.color='var(--color-primary)'", onmouseout: "this.style.color='var(--color-on-surface)'" %>
              </td>
              <td class="text-right mono-duration"><%= format_duration_hm(data[:seconds]) %></td>
              <td class="text-right" style="color: var(--color-on-surface-variant)"><%= @total_seconds > 0 ? (data[:seconds].to_f / @total_seconds * 100).round(1) : 0 %>%</td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
      <p class="empty-state-title">No data for this period</p>
      <p class="empty-state-desc">Adjust your filters or date range</p>
    </div>
  <% end %>
</div>
