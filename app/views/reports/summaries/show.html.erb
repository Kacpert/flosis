<div class="space-y-5">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-on-surface)">Monthly Report</h1>
    <div class="flex gap-2">
      <%= link_to "CSV", export_csv_reports_summary_path(request.query_parameters), class: "m3-btn m3-btn-text m3-btn-sm" %>
      <%= link_to "PDF", export_pdf_reports_summary_path(request.query_parameters), class: "m3-btn m3-btn-text m3-btn-sm" %>
    </div>
  </div>

  <%# Month navigation %>
  <% nav_params = params[:project_id].present? ? { project_id: params[:project_id] } : {} %>
  <div class="flex items-center justify-between">
    <% prev_month = @from - 1.month %>
    <%= link_to reports_summary_path(nav_params.merge(from: prev_month.beginning_of_month, to: prev_month.end_of_month)), class: "m3-btn m3-btn-text m3-btn-sm" do %>
      &larr; Previous
    <% end %>
    <span class="font-medium" style="color: var(--color-on-surface)">
      <%= @from.strftime("%B %Y") %>
    </span>
    <% if @from < Date.current.beginning_of_month %>
      <% next_month = @from + 1.month %>
      <%= link_to reports_summary_path(nav_params.merge(from: next_month.beginning_of_month, to: next_month.end_of_month)), class: "m3-btn m3-btn-text m3-btn-sm" do %>
        Next &rarr;
      <% end %>
    <% else %>
      <span class="m3-btn m3-btn-text m3-btn-sm invisible">Next &rarr;</span>
    <% end %>
  </div>

  <%# Project filter %>
  <%= form_with url: reports_summary_path, method: :get, class: "filter-panel" do |f| %>
    <%= f.hidden_field :from, value: @from %>
    <%= f.hidden_field :to, value: @to %>
    <div class="flex flex-wrap gap-3 items-end">
      <div class="space-y-1">
        <label class="text-xs font-medium" style="color: var(--color-on-surface-variant)">Project</label>
        <%= f.select :project_id, @projects.map { |p| [p.name, p.id] },
            { include_blank: "All Projects", selected: params[:project_id] }, class: "m3-text-field" %>
      </div>
      <%= f.submit "Apply", class: "m3-btn m3-btn-filled m3-btn-sm" %>
    </div>
  <% end %>

  <%# Total hours stat %>
  <div class="stat-card">
    <div class="stat-label">Total Hours</div>
    <div class="stat-number"><%= format_duration_hm(@total_seconds) %></div>
  </div>

  <% if @user_data.any? %>
    <%# Team Overview - User breakdown %>
    <div class="m3-card-outlined overflow-hidden">
      <div class="px-4 py-3 border-b" style="border-color: var(--color-outline-variant)">
        <h2 class="text-base font-bold" style="color: var(--color-on-surface)">Team Overview</h2>
      </div>
      <table class="m3-table">
        <thead>
          <tr>
            <th>Team Member</th>
            <th class="text-right">Hours</th>
            <th class="text-right">%</th>
            <th style="width: 40%"></th>
          </tr>
        </thead>
        <tbody>
          <% @user_data.each do |data| %>
            <% pct = @total_seconds > 0 ? (data[:seconds].to_f / @total_seconds * 100).round(1) : 0 %>
            <tr>
              <td class="font-medium text-sm" style="color: var(--color-on-surface)"><%= data[:name] %></td>
              <td class="text-right font-mono text-sm" style="color: var(--color-on-surface)">
                <%= format("%d:%02d", data[:seconds] / 3600, (data[:seconds] % 3600) / 60) %>
              </td>
              <td class="text-right text-sm" style="color: var(--color-on-surface-variant)"><%= pct %>%</td>
              <td>
                <div class="w-full rounded-full h-2" style="background: var(--color-surface-variant)">
                  <div class="h-2 rounded-full" style="width: <%= pct %>%; background: var(--color-primary)"></div>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%# Per-project breakdown %>
    <% @projects_summary.each do |project_id, project| %>
      <div class="m3-card-outlined overflow-hidden">
        <div class="px-4 py-3 border-b flex items-center justify-between" style="border-color: var(--color-outline-variant)">
          <div class="flex items-center gap-2">
            <%= project_color_dot(project[:color]) %>
            <h2 class="text-base font-bold" style="color: var(--color-on-surface)">
              <%= link_to project[:name], reports_detailed_path(from: @from, to: @to, project_id: project_id),
                  style: "color: var(--color-on-surface); text-decoration: none;",
                  onmouseover: "this.style.color='var(--color-primary)'",
                  onmouseout: "this.style.color='var(--color-on-surface)'" %>
            </h2>
          </div>
          <span class="font-mono font-bold text-sm" style="color: var(--color-on-surface)">
            <%= format("%d:%02d", project[:total] / 3600, (project[:total] % 3600) / 60) %>
          </span>
        </div>
        <table class="m3-table">
          <thead>
            <tr>
              <th>Team Member</th>
              <th class="text-right">Hours</th>
              <th class="text-right">% of project</th>
            </tr>
          </thead>
          <tbody>
            <% project[:users].sort_by { |_, v| -v[:seconds] }.each do |user_id, user| %>
              <% pct = project[:total] > 0 ? (user[:seconds].to_f / project[:total] * 100).round(1) : 0 %>
              <tr>
                <td class="text-sm" style="color: var(--color-on-surface)">
                  <%= link_to user[:name], reports_detailed_path(from: @from, to: @to, project_id: project_id, user_id: user_id),
                      style: "color: var(--color-on-surface); text-decoration: none;",
                      onmouseover: "this.style.color='var(--color-primary)'",
                      onmouseout: "this.style.color='var(--color-on-surface)'" %>
                </td>
                <td class="text-right font-mono text-sm" style="color: var(--color-on-surface)">
                  <%= format("%d:%02d", user[:seconds] / 3600, (user[:seconds] % 3600) / 60) %>
                </td>
                <td class="text-right text-sm" style="color: var(--color-on-surface-variant)"><%= pct %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-icon">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
      <p class="empty-state-title">No data for this period</p>
      <p class="empty-state-desc">Try a different month</p>
    </div>
  <% end %>
</div>
