<div class="space-y-4">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold">Summary Report</h1>
    <div class="flex gap-2">
      <%= link_to "CSV", export_csv_reports_summary_path(request.query_parameters), class: "btn btn-ghost btn-sm" %>
      <%= link_to "PDF", export_pdf_reports_summary_path(request.query_parameters), class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <!-- Filters -->
  <%= form_with url: reports_summary_path, method: :get, class: "card bg-base-100 shadow p-4" do |f| %>
    <%= render "shared/date_range_presets" %>
    <div class="flex flex-wrap gap-3 items-end">
      <div class="form-control">
        <label class="label label-text text-xs">From</label>
        <%= f.date_field :from, value: @from, class: "input input-bordered input-sm" %>
      </div>
      <div class="form-control">
        <label class="label label-text text-xs">To</label>
        <%= f.date_field :to, value: @to, class: "input input-bordered input-sm" %>
      </div>
      <div class="form-control">
        <label class="label label-text text-xs">Group by</label>
        <%= f.select :group_by, [["Project", "project"], ["Client", "client"], ["User", "user"], ["Tag", "tag"]],
            { selected: @group_by }, class: "select select-bordered select-sm" %>
      </div>
      <div class="form-control">
        <label class="label label-text text-xs">Project</label>
        <%= f.select :project_id, @projects.map { |p| [p.name, p.id] },
            { include_blank: "All" }, class: "select select-bordered select-sm" %>
      </div>
      <div class="form-control">
        <label class="label label-text text-xs">Billable</label>
        <%= f.select :billable, [["Yes", "1"], ["No", "0"]],
            { include_blank: "All" }, class: "select select-bordered select-sm" %>
      </div>
      <%= f.submit "Apply", class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>

  <!-- Stats -->
  <div class="stats stats-vertical sm:stats-horizontal shadow w-full bg-base-100">
    <div class="stat">
      <div class="stat-title">Total Hours</div>
      <div class="stat-value text-lg"><%= format_duration_hm(@total_seconds) %></div>
    </div>
    <div class="stat">
      <div class="stat-title">Billable Hours</div>
      <div class="stat-value text-lg text-success"><%= format_duration_hm(@billable_seconds) %></div>
    </div>
    <div class="stat">
      <div class="stat-title">Billable Amount</div>
      <div class="stat-value text-lg">$<%= '%.2f' % @billable_amount %></div>
    </div>
  </div>

  <% if @chart_data.any? %>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <!-- Pie chart -->
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h2 class="card-title text-lg">Distribution</h2>
          <div class="h-80">
            <canvas data-controller="chart"
                    data-chart-type-value="pie"
                    data-chart-data-value='<%= {
                      labels: @chart_data.map { |d| d[:name] },
                      datasets: [{
                        data: @chart_data.map { |d| (d[:seconds] / 3600.0).round(2) },
                        backgroundColor: @chart_data.map { |d| d[:color] }
                      }]
                    }.to_json %>'></canvas>
          </div>
        </div>
      </div>

      <!-- Bar chart -->
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h2 class="card-title text-lg">Daily Breakdown</h2>
          <div class="h-80">
            <canvas data-controller="chart"
                    data-chart-type-value="bar"
                    data-chart-data-value='<%= {
                      labels: @daily_data.map { |d| d[:date] },
                      datasets: [{
                        label: "Hours",
                        data: @daily_data.map { |d| (d[:seconds] / 3600.0).round(2) },
                        backgroundColor: "#3B82F6"
                      }]
                    }.to_json %>'></canvas>
          </div>
        </div>
      </div>
    </div>

    <!-- Data table -->
    <div class="card bg-base-100 shadow">
      <div class="card-body p-0">
        <table class="table">
          <thead>
            <tr>
              <th><%= @group_by.titleize %></th>
              <th class="text-right">Hours</th>
              <th class="text-right">%</th>
            </tr>
          </thead>
          <tbody>
            <% @chart_data.sort_by { |d| -d[:seconds] }.each do |data| %>
              <tr>
                <td class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full" style="background-color: <%= data[:color] %>"></span>
                  <%= link_to data[:name], reports_detailed_path(from: @from, to: @to, "#{@group_by}_id": data[:id]),
                      class: "link link-hover" %>
                </td>
                <td class="text-right font-mono"><%= format_duration_hm(data[:seconds]) %></td>
                <td class="text-right"><%= @total_seconds > 0 ? (data[:seconds].to_f / @total_seconds * 100).round(1) : 0 %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="text-center py-12 text-base-content/50">
      <p>No data for the selected period.</p>
    </div>
  <% end %>
</div>
