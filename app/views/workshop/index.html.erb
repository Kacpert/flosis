<div class="max-w-3xl mx-auto space-y-6">
  <div>
    <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)">Workshop</h1>
    <p class="text-sm" style="color: var(--color-on-surface-variant)">
      Turn ideas into briefs, and briefs into tasks.
    </p>
  </div>

  <% if @project %>
    <div class="m3-card-elevated p-6 space-y-4">
      <h2 class="text-lg font-semibold" style="color: var(--color-on-surface)">Idea → Brief</h2>
      <p class="text-sm" style="color: var(--color-on-surface-variant)">
        Pick an existing design-sprint task or start a new idea, then brief it with the AI Product Owner.
      </p>
      <div class="space-y-2">
        <%= link_to new_idea_workshop_path(project_id: @project.id, mode: "new"),
              class: "block w-full text-center px-4 py-2.5 rounded-[var(--radius-lg)] text-sm font-medium transition-colors",
              style: "color: var(--color-primary); border: 1px solid var(--color-primary)" do %>
          New idea
        <% end %>
        <%= link_to new_idea_workshop_path(project_id: @project.id, mode: "existing"),
              class: "block w-full text-center px-4 py-2.5 rounded-[var(--radius-lg)] text-sm font-medium transition-colors",
              style: "color: var(--color-primary); border: 1px solid var(--color-primary)" do %>
          Existing Jira task
        <% end %>
      </div>
    </div>

    <div class="m3-card-elevated p-6 space-y-2">
      <h2 class="text-lg font-semibold" style="color: var(--color-on-surface)">Brief → Task</h2>
      <p class="text-sm" style="color: var(--color-on-surface-variant)">
        Estimate and break a briefed task into vertical slices, then push the spec to Jira from the task's breakdown page.
      </p>
      <%= link_to "Open Jira Tasks", jira_tasks_path(project_id: @project.id), class: "m3-btn m3-btn-text" %>
    </div>
  <% else %>
    <div class="m3-card-elevated p-6">
      <p class="text-sm" style="color: var(--color-on-surface-variant)">
        No Jira-connected project is available. Connect a project to Jira to use the Workshop.
      </p>
    </div>
  <% end %>
</div>
