<div class="flex items-center gap-2.5 flex-wrap px-5 py-3 border-b clar-divider bg-[var(--surface)] text-[13px]">
  <span class="clar-text-muted">
    <%= link_to "Configuration", workshop_configuration_path(tab: "designs"), class: "clar-text-muted no-underline" %> ›
    <b class="clar-text-text">Setup · <%= current_workshop_project.name %> · Phase <%= @phase_number %>/<%= DesignSetup::PHASES.size %>: <%= @setup.phase.humanize %></b>
  </span>
  <span class="clar-chip cursor-default">wip/setup<% unless @waiting.nil? %> · <%= @waiting %> waiting<% end %></span>
  <% if @crawl_status %>
    <span class="text-[12px] <%= @setup.crawl_error.present? ? "clar-text-warn" : "clar-text-muted" %>"><%= @crawl_status %></span>
  <% end %>

  <span class="flex-1"></span>

  <%= link_to "Open in new tab ↗", @preview_url, target: "_blank", rel: "noopener", class: "clar-btn py-1.5 no-underline",
              data: { designs_preview_target: "open" } %>
  <% if @last_phase %>
    <%= button_to "Approve setup → master", approve_workshop_design_setup_path, class: "clar-btn clar-btn-primary py-1.5",
                  disabled: !@can_approve %>
  <% else %>
    <%= button_to "Next phase", next_phase_workshop_design_setup_path, class: "clar-btn clar-btn-primary py-1.5",
                  form: { data: { turbo_confirm: "Move on to the next phase? This phase's work stays on wip/setup." } } %>
  <% end %>
</div>
