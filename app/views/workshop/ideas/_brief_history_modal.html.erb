<%# Details stage: "Brief history" button (document panel header) opens this
    modal — a READ-ONLY listing of `idea.briefs` versions, plus a link back to
    briefing (Task 5.1). Shares the clar-modal scope with the reset-session
    modal (show.html.erb), keyed by "brief-history" so both triggers can live
    side by side. %>
<%
  briefs = idea.briefs.newest_first.to_a
  default_brief = idea.current_brief || briefs.first
%>
<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="brief-history" data-action="click->clar-modal#close">
  <div class="clar-modal p-0 max-w-[560px] max-h-[80vh] flex flex-col" data-action="click->clar-modal#stopPropagation">
    <div class="px-[22px] py-[18px] border-b clar-divider flex items-center justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <h2 class="text-base font-bold clar-text-text m-0">Briefing history</h2>
        <div class="flex gap-[5px]">
          <% briefs.sort_by(&:version).each do |brief| %>
            <span class="clar-chip <%= default_brief && brief.id == default_brief.id ? 'clar-chip-active' : '' %>">v<%= brief.version %></span>
          <% end %>
        </div>
      </div>
      <button type="button" class="clar-text-faint flex p-1" data-action="clar-modal#close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex-1 overflow-y-auto px-[22px] py-5">
      <% if default_brief.present? %>
        <div class="flex items-center gap-2 mb-3.5">
          <span class="text-[11px] clar-text-faint">Brief v<%= default_brief.version %> &middot; <%= clar_time_ago(default_brief.created_at) %></span>
          <span class="clar-badge clar-badge-muted"><%= default_brief.label.upcase %></span>
        </div>
        <div class="clar-prose" data-controller="clar-markdown"><%= default_brief.content %></div>
      <% else %>
        <div class="text-[13px] clar-text-faint italic">No briefing versions yet.</div>
      <% end %>
    </div>
    <div class="px-[22px] py-3.5 border-t clar-divider flex justify-end">
      <%= link_to workshop_idea_path(idea, stage: "briefing"), class: "clar-btn" do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        Back to briefing to improve
      <% end %>
    </div>
  </div>
</div>
