<% content_for :title, "#{@idea.name} · Clar" %>
<% content_for :clar_full_bleed, true %>

<div class="flex flex-col h-full">
  <%= render "workshop/ideas/workspace_header", idea: @idea, stage: @stage %>

  <%# chat + document panels: left panel (Task 4.2, briefing stage only) and
      right document panel (Task 4.3) %>
  <div class="flex-1 grid grid-cols-2 min-h-0">
    <div class="border-r clar-divider min-h-0">
      <% if @stage == "briefing" %>
        <%= render "workshop/ideas/chat_panel", idea: @idea %>
      <% end %>
    </div>
    <div></div>
  </div>
</div>
