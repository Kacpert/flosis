<% content_for :title, "#{@idea.name} · Flosis" %>
<% content_for :clar_full_bleed, true %>

<div class="flex flex-col h-full" data-controller="clar-modal">
  <%= render "workshop/ideas/workspace_header", idea: @idea, stage: @stage %>

  <% if @stage == "ready" %>
    <%# Ready screen (Task 5.4) — full-width success layout, not the two-panel
        chat+document grid used by briefing/details. %>
    <%= render "workshop/ideas/ready", idea: @idea %>
  <% else %>
    <%# chat + document panels: left panel (Task 4.2 briefing / Task 5.1 details)
        and right document panel (Task 4.3 briefing / Task 5.1 details). Only one
        stage's chat ever mounts per page load, so the clar-chat controller
        never double-mounts (see chat_sessions_controller.rb notes). %>
    <div class="flex-1 grid min-h-0" style="grid-template-columns: minmax(0, 1fr) 460px"
         data-controller="clar-focus" data-clar-focus-target="grid">
      <div class="border-r clar-divider min-h-0 transition-opacity" data-clar-focus-target="chat">
        <% if @stage == "briefing" %>
          <%= render "workshop/ideas/chat_panel", idea: @idea, persona: "briefing" %>
        <% elsif @stage == "details" %>
          <%= render "workshop/ideas/chat_panel", idea: @idea, persona: "details" %>
        <% end %>
      </div>
      <div class="min-h-0">
        <%# No src on the tag (inline content, no load-time refetch). The chat
            saves a new brief version mid-conversation and fires
            clar:document-updated; clar_document_refresh_controller catches it and
            sets src to reload-url, forcing a frame-scoped GET that re-renders this
            panel with the current (newest) brief/draft. Without this the panel
            showed the stale version until a full page refresh. %>
        <%= turbo_frame_tag "clar-document",
              data: { controller: "clar-document-refresh",
                      clar_document_refresh_reload_url_value: workshop_idea_path(@idea, stage: @stage) } do %>
          <% if @stage == "briefing" %>
            <%= render "workshop/ideas/document_panel", idea: @idea, stage: "briefing" %>
          <% elsif @stage == "details" %>
            <%= render "workshop/ideas/document_panel", idea: @idea, stage: "details" %>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Reset session modal (Task 4.4) — shares this clar-modal scope with the
      "Reset session" trigger in the chat panel's persona banner. %>
  <%= render "workshop/ideas/reset_modal", idea: @idea, stage: @stage %>

  <%# "Request from designer" modal for the empty state: the footer button (in the
      document panel) opens it. When a request exists the designs strip renders it
      instead. Only needed on details/ready, where designs are relevant. %>
  <% if %w[details ready].include?(@stage) && @idea.design_request.nil? %>
    <%= render "workshop/ideas/request_designs_modal", idea: @idea, design_request: nil %>
  <% end %>

  <%# Brief history modal (Task 5.1) — details stage only; shares the same
      clar-modal scope, keyed "brief-history". %>
  <% if @stage == "details" %>
    <%= render "workshop/ideas/brief_history_modal", idea: @idea %>
  <% end %>
</div>
