<% designs_on = can?(:designs) && (idea.project&.designs_enabled? || current_user&.flosis_staff?) %>
<div class="px-7 py-3 border-b clar-divider bg-[var(--surface)]" data-controller="clar-rename"
     data-clar-rename-url-value="<%= workshop_idea_path(idea) %>"
     data-clar-rename-name-value="<%= idea.name %>">
  <%# All tasks on the left; where Designs is on for the project (Workshop
      Designs v2) its strip shares the row on the right, so the chat below keeps
      the height a row of its own would take. %>
  <div class="flex items-center gap-3 flex-wrap mb-2" data-task-header-top>
    <%= link_to workshop_pipeline_path, class: "inline-flex items-center gap-1.5 clar-text-muted text-[12.5px] no-underline" do %>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      All tasks
    <% end %>
    <% if designs_on %>
      <div class="flex-1"></div>
      <%= render "workshop/ideas/design_thread_strip", idea: idea %>
    <% end %>
  </div>

  <%# One row: key + title + rename on the left, stepper pinned right. The
      "local copy only" caveat lives in the pencil's tooltip rather than as
      inline text — spelled out it wrapped the row and pushed the stepper onto
      a second line, costing a lot of vertical space for a rarely-needed note. %>
  <div class="flex items-center justify-between gap-5 flex-nowrap">
    <div class="flex items-center gap-2.5 min-w-0">
      <% if idea.external_reference.present? %>
        <span class="clar-key flex-none"><%= idea.external_reference %></span>
      <% end %>

      <h1 class="clar-h1 text-[19px] truncate min-w-0" data-clar-rename-target="display"><%= idea.name %></h1>

      <input type="text" class="clar-input hidden font-bold text-[18px] min-w-[280px] py-1"
             data-clar-rename-target="input" value="<%= idea.name %>"
             data-action="keydown->clar-rename#keydown blur->clar-rename#save">

      <%
        rename_title = idea.external_type.present? ?
          "Rename — changes the local copy only, not pushed to Jira" : "Rename"
      %>
      <button type="button" title="<%= rename_title %>" aria-label="<%= rename_title %>"
              class="clar-text-faint p-0.5 rounded flex flex-none" data-clar-rename-target="pencil" data-action="clar-rename#edit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      </button>
    </div>

    <div class="flex-none flex items-center gap-3">
      <%= render "workshop/ideas/stepper", idea: idea, stage: stage %>
    </div>
  </div>

  <%# The designer's strip (status + delivered links), where Designs is off,
      shows only once a request exists. %>
  <% if !designs_on && %w[details ready].include?(stage) && idea.design_request.present? %>
    <%= render "workshop/ideas/designs_strip", idea: idea %>
  <% end %>
</div>
