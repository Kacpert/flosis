<div class="px-7 py-4 border-b clar-divider bg-[var(--surface)]" data-controller="clar-rename"
     data-clar-rename-url-value="<%= workshop_idea_path(idea) %>"
     data-clar-rename-name-value="<%= idea.name %>">
  <%= link_to workshop_pipeline_path, class: "inline-flex items-center gap-1.5 clar-text-muted text-[12.5px] mb-2.5 no-underline" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
    All tasks
  <% end %>

  <div class="flex items-center justify-between gap-5 flex-wrap">
    <div class="flex items-center gap-2.5 min-w-0">
      <% if idea.external_reference.present? %>
        <span class="clar-key"><%= idea.external_reference %></span>
      <% end %>

      <h1 class="clar-h1 text-[19px]" data-clar-rename-target="display"><%= idea.name %></h1>

      <input type="text" class="clar-input hidden font-bold text-[18px] min-w-[280px] py-1"
             data-clar-rename-target="input" value="<%= idea.name %>"
             data-action="keydown->clar-rename#keydown blur->clar-rename#save">

      <button type="button" title="Rename" class="clar-text-faint p-0.5 rounded flex" data-clar-rename-target="pencil" data-action="clar-rename#edit">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
      </button>

      <% if idea.external_type.present? %>
        <span class="clar-text-faint text-[11px]" data-clar-rename-target="hint">Renames the local copy only &mdash; not pushed to Jira</span>
      <% end %>
    </div>

    <%= render "workshop/ideas/stepper", idea: idea, stage: stage %>
  </div>

  <%# The designs strip (status + delivered links) shows in the header only once a
      request exists — in the empty state the "Request from designer" action lives
      in the document-panel footer instead of a banner on top of the panels. %>
  <% if %w[details ready].include?(stage) && idea.design_request.present? %>
    <%= render "workshop/ideas/designs_strip", idea: idea %>
  <% end %>
</div>
