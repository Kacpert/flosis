<%# After a task's designs are accepted (Kacper, 2026-11-21, mockups v2 step 3):
    what the description's new version changed, where the designs are, and
    what is left: Finish. Opens once per acceptance (IdeasController#show).
    Kacper, 2026-11-23: in plainer words, with the new description to read
    beside it (the window is wider for it), and once Finish is clicked, what it
    is doing (designs-accepting). %>
<% accepted = Designs::AcceptedScreens.new(idea) %>
<% link = Designs::Publisher.new(idea.project, nil).url(Designs::BranchNames.slug(idea), nil) %>
<% changes = Array(merge.description_changes) %>
<% draft = idea.task_drafts.by_source(TaskDraft::REFINE_SOURCE).find_by(version: merge.description_version) %>
<% jira_or_github = !finish_locally?(idea) %>
<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="designs-accepted" data-action="click->clar-modal#close">
  <div class="clar-modal <%= draft ? 'max-w-[1040px]' : 'max-w-[560px]' %> max-h-[calc(100vh-48px)] overflow-y-auto" style="padding: 22px;"
       data-action="click->clar-modal#stopPropagation" data-controller="designs-accepting">
    <div class="flex items-center justify-between gap-3 mb-4">
      <div class="flex items-center gap-2.5">
        <span class="w-8 h-8 rounded-full flex items-center justify-center flex-none" style="background: var(--success-soft); color: var(--success);">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
        </span>
        <h2 class="m-0 text-[18px] font-bold clar-text-text">Designs accepted</h2>
      </div>
      <button type="button" class="clar-text-faint flex p-1" data-action="clar-modal#close" aria-label="Close" data-designs-accepting-target="confirm">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <%# Once Finish is clicked: what it is doing, until Ready opens. %>
    <div class="hidden" data-designs-accepting-target="progress">
      <div class="rounded-[12px] border border-[color:var(--border)] bg-[var(--surface-2)] px-3.5 py-3 flex flex-col gap-2">
        <div class="text-[12px] font-bold clar-text-text">Finishing</div>
        <div class="flex items-center gap-2.5 text-[12.5px] clar-text-text">
          <span class="w-[18px] h-[18px] flex items-center justify-center flex-none clar-text-ai"><svg class="animate-spin" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.2-8.6"/></svg></span>
          <span><%= finish_doing(idea) %>…</span>
        </div>
        <div class="text-[11.5px] clar-text-muted leading-[1.5] pt-0.5">It takes a few seconds. Ready opens when it's done.</div>
      </div>
    </div>

    <div data-designs-accepting-target="confirm">
      <div class="grid gap-5 <%= 'md:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)]' if draft %>">
        <div class="flex flex-col gap-4 min-w-0">
          <div>
            <div class="text-[13.5px] font-semibold clar-text-text">The task description is now v<%= merge.description_version %></div>
            <div class="text-[12.5px] clar-text-muted leading-[1.55] mt-0.5">
              It links to the designs and lists the <%= pluralize(accepted.own.size, "screen") %> that changed.
              <% if merge.described_fallback %>
                The AI couldn't compare the rest of the text with the designs this time, so read it before you finish.
              <% elsif changes.any? %>
                The AI also changed it to match the designs:
              <% else %>
                The rest already matched the designs.
              <% end %>
            </div>
            <% if !merge.described_fallback && changes.any? %>
              <ul class="m-0 mt-1 pl-4 text-[12.5px] clar-text-text leading-[1.6] list-disc">
                <% changes.each do |change| %><li><%= change %></li><% end %>
              </ul>
            <% end %>
          </div>
          <div>
            <div class="text-[13.5px] font-semibold clar-text-text">Link to the designs</div>
            <div class="text-[12.5px] leading-[1.55] mt-0.5">
              <a href="<%= link %>" target="_blank" rel="noopener noreferrer" class="clar-mono text-[11.5px] clar-text-primary underline"><%= link.sub(%r{\Ahttps?://}, "") %></a>
              <div class="clar-text-muted">Opens the accepted designs. Anyone on the project can open it after signing in.</div>
            </div>
          </div>
          <div class="rounded-[10px] px-3.5 py-3 bg-[var(--primary-soft)]">
            <div class="text-[13px] font-semibold clar-text-text"><%= jira_or_github ? "Next: hand it to a developer" : "Next" %></div>
            <div class="text-[12.5px] clar-text-muted leading-[1.55] mt-0.5"><%= finish_whats_left(idea) %></div>
            <% if (target = finish_target(idea)) %>
              <div class="clar-mono text-[11.5px] clar-text-text mt-1.5 break-all"><%= target %></div>
            <% end %>
          </div>
        </div>
        <% if draft %>
          <%# The new description, as the Description panel shows it. %>
          <div class="min-w-0 flex flex-col">
            <div class="text-[13.5px] font-semibold clar-text-text mb-1.5">The new description · v<%= draft.version %></div>
            <div class="rounded-[10px] border border-[color:var(--border)] bg-[var(--surface)] px-4 py-3 overflow-y-auto max-h-[min(60vh,560px)]">
              <% if draft.content.to_s.lstrip.start_with?("<") %>
                <div class="clar-prose text-[13px]" data-description-preview><%= sanitize(draft.content, tags: %w[h1 h2 h3 h4 h5 h6 p b strong i em u s ul ol li pre code a br hr blockquote table thead tbody tr th td], attributes: %w[href]) %></div>
              <% else %>
                <div class="clar-prose text-[13px]" data-description-preview data-controller="clar-markdown"><%= draft.content %></div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="flex gap-2 justify-end flex-wrap mt-5">
        <button type="button" class="clar-btn" data-action="clar-modal#close">Not now</button>
        <%= button_to(finish_locally?(idea) ? save_locally_workshop_idea_path(idea, stage: "details") : finish_workshop_idea_path(idea),
                      method: :post, class: "clar-btn clar-btn-primary",
                      form: { class: "contents", data: { turbo_frame: "_top", action: "submit->designs-accepting#start" } }) do %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          <%= finish_label(idea) %>
        <% end %>
      </div>
    </div>
  </div>
</div>
