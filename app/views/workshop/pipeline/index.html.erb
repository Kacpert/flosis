<% content_for :title, "Create Tasks · Clar" %>

<h1 class="clar-h1">Create Tasks</h1>
<p class="clar-sub">Turn rough ideas and unclear tickets into implementation-ready Jira tasks. The AI reads the repo first, then helps you shape them.</p>

<%# Both entry cards + both modal panels share one clar-modal controller
    scope: the "New idea" trigger has no id param and opens the first
    (untagged) panel; "Existing Jira task" passes id param "jira-picker"
    and opens the panel tagged data-clar-modal-panel-id-value="jira-picker". %>
<div class="grid grid-cols-2 gap-3.5 mb-7" data-controller="clar-modal">
  <button type="button" class="clar-card clar-card-hover text-left flex flex-col gap-2 p-4.5 w-full"
          data-action="clar-modal#open">
    <span class="w-8.5 h-8.5 rounded-lg flex items-center justify-center clar-badge-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
    </span>
    <span class="font-semibold text-[14.5px] clar-text-text">New idea</span>
    <span class="text-[12.5px] leading-snug clar-text-muted">Name it first so it&rsquo;s saved &mdash; then talk it through anytime. Stays local until you push it to Jira.</span>
  </button>

  <button type="button" class="clar-card clar-card-hover text-left flex flex-col gap-2 p-4.5"
          data-action="clar-modal#open" data-clar-modal-id-param="jira-picker">
    <span class="w-8.5 h-8.5 rounded-lg flex items-center justify-center clar-badge-primary">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M3 9h18M9 21V9"/></svg>
    </span>
    <span class="font-semibold text-[14.5px] clar-text-text">Existing Jira task</span>
    <span class="text-[12.5px] leading-snug clar-text-muted">Browse your Jira boards &mdash; design, development, backlog &mdash; and pull a ticket in to refine.</span>
  </button>

  <%= render "workshop/pipeline/new_idea_modal" %>
  <%= render "workshop/pipeline/jira_browser_modal" %>
</div>

<div class="flex items-center justify-between gap-4 mb-3.5 flex-wrap">
  <h2 class="clar-section-label">IN THE PIPELINE</h2>

  <%= form_with url: workshop_pipeline_path, method: :get, data: { controller: "clar-pipeline-filter" }, class: "flex items-center gap-2 flex-wrap" do |f| %>
    <%# Preserve the active stage/source chip filters across sort/search changes. %>
    <% %i[stage source].each do |kept| %>
      <%= hidden_field_tag kept, params[kept], id: nil if params[kept].present? %>
    <% end %>
    <div class="relative flex items-center">
      <span class="absolute left-2.5 clar-text-faint pointer-events-none flex">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      </span>
      <%= f.text_field :q, value: params[:q], placeholder: "Search tickets…", class: "clar-input pl-[30px] py-2 w-[200px]",
            data: { clar_pipeline_filter_target: "search", action: "input->clar-pipeline-filter#debouncedSubmit" } %>
    </div>
    <%= f.select :sort, [
          ["Newest first", "newest"],
          ["Oldest first", "oldest"],
          ["Pipeline stage", "stage"],
          ["Title A–Z", "title"],
        ], { selected: params[:sort] }, class: "clar-select", data: { action: "change->clar-pipeline-filter#submit" } %>
  <% end %>
</div>

<div class="flex items-center gap-1.5 mb-3.5 flex-wrap">
  <% [["all", "All"], ["new", "New"], ["briefing", "Briefing"], ["details", "Details"], ["ready", "Ready"]].each do |value, label| %>
    <% active = params[:stage].presence == value || (value == "all" && params[:stage].blank?) %>
    <% count = value == "all" ? @counts.values.sum : @counts.fetch(value, 0) %>
    <%= link_to request.query_parameters.except(:stage).merge(value == "all" ? {} : { stage: value }),
          class: "clar-chip #{active ? 'clar-chip-active' : ''}" do %>
      <%= label %><span class="ml-1.5 opacity-70 font-bold"><%= count %></span>
    <% end %>
  <% end %>

  <span class="w-px h-5 clar-divider mx-1"></span>

  <% [["all", "All sources"], ["jira", "In Jira"], ["local", "Local ideas"]].each do |value, label| %>
    <% active = params[:source].presence == value || (value == "all" && params[:source].blank?) %>
    <% count = @source_counts.fetch(value.to_sym, 0) %>
    <%= link_to request.query_parameters.except(:source).merge(value == "all" ? {} : { source: value }),
          class: "clar-chip #{active ? 'clar-chip-dark-active' : ''}" do %>
      <%= label %><span class="ml-1 opacity-70 font-bold"><%= count %></span>
    <% end %>
  <% end %>
</div>

<div class="flex flex-col gap-2.5">
  <% if @ideas.empty? %>
    <div data-empty class="text-center clar-text-faint text-[13px] p-8.5 clar-dashed rounded-xl">
      No tickets match your search or filter.
    </div>
  <% else %>
    <%= render partial: "workshop/pipeline/idea_row", collection: @ideas, as: :idea %>
  <% end %>
</div>
