<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-action="click->clar-modal#close">
  <div class="clar-modal p-5.5" style="max-width: 480px" data-action="click->clar-modal#stopPropagation">
    <div class="flex items-center justify-between mb-1">
      <h2 class="text-lg font-bold clar-text-text m-0">New idea</h2>
      <button type="button" class="clar-text-faint flex p-1" data-action="clar-modal#close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <p class="text-[13px] leading-normal clar-text-muted mb-4.5">Give it a title so it&rsquo;s saved to the pipeline &mdash; you can come back to the conversation anytime.</p>

    <%= form_with url: workshop_ideas_path, method: :post, class: "space-y-0", data: { controller: "clar-required", turbo: false } do |f| %>
      <label class="clar-field-label">TITLE <span class="clar-text-danger">*</span></label>
      <%= f.text_field "idea[title]", value: nil, autofocus: true, placeholder: "e.g. Aggregated CSV export for analysts",
            class: "clar-input mb-4", data: { clar_required_target: "input", action: "input->clar-required#toggle" } %>

      <label class="clar-field-label">DESCRIPTION <span class="font-medium">(optional)</span></label>
      <%= f.text_area "idea[description]", value: nil, rows: 3, placeholder: "A sentence or two on what you're thinking…",
            class: "clar-textarea mb-5" %>

      <div class="flex gap-2.5 justify-end">
        <button type="button" class="clar-btn" data-action="clar-modal#close">Cancel</button>
        <%= f.submit "Save & start briefing", class: "clar-btn clar-btn-primary", disabled: true,
              data: { clar_required_target: "submit" } %>
      </div>
    <% end %>
  </div>
</div>
