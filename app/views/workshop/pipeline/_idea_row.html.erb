<%
  stage_badge = {
    "new"      => ["clar-badge-muted",   "New idea"],
    "briefing" => ["clar-badge-primary", "Briefing"],
    "details"  => ["clar-badge-ai",      "Details Gathering"],
    "ready"    => ["clar-badge-success", idea.external_type.present? ? "Ready · in Jira" : "Ready · local"],
  }.fetch(idea.workshop_stage, ["clar-badge-muted", idea.workshop_stage.to_s.humanize])
%>
<%# Flex row: the task link (flex-1) + a hover-revealed delete button as a
    sibling. Delete can't live inside the <a> (nested form is invalid HTML), so
    it sits beside it — flex keeps it reliably right-aligned (no fragile absolute
    positioning). The link keeps its own chevron; delete appears to its right on
    row hover. %>
<div class="group flex items-stretch clar-row clar-row-hover">
<%= link_to workshop_idea_path(idea), class: "flex-1 min-w-0 flex items-center gap-4 p-4 no-underline" do %>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2.5">
      <% if idea.external_type.present? %>
        <span class="clar-key"><%= idea.external_reference %></span>
      <% else %>
        <span class="clar-badge clar-badge-muted">LOCAL</span>
      <% end %>
      <span class="font-semibold text-[14px] clar-text-text"><%= idea.name %></span>
    </div>
    <div class="text-[12px] clar-text-faint mt-1">
      <%= idea.pipeline_author&.name || "Unknown" %> · Created <%= clar_time_ago(idea.pipeline_entered_at) %>
    </div>
  </div>

  <% if idea.design_request&.requested? %>
    <span class="clar-badge clar-badge-warn whitespace-nowrap">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      Designs requested
    </span>
  <% elsif idea.design_request&.delivered? %>
    <span class="clar-badge clar-badge-success whitespace-nowrap">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
      Designs ready
    </span>
  <% end %>

  <span class="clar-badge <%= stage_badge[0] %> whitespace-nowrap"><%= stage_badge[1] %></span>

  <span class="clar-text-faint flex">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
  </span>
<% end %>

<%# Delete button — flex sibling of the link, revealed on row hover. For a Jira
    task the confirm makes clear the Jira ticket is NOT deleted (only removed from
    Create Tasks); a local idea is deleted outright. %>
<% jira = idea.external_reference.present? %>
<% confirm = jira ?
     "Remove #{idea.external_reference} from Create Tasks?\n\nThis does NOT delete the Jira ticket — it stays in Jira#{idea.external_url.present? ? " (#{idea.external_url})" : ''}. Delete it there yourself if you want it gone." :
     "Delete \"#{idea.name}\"? This can't be undone." %>
<div class="flex items-center pr-4 opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
  <%= button_to workshop_idea_path(idea), method: :delete,
        form: { class: "flex" },
        data: { turbo_confirm: confirm },
        class: "flex items-center justify-center w-8 h-8 rounded-lg border border-[color:var(--danger)] text-[color:var(--danger)] bg-[var(--surface)] hover:bg-[color:var(--danger-soft)]",
        title: jira ? "Remove from Create Tasks (keeps the Jira ticket)" : "Delete this idea" do %>
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 5v6m4-6v6"/></svg>
  <% end %>
</div>
</div>
