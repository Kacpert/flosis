<%
  stage_badge = {
    "new"      => ["clar-badge-muted",   "New idea"],
    "briefing" => ["clar-badge-primary", "Briefing"],
    "details"  => ["clar-badge-ai",      "Details Gathering"],
    "ready"    => ["clar-badge-success", idea.external_type.present? ? "Ready · in Jira" : "Ready · local"],
  }.fetch(idea.workshop_stage, ["clar-badge-muted", idea.workshop_stage.to_s.humanize])
%>
<%# Flex row: the task link (flex-1) + a hover-revealed delete button as a
    sibling. Delete can't live inside the <a> (nested form is invalid HTML), so
    it sits beside it — flex keeps it reliably right-aligned (no fragile absolute
    positioning). The link keeps its own chevron; delete appears to its right on
    row hover. %>
<%# Row padding sits here (15px 16px per the design); the link inside carries no
    padding of its own so the delete button and chevron align with it. %>
<div class="group flex items-center gap-3 py-[15px] px-4 clar-row clar-row-hover" data-controller="clar-modal">
<%= link_to workshop_idea_path(idea), class: "flex-1 min-w-0 flex items-center gap-4 p-0 no-underline" do %>
  <div class="flex-1 min-w-0">
    <div class="flex items-center gap-2.5">
      <% if idea.external_type.present? %>
        <span class="clar-key"><%= idea.external_reference %></span>
      <% else %>
        <%# Smaller and tighter than .clar-badge — the design draws LOCAL at
            10px/700 with .3px tracking in a 5px-radius outline. %>
        <span class="inline-flex items-center text-[10px] font-bold tracking-[.3px] clar-text-muted bg-[color:var(--surface-2)] border clar-divider px-1.5 py-px rounded-[5px]">LOCAL</span>
      <% end %>
      <span class="font-semibold text-[14px] clar-text-text"><%= idea.name %></span>
    </div>
    <div class="text-[12px] clar-text-faint mt-1">
      <%= idea.pipeline_author&.name || "Unknown" %> · Created <%= clar_time_ago(idea.pipeline_entered_at) %>
    </div>
  </div>

  <% if idea.design_request&.requested? %>
    <span class="clar-badge clar-badge-warn whitespace-nowrap">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
      Designs requested
    </span>
  <% elsif idea.design_request&.delivered? %>
    <span class="clar-badge clar-badge-success whitespace-nowrap">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
      Designs ready
    </span>
  <% end %>

  <%# The stage badge is a touch wider than the shared badge (4px 11px). %>
  <span class="clar-badge <%= stage_badge[0] %> !px-[11px] whitespace-nowrap"><%= stage_badge[1] %></span>
<% end %>

<%# Delete button — flex sibling of the link, revealed on row hover. It opens
    the confirm modal below rather than a browser dialog. %>
<% jira = idea.external_reference.present? %>
<div class="flex items-center flex-none opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity">
  <button type="button" data-action="click->clar-modal#open"
          class="flex items-center justify-center w-[30px] h-[30px] rounded-[8px] border clar-divider clar-text-faint bg-[color:var(--surface)] cursor-pointer hover:text-[color:var(--danger)] hover:border-[color:var(--danger)]"
          title="<%= jira ? "Remove from Create Tasks (keeps the Jira ticket)" : "Delete this task" %>">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
  </button>
</div>

<%# Always-visible chevron, to the right of the hover-revealed delete button. %>
<span class="clar-text-faint flex flex-none">
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
</span>

<%# Confirm modal. For a Jira-linked task the second line makes clear the Jira
    issue itself is untouched — we only take it out of Create Tasks. %>
<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-action="click->clar-modal#close">
  <div class="clar-modal max-w-[420px] p-5.5" data-action="click->clar-modal#stopPropagation">
    <div class="flex items-center gap-3 mb-3">
      <span class="w-9 h-9 rounded-[9px] flex items-center justify-center flex-none clar-badge-danger">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
      </span>
      <h2 class="m-0 text-[17px] font-bold clar-text-text"><%= jira ? "Remove task?" : "Delete task?" %></h2>
    </div>
    <p class="m-0 mb-2 text-[13px] leading-normal clar-text-muted">
      &ldquo;<b class="clar-text-text"><%= idea.name %></b>&rdquo; and its saved brief/description versions will be removed from Flosis.
    </p>
    <p class="m-0 mb-5 text-[12px] leading-normal clar-text-faint">
      <% if jira %>
        The Jira issue <%= idea.external_reference %> is not affected.
      <% else %>
        This local idea has not been pushed to Jira.
      <% end %>
    </p>
    <div class="flex gap-2.5 justify-end">
      <button type="button" class="clar-btn" data-action="clar-modal#close">Cancel</button>
      <%= button_to (jira ? "Remove task" : "Delete task"), workshop_idea_path(idea), method: :delete,
            form: { class: "flex" },
            class: "clar-btn !bg-[color:var(--danger)] !text-white !border-transparent font-[650]" %>
    </div>
  </div>
</div>
</div>
