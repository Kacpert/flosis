<%= form_with model: entry, url: entry.new_record? ? workshop_library_entries_path : workshop_library_entry_path(entry),
      class: "flex flex-col gap-4" do |f| %>
  <% if entry.errors.any? %>
    <div class="clar-card p-3 clar-text-danger text-[13px]"><%= entry.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="grid gap-4 grid-cols-1 md:grid-cols-2">
    <div>
      <label class="clar-field-label">NAME</label>
      <%= f.text_field :name, class: "clar-input w-full" %>
    </div>
    <div>
      <label class="clar-field-label">KEY</label>
      <% if entry.new_record? %>
        <%= f.text_field :key, class: "clar-input clar-mono w-full", placeholder: "lowercase-words-and-dashes" %>
      <% else %>
        <div class="clar-input clar-mono bg-[var(--surface-2)]"><%= entry.key %></div>
      <% end %>
    </div>
  </div>

  <% if entry.new_record? %>
    <div>
      <label class="clar-field-label">KIND</label>
      <%= f.select :kind, LibraryEntry::KINDS.map { |kind| [ Workshop::LibraryEntriesController::HEADINGS.fetch(kind), kind ] },
                   {}, class: "clar-select" %>
    </div>
  <% end %>

  <div>
    <label class="clar-field-label">DESCRIPTION</label>
    <%= f.text_area :description, rows: 2, class: "clar-textarea w-full",
                    placeholder: "What it is for. A style pack's name and description are what projects see." %>
  </div>

  <% unless entry.kind == "base_prompt" %>
    <label class="flex items-center gap-2 text-[13px] clar-text-text">
      <%= f.check_box :active %> Active — used by every design turn<% if entry.kind == "style_pack" %> of the projects that chose it<% end %>
    </label>
  <% end %>

  <div>
    <label class="clar-field-label">TEXT</label>
    <%= text_area_tag "library_entry[body]", body, rows: 28, class: "clar-textarea clar-mono w-full !text-[12.5px] !leading-[1.6]" %>
    <div class="text-[11px] clar-text-faint mt-1.5">Saving changed text makes a new version. The old ones stay, and can be restored.</div>
  </div>

  <div class="flex gap-2">
    <%= f.submit entry.new_record? ? "Add to the library" : "Save", class: "clar-btn clar-btn-primary" %>
    <%= link_to "Cancel", entry.new_record? ? workshop_library_entries_path : workshop_library_entry_path(entry), class: "clar-btn no-underline" %>
  </div>
<% end %>
