<% content_for :title, "#{@entry.name} · Library · Flosis" %>

<%= link_to "‹ Library", workshop_library_entries_path, class: "clar-text-muted text-[12.5px] no-underline" %>
<div class="flex items-start justify-between gap-4 mt-2 mb-5">
  <div>
    <h1 class="clar-h1"><%= @entry.name %></h1>
    <div class="text-[12.5px] clar-text-muted mt-1">
      <%= Workshop::LibraryEntriesController::HEADINGS.fetch(@entry.kind) %> · <span class="clar-mono"><%= @entry.key %></span> ·
      <%= @entry.kind == "base_prompt" ? "always used" : (@entry.active? ? "active" : "off") %>
    </div>
    <% if @entry.description.present? %><p class="text-[13px] clar-text-text mt-2"><%= @entry.description %></p><% end %>
  </div>
  <%= link_to "Edit", edit_workshop_library_entry_path(@entry), class: "clar-btn no-underline" %>
</div>

<h2 class="clar-section-label mb-2.5">Versions</h2>
<div class="flex flex-col gap-3">
  <% @versions.each_with_index do |version, index| %>
    <div class="clar-card p-4" data-version="<%= version.number %>">
      <div class="flex items-center gap-3 mb-2.5">
        <span class="font-semibold text-[13.5px] clar-text-text">Version <%= version.number %></span>
        <% if index.zero? %><span class="clar-badge clar-badge-primary">current</span><% end %>
        <span class="text-[12px] clar-text-muted flex-1">
          <%= l(version.created_at, format: :short) %><% if version.created_by %> · <%= version.created_by.name %><% end %>
        </span>
        <% unless index.zero? %>
          <%= button_to "Restore", restore_workshop_library_entry_path(@entry), params: { version_id: version.id },
                        class: "clar-btn py-1 px-3 text-[12px]" %>
        <% end %>
      </div>
      <pre class="clar-mono text-[12px] leading-[1.6] whitespace-pre-wrap clar-text-text max-h-80 overflow-y-auto"><%= version.body %></pre>
    </div>
  <% end %>
</div>
