<% content_for :title, @import_mode ? "New import · Flosis" : "Designs setup · Flosis" %>
<%# The Designs setup form (Workshop Designs v2), as Kacper's design draws it:
    technology, repositories, the test environment and contexts. New import
    opens it too (@import_mode, Kacper 2026-11-22), with the stack and the
    designs repository kept as they are and only the app's repositories and
    the contexts to check. %>
<% project = @project %>
<% roles = project.design_setup_roles.to_a %>
<% repos = Array(project.design_app_repos).select { |row| row.is_a?(Hash) }.presence || [ { "role" => "Frontend", "repo" => project.github_repo.to_s }, { "role" => "Backend", "repo" => "" } ] %>
<% chip = "inline-flex items-center gap-1.5 text-[13px] font-semibold px-3.5 py-2 rounded-[9px] border border-[color:var(--border)] bg-[var(--surface)] clar-text-text cursor-pointer has-[:checked]:border-[color:var(--primary)] has-[:checked]:bg-[var(--primary-soft)] has-[:checked]:text-[var(--primary)]" %>
<% soon = "inline-flex items-center gap-1.5 text-[13px] font-semibold px-3.5 py-2 rounded-[9px] border border-[color:var(--border)] bg-[var(--surface)] clar-text-faint opacity-60 cursor-not-allowed" %>
<div class="max-w-[960px] mx-auto">
  <% if @import_mode %>
    <%= link_to workshop_designs_overview_path(tab: "imports"), class: "inline-flex items-center gap-1.5 clar-text-muted text-[12.5px] no-underline mb-3" do %><%= designs_icon(:back, 15) %>All imports<% end %>
  <% elsif @editing %>
    <%= link_to workshop_designs_overview_path, class: "inline-flex items-center gap-1.5 clar-text-muted text-[12.5px] no-underline mb-3" do %><%= designs_icon(:back, 15) %>Designs<% end %>
  <% end %>
  <h1 class="m-0 text-[23px] font-bold tracking-[-.5px] clar-text-text"><%= @import_mode ? "New import" : @editing ? "Edit Designs setup" : "Set up Designs for #{project.name}" %></h1>
  <% if @import_mode %>
    <p class="mt-1.5 mb-5.5 clar-text-muted text-[14px] leading-[1.55] max-w-[740px]">What developers built since <%= @since&.created_at&.in_time_zone&.strftime("%b %-d") || "the last import" %>: the AI reads the app’s code and its history from there, then updates the designs. Check the app repositories and the contexts first. It runs in the background.</p>
  <% else %>
    <p class="mt-1.5 mb-5.5 clar-text-muted text-[14px] leading-[1.55] max-w-[740px]">The AI reads your repositories, signs in to your test environment as each context, maps the app’s features and builds them one by one: the design system, the components and every screen, in the designs repository. It runs in the background and takes several hours. After that, every change happens in threads.</p>
  <% end %>

  <%= form_with url: @import_mode ? workshop_design_imports_path : workshop_design_setup_run_path, method: (@editing && !@import_mode ? :patch : :post), data: { controller: "designs-setup-form", action: "input->designs-setup-form#check" } do %>
    <% if @import_mode %>
      <%= hidden_field_tag :framework, project.designs_framework %>
      <%= hidden_field_tag :ui, project.designs_ui_system %>
      <%= hidden_field_tag :ui_version, project.designs_ui_version %>
      <%= hidden_field_tag :repo, project.design_repo.present? ? "github.com/#{project.design_repo}" : "" %>
    <% end %>
    <div class="clar-card p-5 mb-3.5 <%= 'hidden' if @import_mode %>">
      <div class="flex gap-3 mb-4"><span class="w-6 h-6 rounded-full bg-[var(--primary-soft)] clar-text-primary text-[12px] font-bold flex items-center justify-center flex-none">1</span><div><div class="font-bold text-[14.5px] clar-text-text">Technology</div><div class="text-[12.5px] clar-text-muted mt-0.5 leading-[1.45]">What the designs are built with. Components are generated in this stack and version.</div></div></div>
      <% unless @import_mode %>
      <label class="clar-field-label">FRAMEWORK</label>
      <div class="flex gap-2 flex-wrap items-center mb-4">
        <% Workshop::DesignSetupRunsController::FRAMEWORKS.each do |key, label, _| %>
          <% if Workshop::DesignSetupRunsController::SUPPORTED.include?(key) %>
            <label class="<%= chip %>"><input type="radio" name="framework" value="<%= key %>" class="sr-only" <%= "checked" if project.designs_framework == key %>><%= label %></label>
          <% else %>
            <span class="<%= soon %>" title="Soon"><%= label %><span class="text-[10px] font-bold tracking-[.3px]">SOON</span></span>
          <% end %>
        <% end %>
      </div>
      <label class="clar-field-label">UI SYSTEM</label>
      <div class="flex gap-2 flex-wrap items-center">
        <% Workshop::DesignSetupRunsController::UI_SYSTEMS.each do |key, label, _| %>
          <% if Workshop::DesignSetupRunsController::SUPPORTED.include?(key) %>
            <label class="<%= chip %>"><input type="radio" name="ui" value="<%= key %>" class="sr-only" <%= "checked" if project.designs_ui_system == key %>><%= label %></label>
          <% else %>
            <span class="<%= soon %>" title="Soon"><%= label %><span class="text-[10px] font-bold tracking-[.3px]">SOON</span></span>
          <% end %>
        <% end %>
        <span class="text-[11.5px] font-bold clar-text-faint ml-1">VERSION</span>
        <input name="ui_version" value="<%= project.designs_ui_version %>" placeholder="e.g. 4" class="clar-input !w-[90px]">
      </div>
      <div class="text-[11.5px] clar-text-faint mt-1.5 leading-[1.45]">The AI checks these against package.json and the lockfile and flags a mismatch.</div>
      <% end %>
    </div>

    <div class="clar-card p-5 mb-3.5">
      <div class="flex gap-3 mb-4"><span class="w-6 h-6 rounded-full bg-[var(--primary-soft)] clar-text-primary text-[12px] font-bold flex items-center justify-center flex-none"><%= @import_mode ? 1 : 2 %></span><div><div class="font-bold text-[14.5px] clar-text-text">Repositories</div><div class="text-[12.5px] clar-text-muted mt-0.5 leading-[1.45]"><%= @import_mode ? "The product code the designs follow. The designs go to #{project.design_repo}." : "Where the designs are stored, and the product code they are based on." %></div></div></div>
      <% unless @import_mode %>
        <label class="clar-field-label">DESIGNS REPOSITORY (TARGET)</label>
        <input name="repo" value="<%= project.design_repo.present? ? "github.com/#{project.design_repo}" : "" %>" placeholder="github.com/acme/app-designs" class="clar-input">
        <div class="text-[11.5px] clar-text-faint mt-1.5 leading-[1.45]">The AI commits here. master holds approved designs; each thread is a branch.</div>
        <input type="password" name="repo_token" autocomplete="new-password" placeholder="<%= project.design_repo_token.present? ? 'Token saved — leave blank to keep it' : 'Token with write access to this repository only' %>" class="clar-input mt-2.5">
      <% end %>
      <label class="clar-field-label <%= 'mt-4' unless @import_mode %>">CURRENT APP REPOSITORIES · READ-ONLY</label>
      <div class="grid gap-2 items-center" style="grid-template-columns: minmax(0, .55fr) minmax(0, 1.6fr) 34px;" data-designs-setup-form-target="repos">
        <% repos.each_with_index do |row, i| %>
          <%= render "workshop/design_setup_runs/repo_row", index: i, row: row %>
        <% end %>
      </div>
      <button type="button" class="clar-btn mt-2.5" data-action="designs-setup-form#addRepo"><%= designs_icon(:plus, 14) %>Add repository</button>
      <div class="text-[11.5px] clar-text-faint mt-1.5 leading-[1.45]">Frontend, backend, shared UI library… The AI uses them to match real components, copy, routes and data. Name a branch with @, as in owner/app@production.</div>
      <template data-designs-setup-form-target="repoTemplate"><%= render "workshop/design_setup_runs/repo_row", index: "NEW_INDEX", row: { "role" => "", "repo" => "" } %></template>
    </div>

    <div class="clar-card p-5 mb-3.5">
      <div class="flex gap-3 mb-4"><span class="w-6 h-6 rounded-full bg-[var(--primary-soft)] clar-text-primary text-[12px] font-bold flex items-center justify-center flex-none"><%= @import_mode ? 2 : 3 %></span><div><div class="font-bold text-[14.5px] clar-text-text">Test environment and contexts</div><div class="text-[12.5px] clar-text-muted mt-0.5 leading-[1.45]">The AI signs in as each context and uses the app on test data: it may create, change and delete what it needs. Use a test environment (staging, or a test workspace on production) and a test account per context. Each context can have its own login page.</div></div></div>
      <div class="grid gap-2 items-center" style="grid-template-columns: minmax(0, .7fr) minmax(0, 1.5fr) minmax(0, 1.1fr) minmax(0, .8fr) 34px;" data-designs-setup-form-target="contexts">
        <span class="clar-field-label !m-0">CONTEXT</span><span class="clar-field-label !m-0">LOGIN URL</span><span class="clar-field-label !m-0">LOGIN</span><span class="clar-field-label !m-0">PASSWORD</span><span></span>
        <% (roles.presence || [ nil, nil, nil ]).each_with_index do |role, i| %>
          <%= render "workshop/design_setup_runs/context_row", index: i, role: role %>
        <% end %>
      </div>
      <button type="button" class="clar-btn mt-3" data-action="designs-setup-form#addContext"><%= designs_icon(:plus, 14) %>Add context</button>
      <template data-designs-setup-form-target="contextTemplate"><%= render "workshop/design_setup_runs/context_row", index: "NEW_INDEX", role: nil %></template>
    </div>

    <div class="flex items-center justify-end gap-3.5 flex-wrap mt-1.5">
      <span class="text-[12.5px] clar-text-faint" data-designs-setup-form-target="hint"
            data-ready="<%= @import_mode ? 'In the background. You can keep working.' : 'Several hours, in the background. You can keep working.' %>"
            data-incomplete="<%= Workshop::DesignSetupRunsController::INCOMPLETE %>"><%= @import_mode ? "In the background. You can keep working." : "Several hours, in the background. You can keep working." %></span>
      <button type="submit" class="clar-btn clar-btn-primary !py-2.5 !px-4 !text-[13px]"><%= designs_icon(:ai, 14) %><%= @import_mode ? "Start import" : @editing ? "Save and re-import" : "Build designs" %></button>
    </div>
  <% end %>
</div>
