<div class="max-w-6xl mx-auto"
     data-controller="task-chat"
     data-task-chat-create-url-value="<%= jira_task_brief_chat_session_path(@task) %>"
     data-task-chat-message-url-value="<%= message_jira_task_brief_chat_session_path(@task) %>"
     data-task-chat-task-id-value="<%= @task.id %>"
     data-task-chat-current-user-name-value="<%= current_user.name %>"
     data-task-chat-has-session-value="<%= ChatSession.find_active_for(@task, current_user, purpose: 'brief').present? %>">

  <div class="flex gap-4 items-start">
    <div class="flex-1 min-w-0 space-y-6" data-task-chat-target="taskContent">
      <div>
        <%= link_to "← Back to Workshop", workshop_path, class: "text-sm", style: "color: var(--color-primary)" %>
        <h1 class="text-2xl font-bold mt-1" style="color: var(--color-on-surface)">
          Brief — <%= @task.external_reference.presence || "New idea" %>: <%= @task.name %>
        </h1>
      </div>

      <div>
        <button type="button" class="m3-btn m3-btn-filled" data-action="click->task-chat#openChat">
          Talk to the AI Product Owner
        </button>
      </div>

      <div class="m3-card-elevated p-6 space-y-4">
        <h2 class="text-lg font-semibold" style="color: var(--color-on-surface)">Brief versions</h2>
        <% if @briefs.any? %>
          <% @briefs.each do |b| %>
            <article class="space-y-2 pb-4" style="border-bottom: 1px solid var(--color-outline-variant)">
              <header class="flex items-center gap-2">
                <strong style="color: var(--color-on-surface)">v<%= b.version %></strong>
                <span class="text-xs px-2 py-0.5 rounded-full"
                      style="background: var(--color-surface-container); color: var(--color-on-surface-variant)"><%= b.status %></span>
                <% if b.briefed_at %>
                  <span class="text-xs" style="color: var(--color-outline)">briefed <%= b.briefed_at.strftime("%Y-%m-%d %H:%M") %></span>
                <% end %>
              </header>
              <pre class="whitespace-pre-wrap text-sm" style="color: var(--color-on-surface)"><%= b.content %></pre>
              <% if b.status == "draft" %>
                <%= button_to "Brief & mark Briefed", commit_jira_task_brief_path(@task, b),
                      class: "m3-btn m3-btn-filled",
                      data: { turbo_confirm: "Write this brief to Jira and mark it Briefed?" } %>
              <% end %>
            </article>
          <% end %>
        <% else %>
          <p class="text-sm" style="color: var(--color-on-surface-variant)">
            No brief yet — talk it through with the AI Product Owner.
          </p>
        <% end %>
      </div>
    </div>

    <%= render "jira_tasks/chat_panel", task: @task %>
  </div>
</div>
