<%# One chat message, drawn by its kind: the person's on the right; Claude's
    summary plain, a new context and a missing requirement marked, an error
    in red, and Flosis's own notes muted. %>
<% if message.role == "user" %>
  <div class="clar-bubble-user self-end whitespace-pre-line"><%= message.content %></div>
<% elsif message.kind == "system" %>
  <p class="clar-text-muted text-[12.5px] whitespace-pre-line"><%= message.content %></p>
<% else %>
  <%
    border, label = case message.kind
                    when "context" then [ "border-[var(--primary)]", "New context" ]
                    when "missing" then [ "border-[var(--warn)]", "Missing requirement" ]
                    when "error" then [ "border-[var(--danger)]", nil ]
                    else [ nil, nil ]
                    end
  %>
  <div class="clar-bubble-ai <%= border %>">
    <% if label %><div class="clar-text-muted text-[11.5px] font-semibold mb-1"><%= label %></div><% end %>
    <div class="whitespace-pre-line"><%= message.content %></div>
    <% if offer_retry %>
      <%= button_to "Retry", retry_workshop_idea_designs_path(@idea), class: "clar-btn mt-2 py-1 px-3 text-[12px]" %>
    <% end %>
  </div>
<% end %>
