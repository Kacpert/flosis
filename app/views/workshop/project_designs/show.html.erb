<% content_for :title, "Designs · Flosis" %>

<div class="flex items-start justify-between gap-4 mb-6">
  <div>
    <h1 class="clar-h1">Designs</h1>
    <p class="clar-text-muted text-[13px] mt-1">Clickable designs of <%= @project&.name || "this project" %>: the whole design, and the conversation of each task.</p>
  </div>
  <% if @master_link %>
    <%= link_to "Open in new tab ↗", @master_link, target: "_blank", rel: "noopener noreferrer", class: "clar-btn no-underline" %>
  <% end %>
</div>

<% if @project&.designs_ready? %>
  <section class="mb-7">
    <h2 class="clar-section-label mb-2.5">Whole design</h2>
    <% if @master_preview %>
      <%# The design comes from the app's own host: sandboxed, it never runs as the app. %>
      <iframe src="<%= @master_preview %>" title="The project's whole design"
              sandbox="allow-scripts allow-forms allow-popups allow-modals"
              class="w-full h-[70vh] border clar-divider rounded-[10px] bg-white"></iframe>
    <% else %>
      <p class="clar-text-faint text-[13px]">Nothing is published yet.</p>
    <% end %>
  </section>

  <section class="mb-7">
    <h2 class="clar-section-label mb-2.5">Conversations</h2>
    <% if @conversations.empty? %>
      <p class="clar-text-faint text-[13px]">None yet. Start one from Create Tasks: New idea, then Start in Designs, or Designs on an idea.</p>
    <% else %>
      <div class="clar-card divide-y divide-[color:var(--border)]">
        <% @conversations.each do |task| %>
          <%= link_to workshop_idea_designs_path(task), class: "flex items-center gap-3 px-4 py-3 no-underline clar-row-hover" do %>
            <span class="clar-mono text-[11.5px] clar-text-faint w-24"><%= Designs::BranchNames.slug(task) %></span>
            <span class="flex-1 min-w-0 font-semibold text-[13.5px] clar-text-text truncate"><%= task.name %></span>
            <span class="text-[12px] clar-text-muted">Open ›</span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </section>
<% else %>
  <div class="clar-card p-5">
    <div class="font-bold text-[14px] clar-text-text mb-1">Designs isn't set up for this project</div>
    <% if @project&.designs_enabled? && @project.design_repo_status == "error" %>
      <p class="text-[13px] clar-text-muted mb-3">Setting up the design repo failed: <%= @project.design_repo_error %></p>
    <% elsif @project&.designs_enabled? %>
      <p class="text-[13px] clar-text-muted mb-3">The design repo is being set up. This page shows the designs once it is ready.</p>
    <% else %>
      <p class="text-[13px] clar-text-muted mb-3">Switch Designs on for the project, with a GitHub repository for its designs and a token that can write to it.</p>
    <% end %>
    <% if can?(:configuration) %>
      <%= link_to "Set up in Configuration › Designs", workshop_configuration_path(tab: "designs"), class: "clar-btn clar-btn-primary no-underline" %>
    <% else %>
      <p class="text-[12.5px] clar-text-faint">An administrator of the workspace sets it up in Configuration.</p>
    <% end %>
  </div>
<% end %>
