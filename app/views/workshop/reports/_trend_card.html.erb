<%
  gran_label = { "weeks" => "week", "fortnights" => "2 weeks", "sprints" => "sprint" }.fetch(gran, "month")
  range_label = clar_trend_range_label(range)
  first_visible = trend.first
  last_visible = trend.last
  delta = (trend.size > 1) ? (last_visible[:sp] - first_visible[:sp]) : 0
  subtitle = developer ? "#{developer.name}&rsquo;s throughput".html_safe : "Team throughput"
%>
<div class="clar-card py-4.5 px-5 mb-6">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-3.5">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="font-bold text-[14px] clar-text-text">Story points delivered over time</span>
        <span class="clar-badge !text-[11.5px] !gap-1 !py-0.5 !px-2 !rounded-[6px] <%= delta >= 0 ? 'clar-badge-success' : 'clar-badge-danger' %>">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <% if delta >= 0 %>
              <path d="M7 17L17 7M17 7H8M17 7v9"/>
            <% else %>
              <path d="M7 7l10 10M17 17H8M17 17V8"/>
            <% end %>
          </svg>
          <%= delta >= 0 ? "+#{delta.to_i}" : delta.to_i %> vs start
        </span>
      </div>
      <div class="text-[12px] clar-text-faint mt-[3px]">
        <%= subtitle %> per <%= gran_label %>. <%= range_label %>
      </div>
    </div>

    <%= render "workshop/shared/trend_controls", gran: gran, range: range, chart: chart %>
  </div>

  <%# Stimulus reads value attributes from the CONTROLLER element only, not from
      child nodes — so points-value must live on this div, not the <canvas>.
      (Previously on the canvas → pointsValue was always [] → empty chart.) %>
  <div data-controller="clar-trend-chart" class="h-[220px]"
       data-clar-trend-chart-mode-value="<%= chart %>"
       data-clar-trend-chart-points-value="<%= trend.to_json %>">
    <canvas data-clar-trend-chart-target="canvas"></canvas>
  </div>
</div>
