<% content_for :title, "Reporting · Flosis" %>

<div class="flex items-start justify-between gap-5 mb-6 flex-wrap">
  <div>
    <h1 class="clar-h1">Reporting</h1>
    <p class="clar-sub mb-0">Throughput, quality and cost for the selected period.</p>
  </div>

  <div class="flex items-center gap-2.5 flex-wrap">
    <%= form_with url: workshop_reporting_path, method: :get, data: { controller: "clar-pipeline-filter" }, class: "flex items-center gap-2.5 flex-wrap" do |f| %>
      <% %i[period gran range chart month sprint].each do |kept| %>
        <%= hidden_field_tag kept, params[kept], id: nil if params[kept].present? %>
      <% end %>
      <div class="flex items-center gap-2 clar-card px-3 py-1.5">
        <% if @developer %>
          <span class="clar-avatar w-5 h-5 text-[9px] <%= clar_avatar_bg_class(@developer.name) %>"><%= clar_initials(@developer.name) %></span>
        <% else %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="clar-text-faint"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg>
        <% end %>
        <%= f.select :developer,
              [ [ "All team", "all" ] ] + @all_developers.map { |u| [ u.name, u.id ] },
              { selected: @developer&.id || "all" },
              class: "bg-transparent border-0 font-semibold text-[13px] clar-text-text cursor-pointer outline-none",
              data: { action: "change->clar-pipeline-filter#submit" } %>
      </div>
    <% end %>

    <%
      # ‹ Period › + Months/Sprints toggle. The arrows step whichever period
      # kind is active: month-by-month (never into the future) or
      # sprint-by-sprint through @sprints (oldest → newest).
      if @period == :sprint
        sprint_idx = @sprints.index(@selected_sprint)
        prev_target = sprint_idx && sprint_idx > 0 ? { sprint: @sprints[sprint_idx - 1].id } : nil
        next_target = sprint_idx && sprint_idx < @sprints.size - 1 ? { sprint: @sprints[sprint_idx + 1].id } : nil
        period_label = @selected_sprint&.name || "No sprints"
        prev_title, next_title = "Previous sprint", "Next sprint"
      else
        selected_month = @report.selected_month
        at_current_month = selected_month >= Time.current.beginning_of_month.to_date
        prev_target = { month: selected_month.prev_month.strftime("%Y-%m") }
        next_target = at_current_month ? nil : { month: selected_month.next_month.strftime("%Y-%m") }
        period_label = period_label_for(:month, month: selected_month)
        prev_title, next_title = "Previous month", "Next month"
      end
      arrow_class = "flex items-center justify-center w-7 h-7 rounded-[7px]"
    %>
    <div class="flex items-center gap-2">
      <%# 10px radius here, not the 14px .clar-card default. %>
      <div class="flex items-center gap-0.5 clar-card !rounded-[10px] p-[3px]">
        <% if prev_target %>
          <%= link_to request.query_parameters.merge(prev_target), title: prev_title,
                class: "#{arrow_class} clar-text-faint hover:clar-text-text", aria: { label: prev_title } do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <% end %>
        <% else %>
          <span class="<%= arrow_class %> text-[color:var(--border)] cursor-default" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          </span>
        <% end %>

        <span class="text-[13.5px] font-semibold clar-text-text min-w-[120px] text-center px-1 whitespace-nowrap"><%= period_label %></span>

        <% if next_target %>
          <%= link_to request.query_parameters.merge(next_target), title: next_title,
                class: "#{arrow_class} clar-text-faint hover:clar-text-text", aria: { label: next_title } do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          <% end %>
        <% else %>
          <span class="<%= arrow_class %> text-[color:var(--border)] cursor-default" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"/></svg>
          </span>
        <% end %>
      </div>

      <%# Switching period kind resets the position to "latest" — drop the
          other kind's cursor param so we don't carry a stale month/sprint. %>
      <div class="clar-tabs !rounded-[10px]">
        <%= link_to "Months", request.query_parameters.except("month", "sprint").merge(period: "month"),
              class: "clar-tab #{'clar-tab-active' if @period == :month}" %>
        <%= link_to "Sprints", request.query_parameters.except("month", "sprint").merge(period: "sprint"),
              class: "clar-tab #{'clar-tab-active' if @period == :sprint}" %>
      </div>
    </div>
  </div>
</div>

<%= render "metrics", metrics: @metrics, developer: @developer, developers_count: @developers.size %>

<%= render "trend_card", trend: @trend, gran: @gran, range: @range, chart: @chart, developer: @developer %>

<%= render "dev_table", developers: @developers, developer: @developer %>

<%= render "delivered_table", delivered: @delivered, developer: @developer %>
