<% content_for :title, "Reporting · Clar" %>

<div class="flex items-start justify-between gap-5 mb-6 flex-wrap">
  <div>
    <h1 class="clar-h1">Reporting</h1>
    <p class="clar-sub mb-0">Throughput, quality and cost for the selected period.</p>
  </div>

  <div class="flex items-center gap-2.5 flex-wrap">
    <%= form_with url: workshop_reporting_path, method: :get, data: { controller: "clar-pipeline-filter" }, class: "flex items-center gap-2.5 flex-wrap" do |f| %>
      <% %i[period gran range].each do |kept| %>
        <%= hidden_field_tag kept, params[kept], id: nil if params[kept].present? %>
      <% end %>
      <div class="flex items-center gap-2 clar-card px-3 py-1.5">
        <% if @developer %>
          <span class="clar-avatar w-5 h-5 text-[9px] <%= clar_avatar_bg_class(@developer.name) %>"><%= clar_initials(@developer.name) %></span>
        <% else %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="clar-text-faint"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0 8 4 4 0 0 0 0-8M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/></svg>
        <% end %>
        <%= f.select :developer,
              [ [ "All team", "all" ] ] + @all_developers.map { |u| [ u.name, u.id ] },
              { selected: @developer&.id || "all" },
              class: "bg-transparent border-0 font-semibold text-[13px] clar-text-text cursor-pointer outline-none",
              data: { action: "change->clar-pipeline-filter#submit" } %>
      </div>
    <% end %>

    <%
      selected_month = @report.selected_month
      prev_month = selected_month.prev_month
      next_month = selected_month.next_month
      # No reporting on the future: hide the next arrow once we're on the
      # current month.
      at_current_month = selected_month >= Time.current.beginning_of_month.to_date
    %>
    <div class="clar-tabs">
      <div class="clar-tab <%= 'clar-tab-active' if @period == :month %> !px-1.5 flex items-center gap-0.5">
        <%# Prev month — always available. %>
        <%= link_to request.query_parameters.merge(period: "month", month: prev_month.strftime("%Y-%m")),
              class: "flex items-center px-1 clar-text-faint hover:clar-text-text", title: "Previous month",
              aria: { label: "Previous month" } do %>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M15 18l-6-6 6-6"/></svg>
        <% end %>
        <%# The label itself switches to the month period (from the Sprint tab). %>
        <%= link_to period_label_for(:month, month: selected_month),
              request.query_parameters.merge(period: "month", month: selected_month.strftime("%Y-%m")),
              class: "font-semibold whitespace-nowrap px-1" %>
        <%# Next month — hidden on the current month (no future reporting). %>
        <% if at_current_month %>
          <span class="flex items-center px-1 clar-text-faint opacity-30 cursor-not-allowed" title="No future months" aria-hidden="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
          </span>
        <% else %>
          <%= link_to request.query_parameters.merge(period: "month", month: next_month.strftime("%Y-%m")),
                class: "flex items-center px-1 clar-text-faint hover:clar-text-text", title: "Next month",
                aria: { label: "Next month" } do %>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M9 18l6-6-6-6"/></svg>
          <% end %>
        <% end %>
      </div>
      <%= link_to period_label_for(:sprint, active_sprint: @report.current_active_sprint),
            request.query_parameters.merge(period: "sprint"),
            class: "clar-tab #{'clar-tab-active' if @period == :sprint}" %>
    </div>
  </div>
</div>

<%= render "metrics", metrics: @metrics, developer: @developer, developers_count: @developers.size %>

<%= render "trend_card", trend: @trend, gran: @gran, range: @range, developer: @developer %>

<%= render "dev_table", developers: @developers, developer: @developer %>

<%= render "delivered_table", delivered: @delivered, developer: @developer %>
