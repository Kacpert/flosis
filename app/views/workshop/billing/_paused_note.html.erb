<%# One amber line where AI would run (SCRUM-71, design ai-paused-note and
    the chat panel's paused note): the organization's AI is paused, what
    doesn't run because of it, and the way back. An organization
    administrator is sent to Billing, anyone else to an admin. %>
<%# locals: (what: nil, classes: "mb-4.5") %>
<% reason = ai_allowance&.reason %>
<% title, admin_way, member_way = Billing::Copy.paused_parts(reason) %>
<div role="status" data-paused-note="<%= ai_paused_who %>"
     class="<%= classes %> flex items-start gap-2 rounded-[10px] border border-[color:var(--warn)] bg-[color:var(--warn-soft)] px-3.5 py-2.5 text-[12.5px] leading-snug clar-text-text">
  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-px flex-none clar-text-warn" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
  <span>
    <b class="font-bold clar-text-warn"><%= title %></b>
    <% if what %><span class="clar-text-muted"><%= what %></span><% end %>
    <% if ai_paused_who == "admin" %>
      <%= link_to admin_way, workshop_billing_path(open: (reason == :limit ? "top-up" : (reason == :no_plan ? "change-plan" : nil))), class: "font-semibold clar-text-primary no-underline" %>
    <% else %>
      <span class="font-semibold"><%= member_way %></span>
    <% end %>
  </span>
</div>
