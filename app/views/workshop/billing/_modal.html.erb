<%# One Billing dialog in the clar-modal scope of the page (design modal). %>
<%# locals: (id:, title:) %>
<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="<%= id %>" data-action="click->clar-modal#close">
  <div class="clar-modal p-5.5 w-full max-w-[480px]" role="dialog" aria-labelledby="<%= id %>-title" data-action="click->clar-modal#stopPropagation">
    <div class="mb-2 flex items-center justify-between">
      <h2 id="<%= id %>-title" class="m-0 text-lg font-bold clar-text-text"><%= title %></h2>
      <button type="button" class="clar-text-faint flex p-1" data-action="clar-modal#close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <%= yield %>
  </div>
</div>
