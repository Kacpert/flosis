<%# A library page: the design system, the components or the merge history,
    all of master. %>
<div class="flex-1 overflow-y-auto">
  <div class="max-w-[1320px] mx-auto px-7 pt-5.5 pb-14">
    <%= link_to workshop_designs_overview_path(thread: @thread&.id), class: "inline-flex items-center gap-2 text-[12.5px] font-semibold clar-text-muted no-underline mb-3" do %>
      <span class="w-6 h-6 rounded-[7px] border border-[color:var(--border)] bg-[var(--surface)] flex items-center justify-center clar-text-text"><%= designs_icon(:back, 14) %></span>Back to canvas · <span class="clar-mono text-[11.5px]"><%= @thread&.branch || "master" %></span>
    <% end %>
    <% case @tab %>
    <% when "system" %>
      <h2 class="m-0 text-[21px] font-bold tracking-[-.4px] clar-text-text">Design system</h2>
      <p class="mt-1.5 mb-5 text-[13px] clar-text-muted">On master. Extracted from <%= @app_repos.first || "the app" %> and <%= @setup&.pages || 0 %> staging pages on <%= (@setup&.finished_at || @project.created_at).strftime("%-d %b %Y") %>. Token changes go through threads like any other design change.</p>
      <div class="grid gap-4" style="grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));">
        <% [ [ "Colours", :colors ], [ "Typography", :type ], [ "Spacing", :spacing ], [ "Radius", :radius ] ].each do |title, group| %>
          <div class="clar-card p-4.5">
            <div class="flex items-baseline justify-between gap-3 mb-3.5 flex-wrap"><span class="font-bold text-[14px] clar-text-text"><%= title %></span><span class="clar-mono text-[11px] clar-text-faint">design-system/theme.css</span></div>
            <% tokens = @tokens[group] %>
            <% if tokens.empty? %>
              <p class="text-[12.5px] clar-text-faint m-0">None in the theme yet.</p>
            <% elsif group == :colors %>
              <div class="grid gap-3" style="grid-template-columns: repeat(auto-fill, minmax(104px, 1fr));">
                <% tokens.each do |name, value| %>
                  <div><div class="h-[52px] rounded-[9px] border border-[color:var(--border)]" style="background: <%= value %>;"></div><div class="text-[12.5px] font-semibold clar-text-text mt-1.5"><%= name %></div><div class="clar-mono text-[11px] clar-text-faint"><%= value %></div></div>
                <% end %>
              </div>
            <% else %>
              <% tokens.each_with_index do |(name, value), i| %>
                <div class="grid gap-3.5 items-baseline py-2 <%= 'border-t border-[color:var(--border)]' if i.positive? %>" style="grid-template-columns: 160px minmax(0, 1fr);">
                  <span class="clar-mono text-[11.5px] font-semibold clar-text-text"><%= name %></span><span class="clar-mono text-[11px] clar-text-faint truncate"><%= value %></span>
                </div>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% when "components" %>
      <h2 class="m-0 text-[21px] font-bold tracking-[-.4px] clar-text-text">Components</h2>
      <p class="mt-1.5 mb-5 text-[13px] clar-text-muted">On master. Built in <%= @stack[:framework] %> with <%= @stack[:ui] %> classes, matched against <%= @app_repos.first || "the app" %>.</p>
      <div class="grid gap-3.5" style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));">
        <% @components.each do |component| %>
          <div class="clar-card p-0 overflow-hidden">
            <div class="h-[124px] bg-[#f7f7f7] border-b border-[color:var(--border)] overflow-hidden">
              <% if component[:preview] %><iframe src="<%= component[:preview] %>" title="<%= component[:name] %>" sandbox="allow-scripts" class="border-0 pointer-events-none origin-top-left" style="width: 500px; height: 248px; transform: scale(.5);"></iframe><% end %>
            </div>
            <div class="px-3.5 py-3"><div class="text-[13.5px] font-bold clar-text-text"><%= component[:name] %></div><div class="clar-mono text-[11px] clar-text-faint mt-0.5"><%= component[:path] %></div><div class="text-[12px] clar-text-muted mt-1.5">Used in <%= component[:used] %> of <%= @screen_count %> context views</div></div>
          </div>
        <% end %>
        <% if @components.empty? %><p class="text-[13px] clar-text-faint">No components on master yet.</p><% end %>
      </div>
    <% when "history" %>
      <h2 class="m-0 text-[21px] font-bold tracking-[-.4px] clar-text-text">Merge history</h2>
      <p class="mt-1.5 mb-5 text-[13px] clar-text-muted">Threads merged into master, newest first. Click a merge to see what went in.</p>
      <div class="clar-card p-0 overflow-x-auto">
        <div class="min-w-[720px]">
          <% @merges.each_with_index do |merge, i| %>
            <details class="<%= 'border-t border-[color:var(--border)]' if i.positive? %>" <%= "open" if params[:merge].to_s == merge.id.to_s %>>
              <summary class="grid gap-3.5 items-center px-4.5 py-3 cursor-pointer clar-row-hover list-none" style="grid-template-columns: 86px minmax(0, 1fr) minmax(0, 230px) 100px 80px 18px;">
                <span class="clar-mono text-[11.5px] font-semibold clar-text-success bg-[var(--success-soft)] px-2 py-0.5 rounded-md w-fit"><%= merge.short_sha %></span>
                <div class="min-w-0"><div class="text-[13.5px] font-semibold clar-text-text"><%= merge.title %></div><div class="clar-mono text-[11px] clar-text-faint truncate"><%= merge.branch %> → master</div></div>
                <span class="text-[12.5px] clar-text-muted"><%= merge.how_label %></span>
                <span class="text-[12.5px] clar-text-muted"><%= pluralize(Array(merge.screens).size, "screen") %></span>
                <span class="text-[12px] clar-text-faint text-right"><%= designs_ago(merge.merged_at) %></span>
                <span class="clar-text-faint flex"><%= designs_icon(:next, 14) %></span>
              </summary>
              <div class="pl-[118px] pr-4.5 pb-4.5 pt-1 grid gap-5.5" style="grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);">
                <div>
                  <div class="flex items-center gap-1.5 text-[11px] font-bold tracking-[.5px] clar-text-ai mb-1.5"><%= designs_icon(:ai, 12) %>SUMMARY</div>
                  <p class="m-0 mb-3.5 text-[13px] leading-[1.6] clar-text-text whitespace-pre-line"><%= merge.summary.presence || merge.title %></p>
                  <% if Array(merge.what_changed).any? %>
                    <div class="text-[11px] font-bold tracking-[.5px] clar-text-faint mb-1.5">WHAT CHANGED</div>
                    <ul class="m-0 pl-[18px] flex flex-col gap-1 text-[13px] leading-[1.5] clar-text-text list-disc"><% merge.what_changed.each do |change| %><li><%= change %></li><% end %></ul>
                  <% end %>
                </div>
                <div>
                  <div class="text-[11px] font-bold tracking-[.5px] clar-text-faint mb-1.5">SCREENS</div>
                  <div class="flex flex-wrap gap-1.5 mb-3.5">
                    <% if Array(merge.screens).any? %>
                      <% merge.screens.each do |key| %>
                        <% context, screen = key.split("/", 2) %>
                        <%= link_to "#{context.humanize} › #{screen.humanize}", workshop_designs_overview_path(ctx: context, screen: screen), class: "text-[11.5px] font-semibold px-2 py-1 rounded-[7px] no-underline border border-[color:var(--border)] bg-[var(--surface-2)] clar-text-text" %>
                      <% end %>
                    <% else %>
                      <span class="text-[12.5px] clar-text-muted">All screens</span>
                    <% end %>
                  </div>
                  <div class="flex flex-col gap-1 text-[12.5px] clar-text-muted">
                    <% if merge.task %><span>Task <span class="clar-mono text-[11.5px] clar-text-primary"><%= Designs::ThreadNames.key(merge.task) %></span></span><% end %>
                    <span><%= pluralize(merge.commits, "commit") %> · <%= merge.how_label %></span>
                  </div>
                </div>
              </div>
            </details>
          <% end %>
          <% if @merges.empty? %><div class="p-4.5 text-[13px] clar-text-faint">Nothing has been merged into master yet.</div><% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
