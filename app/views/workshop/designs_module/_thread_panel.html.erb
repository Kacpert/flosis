<%# One thread: its header, what changed under it, the conversation and the
    composer. A merged thread is read-only. %>
<% thread = @thread %>
<% merged = thread.merged? %>
<% key = thread.task && Designs::ThreadNames.key(thread.task) %>
<% offers_task = !thread.task && !merged && !thread.fresh? %>
<div class="px-3.5 py-3 border-b border-[color:var(--border)] @container">
  <%# Back to the threads, then the thread's task (or Generate task) beside
      Hide menus; the task's stage shows on hover. A column too narrow for all
      three (they need 19rem) drops the word Threads. %>
  <div class="flex items-center justify-between gap-x-2.5 gap-y-1.5 flex-wrap mb-2" data-designs-head>
    <%= link_to workshop_designs_overview_path, class: "inline-flex items-center gap-2 text-[12.5px] font-semibold clar-text-muted no-underline rounded-lg py-1 pr-2 min-w-0", "aria-label": "Threads" do %>
      <span class="w-6 h-6 rounded-[7px] border border-[color:var(--border)] bg-[var(--surface)] flex items-center justify-center clar-text-text flex-none"><%= designs_icon(:back, 14) %></span><span class="designs-cut<%= " @max-[19.25rem]:hidden" if thread.task || offers_task %>">Threads</span>
    <% end %>
    <div class="flex items-center gap-2.5 min-w-0">
      <% if thread.task %>
        <% stage = { "new" => "New", "briefing" => "Briefing", "details" => "Details", "ready" => "Ready" }[thread.task.workshop_stage] %>
        <%= link_to workshop_idea_path(thread.task), class: "clar-btn clar-tip clar-tip-below !py-1 !px-2 !text-[12px] no-underline", data: { tip: [ stage, "Open task" ].compact.join(" · ") } do %>
          <%= designs_icon(:task, 13) %><span class="clar-mono text-[11px] clar-text-primary"><%= key %></span>
        <% end %>
      <% elsif offers_task %>
        <button type="button" class="clar-btn clar-tip clar-tip-below !py-1 !px-2 !text-[12px] clar-text-ai" data-tip="Generate a task when the scope is clear. It starts in Details Gathering."
                data-action="clar-modal#open" data-clar-modal-id-param="generate-task">
          <%= designs_icon(:ai, 13) %>Generate task
        </button>
      <% end %>
      <%= render "menus_switch" %>
    </div>
  </div>
  <div class="text-[15px] font-bold tracking-[-.2px] clar-text-text leading-[1.35]"><%= thread.title %></div>
  <div class="flex items-center gap-1.5 flex-wrap mt-1.5">
    <% if thread.branch %>
      <span class="inline-flex items-center gap-1 clar-mono text-[11px] clar-text-ai bg-[var(--ai-soft)] px-1.5 py-0.5 rounded-md max-w-full truncate"><%= designs_icon(:branch, 11) %><%= thread.branch %></span>
    <% end %>
    <% if merged %>
      <span class="clar-badge clar-badge-success !py-0.5 !px-2"><%= designs_icon(:merge, 11) %>Merged · <%= thread.merged_sha.to_s.first(7) %></span>
    <% elsif thread.fresh? %>
      <span class="text-[11.5px] clar-text-faint">No changes yet</span>
    <% else %>
      <span class="text-[11.5px] clar-text-faint"><%= pluralize(@ahead, "commit") %> ahead</span>
    <% end %>
  </div>
</div>

<% if @description_change && !merged %>
  <div class="mx-3 mt-3 px-3 py-2.5 rounded-[10px] bg-[var(--warn-soft)] border border-[color:var(--border)] flex items-center gap-2.5 flex-wrap">
    <div class="flex-1 min-w-[min(150px,100%)] text-[12.5px] clar-text-text leading-[1.45]"><b class="clar-text-warn"><%= key %> changed</b> since the last design update (<%= @description_change[:from] %> → <%= @description_change[:to] %>).</div>
    <%= button_to "Update designs", update_description_workshop_design_thread_path(thread), class: "clar-btn clar-btn-primary !py-1.5 !px-2.5 !text-[12px]", form: { class: "contents" } %>
  </div>
<% end %>

<% if @behind.any? && !merged %>
  <%# master's merges since the thread branched, folded under one line with
      Update at hand. The button belongs to the form outside the fold, so a
      click on it updates and leaves the fold as it was. %>
  <%= form_with url: update_master_workshop_design_thread_path(thread), method: :post, id: "designs-update-master", class: "hidden" do %><% end %>
  <details class="group mx-3 mt-3 rounded-[10px] bg-[var(--warn-soft)] border border-[color:var(--border)]">
    <summary class="flex items-center gap-2 pl-2.5 pr-1.5 py-1.5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <span class="flex flex-none clar-text-warn transition-transform group-open:rotate-90"><%= designs_icon(:next, 12) %></span>
      <span class="flex-1 min-w-0 text-[12px] clar-text-text designs-cut"><b class="clar-text-warn">master changed</b> · <%= pluralize(@behind.size, "merge") %></span>
      <button type="submit" form="designs-update-master" class="clar-btn clar-btn-primary clar-tip !py-1 !px-2.5 !text-[11.5px] flex-none" data-tip="Update from master">Update</button>
    </summary>
    <div class="flex flex-col gap-1.5 px-2.5 pb-2.5">
      <% @behind.first(3).each do |merge| %>
        <%= link_to workshop_designs_overview_path(tab: "history", merge: merge.id), class: "flex items-start gap-2 no-underline bg-[var(--surface)] border border-[color:var(--border)] rounded-lg px-2 py-1.5" do %>
          <span class="clar-mono text-[10.5px] font-semibold clar-text-success bg-[var(--success-soft)] px-1.5 rounded-[5px] flex-none"><%= merge.short_sha %></span>
          <span class="min-w-0"><span class="block text-[12px] font-semibold clar-text-text"><%= merge.title %></span><span class="block text-[11.5px] clar-text-muted leading-[1.45] mt-0.5"><%= Array(merge.what_changed).join(" · ") %></span></span>
        <% end %>
      <% end %>
      <% if @behind.size > 3 %>
        <div class="text-[11.5px] clar-text-faint pl-1">and <%= @behind.size - 3 %> more</div>
      <% end %>
    </div>
  </details>
<% end %>

<%= render "messages", thread: thread %>

<%= form_with url: attach_workshop_design_thread_path(thread), method: :post, multipart: true, id: "design-attach-form", class: "hidden" do %><% end %>
<div class="p-3 border-t border-[color:var(--border)]">
  <% if merged %>
    <div class="text-[12.5px] clar-text-muted leading-[1.5] py-1 px-0.5">Merged into master as <span class="clar-mono"><%= thread.merged_sha.to_s.first(7) %></span>. Start a new thread for further changes.</div>
  <% elsif Designs::Threads.importing?(thread) %>
    <div class="text-[12.5px] clar-text-muted leading-[1.5] py-1 px-0.5"><%= Designs::Threads::IMPORTING %></div>
  <% else %>
    <%= form_with url: message_workshop_design_thread_path(thread), method: :post, class: "border border-[color:var(--border)] rounded-xl bg-[var(--bg)] pt-2 pr-2 pb-2 pl-3" do |f| %>
      <%= hidden_field_tag :ctx, @context, data: { designs_canvas_target: "context" } %>
      <%= hidden_field_tag :screen, @screen, data: { designs_canvas_target: "screen" } %>
      <textarea name="text" rows="2" required class="w-full resize-none border-0 outline-none bg-transparent text-[13px] leading-[1.5] clar-text-text"
                placeholder="<%= thread.fresh? ? 'What should change? Navigate the app on the right, AI sees the page you’re on.' : 'Describe a change…' %>"
                data-controller="designs-composer" data-action="keydown->designs-composer#key"></textarea>
      <div class="flex items-center gap-2">
        <span class="text-[11px] clar-text-faint flex-1 min-w-0 truncate" data-designs-canvas-target="sees"><%= @current ? "AI sees #{designs_context_name(@contexts, @context)} › #{@current[:name]}" : "AI sees nothing yet" %></span>
        <%# The file picker belongs to the form below, outside this one. %>
        <label for="design-inspirations" class="clar-btn !p-0 w-[30px] h-[30px] justify-center cursor-pointer" title="Attach inspiration"><%= designs_icon(:attach, 14) %></label>
        <input id="design-inspirations" type="file" name="files[]" multiple form="design-attach-form" class="hidden"
               accept=".png,.jpg,.jpeg,.gif,.webp,.svg,.pdf,.txt,.md" data-controller="designs-attach" data-action="change->designs-attach#submit">
        <button type="submit" class="clar-btn clar-btn-primary !p-0 w-[30px] h-[30px] justify-center" title="Send"><%= designs_icon(:send, 14) %></button>
      </div>
    <% end %>
  <% end %>
</div>
