<%# The canvas: a published screen, sandboxed under a grant, 1160px wide and
    scaled to fit, with View as, the thread's modes and its changed screens. %>
<% live = @thread&.open? && !@thread.fresh? %>
<% params_for = ->(extra = {}) { { thread: @thread&.id, ctx: @context, screen: @screen, mode: (@mode unless @mode == "master" || !live) }.merge(extra).compact } %>
<div class="flex items-center gap-2.5 px-4 pt-3 pb-2.5 border-b border-[color:var(--border)] bg-[var(--surface)] flex-wrap relative z-[5]">
  <span class="text-[12px] clar-text-faint">View as</span>
  <div class="clar-seg">
    <% @contexts.each do |context| %>
      <% here = @screens.any? { |s| s[:context] == context[:id] && s[:id] == @screen } %>
      <% if here %>
        <%= link_to context[:name], workshop_designs_overview_path(params_for.call(ctx: context[:id])), class: "clar-seg-item no-underline #{'clar-seg-item-active' if context[:id] == @context}" %>
      <% else %>
        <span class="clar-seg-item opacity-40 cursor-default" title="Not available for <%= context[:name] %>"><%= context[:name] %></span>
      <% end %>
    <% end %>
  </div>
  <div class="flex-1"></div>
  <% if live %>
    <div class="clar-seg">
      <% [ [ "branch", "This branch" ], [ "master", "Master" ], [ "changes", "Changes" ] ].each do |mode, label| %>
        <%= link_to label, workshop_designs_overview_path(params_for.call(mode: mode)), class: "clar-seg-item no-underline #{'clar-seg-item-active' if @mode == mode}" %>
      <% end %>
    </div>
  <% end %>
  <% if @frame_src %>
    <a href="<%= @frame_src %>" target="_blank" rel="noopener noreferrer" class="clar-btn no-underline" title="Open this preview in a new tab"
       data-action="designs-canvas#toast" data-designs-canvas-message-param="Opened in new tab · <%= @frame_src.sub(%r{\Ahttps?://}, "") %>"><%= designs_icon(:external, 14) %>Open in new tab</a>
  <% end %>
  <% if live %>
    <button type="button" class="clar-btn clar-btn-primary" data-action="clar-modal#open" data-clar-modal-id-param="merge-thread"><%= designs_icon(:merge, 14) %>Merge to master</button>
  <% elsif @thread.nil? %>
    <span class="text-[12px] clar-text-faint">Read-only · start a thread to change it</span>
  <% end %>
</div>

<% if live && @mode == "changes" %>
  <div class="flex items-center gap-2 flex-wrap px-4 py-2 border-b border-[color:var(--border)] bg-[var(--ai-soft)] text-[12px] clar-text-text">
    <span class="font-bold clar-text-ai">Changed in this thread</span>
    <% @changed.each do |context, screen| %>
      <%= link_to "#{designs_context_name(@contexts, context)} › #{designs_screen_name(@screens, context, screen)}",
                  workshop_designs_overview_path(params_for.call(ctx: context, screen: screen)),
                  class: "text-[11.5px] font-semibold px-2 py-0.5 rounded-[7px] no-underline bg-[var(--surface)] border #{[ context, screen ] == [ @context, @screen ] ? 'border-[color:var(--ai)] clar-text-ai' : 'border-[color:var(--border)] clar-text-text'}" %>
    <% end %>
    <% if @changed.empty? %><span class="clar-text-muted">Nothing yet.</span><% end %>
  </div>
<% end %>

<div class="flex-1 overflow-auto p-5 bg-[var(--surface-2)]">
  <div class="max-w-[1162px] mx-auto border border-[color:var(--border)] rounded-xl overflow-hidden shadow-sm bg-white">
    <div class="flex items-center gap-2.5 px-3 py-2 bg-[var(--surface)] border-b border-[color:var(--border)]">
      <span class="flex gap-[5px]"><% 3.times do %><span class="w-[9px] h-[9px] rounded-full bg-[var(--border)]"></span><% end %></span>
      <span class="clar-mono text-[11.5px] clar-text-muted flex-1 min-w-0 truncate" data-designs-canvas-target="path"><%= @current ? @current[:path] : "designs/" %></span>
      <% if @mode == "master" || !live %>
        <span class="clar-badge-success inline-flex items-center gap-1"><%= designs_icon(:lock, 11) %>master</span>
      <% else %>
        <span class="clar-badge-ai inline-flex items-center gap-1 max-w-[50%] truncate"><%= designs_icon(:branch, 11) %><%= @thread.branch %></span>
      <% end %>
    </div>
    <% if @frame_src %>
      <div class="w-full overflow-hidden" data-designs-canvas-target="wrap">
        <%# Sandboxed: the screen runs on an origin of its own, never as the app. %>
        <iframe src="<%= @frame_src %>" title="<%= @current[:name] %>" sandbox="allow-scripts allow-forms allow-popups allow-modals"
                class="block border-0 origin-top-left" style="width: 1160px; height: 860px;" data-designs-canvas-target="frame"></iframe>
      </div>
    <% else %>
      <div class="p-10 text-center text-[13px] clar-text-muted">No screens here yet. Start a thread to design one.</div>
    <% end %>
  </div>
</div>
