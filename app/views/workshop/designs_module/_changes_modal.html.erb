<%# Every screen the thread changed itself, by context, with a filter; below,
    folded, those only a changed shared component reached, by component.
    Opened from the canvas (All changes) and from a reply's "+N more". %>
<% link = ->(context, screen) { workshop_designs_overview_path(thread: @thread.id, ctx: context, screen: screen, mode: "changes") } %>
<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="changed-screens" data-action="click->clar-modal#close">
  <div class="clar-modal p-5 max-w-[560px] max-h-[80vh] flex flex-col" data-action="click->clar-modal#stopPropagation" data-controller="clar-filter">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 class="m-0 text-[17px] font-bold clar-text-text">Changed in this thread</h2>
      <button type="button" class="bg-transparent border-0 cursor-pointer clar-text-faint flex p-1" data-action="clar-modal#close" aria-label="Close"><%= designs_icon(:close, 18) %></button>
    </div>
    <input type="search" class="clar-input !py-1.5 !text-[12.5px] mb-2" placeholder="Find a screen" autocomplete="off"
           data-clar-filter-target="query" data-action="input->clar-filter#filter">
    <div class="overflow-y-auto min-h-0 -mx-1 px-1">
      <% @changed_own.group_by(&:first).each do |context, list| %>
        <div class="text-[11px] font-bold tracking-[.4px] clar-text-faint mt-2.5 mb-1"><%= designs_context_name(@contexts, context).upcase %></div>
        <% list.each do |_, screen, kind| %>
          <% name = designs_screen_name(@screens, context, screen) %>
          <%= link_to link.call(context, screen), class: "flex items-center gap-2 px-2 py-1.5 rounded-lg no-underline text-[12.5px] clar-text-text hover:bg-[var(--surface-2)] #{'bg-[var(--ai-soft)]' if [ context, screen ] == [ @context, @screen ]}",
                      data: { clar_filter_target: "item", filter_text: "#{designs_context_name(@contexts, context)} #{name}", turbo_frame: "_top" } do %>
            <span class="clar-mono text-[10.5px] font-bold w-3 <%= kind == 'new' ? 'clar-text-success' : 'clar-text-ai' %>"><%= kind == "new" ? "+" : "M" %></span><%= name %>
          <% end %>
        <% end %>
      <% end %>
      <% if @changed_through.any? %>
        <details class="mt-3 border-t border-[color:var(--border)] pt-2.5">
          <summary class="cursor-pointer text-[12px] font-semibold clar-text-muted"><%= pluralize(@changed_through.values.sum(&:size), "screen") %> changed only through shared parts</summary>
          <% @changed_through.each do |component, list| %>
            <div class="text-[11px] font-bold tracking-[.4px] clar-text-faint mt-2.5 mb-1">THROUGH <%= component.humanize.upcase %></div>
            <% list.each do |context, screen| %>
              <% name = "#{designs_context_name(@contexts, context)} › #{designs_screen_name(@screens, context, screen)}" %>
              <%= link_to name, link.call(context, screen), class: "block px-2 py-1 rounded-lg no-underline text-[12px] clar-text-muted hover:bg-[var(--surface-2)]",
                          data: { clar_filter_target: "item", filter_text: name, turbo_frame: "_top" } %>
            <% end %>
          <% end %>
        </details>
      <% end %>
      <div class="hidden text-[12.5px] clar-text-faint px-2 py-2" data-clar-filter-target="empty">No screen matches.</div>
    </div>
  </div>
</div>
