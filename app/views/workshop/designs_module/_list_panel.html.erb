<%# The threads list: master, every open thread, and the library. %>
<% last = @merges.first %>
<div class="px-3.5 py-3 border-b border-[color:var(--border)]">
  <% if @back %>
    <%= link_to workshop_idea_path(@back), class: "flex items-center gap-2 text-[12.5px] font-semibold clar-text-muted no-underline rounded-lg py-1 pr-2 mb-2.5" do %>
      <span class="w-6 h-6 rounded-[7px] border border-[color:var(--border)] bg-[var(--surface)] flex items-center justify-center clar-text-text flex-none"><%= designs_icon(:back, 14) %></span><span class="truncate">Back to <%= Designs::ThreadNames.key(@back) %> · <%= @back.name %></span>
    <% end %>
  <% end %>
  <div class="flex items-center gap-2">
    <h1 class="m-0 text-[17px] font-bold tracking-[-.3px] clar-text-text flex-1">Designs</h1>
    <button type="button" class="clar-btn !p-0 w-7 h-7 justify-center" title="Show menu" data-action="designs-immersive#peekNav"><%= designs_icon(:panel, 15) %></button>
    <button type="button" class="clar-btn !p-0 w-[30px] h-[30px] justify-center" title="Design settings"
            data-action="clar-modal#open" data-clar-modal-id-param="design-settings"><%= designs_icon(:gear, 15) %></button>
  </div>
  <div class="flex items-center gap-1.5 text-[11.5px] clar-text-faint mt-1.5 flex-wrap">
    <span class="clar-dot" style="width: 6px; height: 6px; background: var(--success);"></span>
    Synced <%= designs_ago(@project.design_threads.maximum(:updated_at) || @project.updated_at) %> · <span class="clar-mono text-[11px]"><%= @project.design_repo %></span>
  </div>
  <div class="mt-3"><%= render "menus_switch" %></div>
</div>

<div class="p-2 border-b border-[color:var(--border)] flex flex-col gap-px">
  <% [ [ "system", "Design system", "Colours, type, spacing, radius", :palette, nil ],
       [ "components", "Components", "#{@components.size} in #{@stack[:framework]}", :grid, @components.size ],
       [ "history", "Merge history", "#{@merges.size} merges into master", :merge, @merges.size ] ].each do |tab, label, sub, icon, count| %>
    <%= link_to workshop_designs_overview_path(tab: tab), class: "flex items-center gap-2.5 px-2 py-1.5 rounded-lg no-underline clar-row-hover #{'bg-[var(--primary-soft)]' if @tab == tab}",
          title: sub do %>
      <span class="flex <%= @tab == tab ? 'clar-text-primary' : 'clar-text-muted' %>"><%= designs_icon(icon, 15) %></span>
      <span class="flex-1 text-[13px] font-semibold <%= @tab == tab ? 'clar-text-primary' : 'clar-text-text' %>"><%= label %></span>
      <span class="text-[11px] clar-text-faint"><%= count %></span>
    <% end %>
  <% end %>
  <%# Imports (imports-link.html): one line like the others, no badge; lit
      while an import has settled since this person last opened it. %>
  <% line = import_line(@project, current_user) %>
  <% here = @tab == "imports" %>
  <% tone = line[:lit] ? "clar-text-warn" : (here ? "clar-text-primary" : nil) %>
  <%= link_to workshop_designs_overview_path(tab: "imports"), class: "flex items-center gap-2.5 px-2 py-1.5 rounded-lg no-underline clar-row-hover #{'bg-[var(--primary-soft)]' if here && !line[:lit]}",
        style: ("background: var(--warn-soft);" if line[:lit]), title: "Every import of the designs from the app", data: { imports_line: true, lit: line[:lit] } do %>
    <span class="flex <%= tone || 'clar-text-muted' %>"><%= designs_icon(:reload, 15) %></span>
    <span class="flex-1 text-[13px] font-semibold <%= tone || 'clar-text-text' %>">Imports</span>
    <span class="text-[11px] <%= line[:lit] ? 'clar-text-warn font-semibold' : 'clar-text-faint' %>"><%= line[:right] %></span>
  <% end %>
</div>

<div class="px-2 pt-2.5 pb-1.5 flex items-center gap-2">
  <span class="clar-section-label flex-1 pl-2">BRANCHES · <%= @rows.size + 1 %></span>
  <%= button_to workshop_design_threads_path, method: :post, class: "clar-btn !p-0 w-[26px] h-[26px] justify-center", title: "New thread", form: { class: "contents" } do %>
    <%= designs_icon(:plus, 13) %>
  <% end %>
</div>
<% if @rows.size > 5 %>
  <div class="px-2.5 pb-1.5" data-controller="clar-filter">
    <input type="search" class="clar-input !py-1.5 !text-[12.5px]" placeholder="Filter threads" data-action="input->clar-filter#filter">
  </div>
<% end %>

<div class="flex-1 overflow-y-auto px-2 pb-2.5">
  <%= link_to workshop_designs_overview_path, class: "flex items-start gap-2.5 w-full px-2.5 py-2 rounded-lg no-underline clar-row-hover #{'bg-[var(--bg)] border border-[color:var(--border)]' if @thread.nil? && @tab == 'canvas'}" do %>
    <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-none" style="background: var(--success-soft); color: var(--success);"><%= designs_icon(:lock, 14) %></span>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-1.5"><span class="clar-mono text-[13px] font-semibold clar-text-text">master</span><span class="clar-badge-success">Read-only</span></div>
      <div class="text-[11.5px] clar-text-faint mt-0.5"><%= last ? "Last merge #{last.short_sha} · #{designs_ago(last.merged_at)}" : "No merges yet" %></div>
    </div>
  <% end %>

  <% @rows.each do |row| %>
    <% thread = row[:thread] %>
    <%# Delete takes the chevron's place while the row is hovered. %>
    <div class="group relative mt-0.5">
      <%= link_to workshop_designs_overview_path(thread: thread.id), class: "flex items-start gap-2.5 w-full px-2.5 py-2 rounded-lg no-underline clar-row-hover", data: { filter_text: "#{thread.title} #{thread.branch} #{thread.task&.external_reference}" } do %>
        <span class="w-7 h-7 rounded-lg flex items-center justify-center flex-none" style="background: var(--ai-soft); color: var(--ai);"><%= designs_icon(:branch, 14) %></span>
        <div class="flex-1 min-w-0">
          <div class="text-[13px] font-semibold clar-text-text leading-[1.35]"><%= thread.title %></div>
          <div class="flex items-center gap-1.5 flex-wrap mt-1">
            <% if thread.task %>
              <span class="clar-mono text-[10.5px] font-semibold clar-text-primary bg-[var(--primary-soft)] px-1.5 rounded"><%= Designs::ThreadNames.key(thread.task) %></span>
            <% else %>
              <span class="text-[9.5px] font-bold tracking-[.3px] clar-text-muted bg-[var(--surface-2)] border border-[color:var(--border)] px-1.5 rounded">NO TASK</span>
            <% end %>
            <% if row[:task_changed] %><span class="text-[10.5px] font-bold clar-text-warn">Task changed</span><% end %>
            <% if row[:master_changed] %><span class="text-[10.5px] font-bold clar-text-warn">Master changed</span><% end %>
            <span class="text-[11px] clar-text-faint"><%= designs_ago(thread.updated_at) %></span>
          </div>
        </div>
        <span class="clar-text-faint flex mt-1.5 group-hover:invisible group-focus-within:invisible"><%= designs_icon(:next, 14) %></span>
      <% end %>
      <%= button_to workshop_design_thread_path(thread), method: :delete, title: "Delete thread", "aria-label": "Delete #{thread.title}",
            class: "clar-btn !p-0 w-[26px] h-[26px] justify-center absolute right-1 top-2 clar-text-muted hover:text-[var(--danger)] opacity-0 group-hover:opacity-100 group-focus-within:opacity-100",
            form: { class: "contents", data: { turbo_confirm: designs_delete_confirm(thread) } } do %>
        <%= designs_icon(:trash, 13) %>
      <% end %>
    </div>
  <% end %>
  <% if @rows.empty? %>
    <div class="p-2.5 text-[12px] clar-text-faint">No open threads.</div>
  <% end %>
</div>

<div class="p-3 border-t border-[color:var(--border)]">
  <%= button_to workshop_design_threads_path, method: :post, class: "clar-btn clar-btn-primary w-full justify-center", form: { class: "contents" } do %>
    <%= designs_icon(:plus, 14) %>New thread
  <% end %>
</div>
