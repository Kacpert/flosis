<%# The conversation, polled while a turn is queued or running
    (designs_poll_controller); a request Flosis made on the person's behalf is
    not shown. %>
<% session = thread.chat_session %>
<% active = session && DesignTurn.active.where(chat_session: session).exists? %>
<%= turbo_frame_tag "design_thread_messages", class: "flex-1 min-h-0 flex flex-col" do %>
  <div class="flex-1 overflow-y-auto px-3.5 pt-4 pb-2.5 flex flex-col gap-3.5 [overflow-wrap:anywhere]"
       data-controller="designs-poll"
       data-designs-poll-active-value="<%= active %>"
       data-designs-poll-commit-value="<%= session && DesignTurn.where(chat_session: session).where.not(commit_sha: nil).maximum(:id) %>"
       data-designs-poll-url-value="<%= workshop_designs_overview_path(thread: thread.id, frame: "messages") %>">
    <% (session ? session.chat_messages.ordered.where("kind IS NULL OR kind <> ?", "request") : []).each do |message| %>
      <%= render "message", message: message %>
    <% end %>
    <% if active %>
      <div class="flex gap-2.5 items-center">
        <span class="w-[26px] h-[26px] rounded-full flex items-center justify-center flex-none" style="background: var(--ai-soft); color: var(--ai);"><%= designs_icon(:ai, 13) %></span>
        <span class="flex gap-1"><% 3.times do |i| %><span class="w-1.5 h-1.5 rounded-full clar-blink" style="background: var(--ai); animation-delay: <%= i * 0.2 %>s;"></span><% end %></span>
      </div>
    <% end %>
  </div>
<% end %>
