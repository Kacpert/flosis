<div class="clar-card p-0 overflow-hidden">
  <div class="flex items-center justify-between py-3.5 px-5 border-b border-[color:var(--border)]">
    <span class="font-bold text-[14px] clar-text-text">Users</span>
    <%= link_to new_workspace_member_path, target: "_blank", rel: "noopener", class: "clar-btn clar-btn-primary no-underline" do %>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      Invite
    <% end %>
  </div>

  <% @members.each do |membership| %>
    <% badge_class, badge_label = workshop_role_badge(membership) %>
    <div class="flex items-center gap-3.5 py-3.5 px-5 border-b border-[color:var(--border)] last:border-b-0">
      <span class="w-8 h-8 rounded-full flex items-center justify-center text-[11px] font-bold text-white flex-none <%= clar_avatar_bg_class(membership.user.name) %>">
        <%= clar_initials(membership.user.name) %>
      </span>
      <div class="flex-1 min-w-0">
        <div class="font-semibold text-[13.5px] clar-text-text truncate"><%= membership.user.name %></div>
        <div class="text-[11.5px] clar-text-faint truncate"><%= membership.user.email_address %></div>
      </div>
      <span class="clar-badge <%= badge_class %> whitespace-nowrap"><%= badge_label %></span>
    </div>
  <% end %>
</div>
