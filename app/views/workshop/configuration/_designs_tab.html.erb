<%# Designs tab — switches Designs on for the project and points it at the GitHub
    repository that holds its design system, components and designs. A plain form
    with a Save button, not auto-save: saving can start the repo's set-up, and a
    half-typed repository or token must never do that. The status and the preview
    links are rendered OUTSIDE the form: the rotate button posts a form of its
    own, and HTML forbids nesting one in another. %>
<% project = current_workshop_project %>

<% if project.nil? %>
  <div class="clar-card p-4.5 text-[13px] clar-text-muted">No project selected &mdash; pick one in the top bar to set up its designs.</div>
<% else %>
  <%
    # The token is write-only: the field never carries it, and the placeholder
    # says only whether one is stored, with the tail of a long one so a rotation
    # shows. A short token is masked whole.
    stored_token = project.design_repo_token.to_s
    token_placeholder = stored_token.empty? ? "Not set" : "••••••••••••#{stored_token.last(4) if stored_token.length >= 12}"
    kit_labels = { "tailwind4" => "Tailwind v4", "plain" => "Plain CSS" }
    status = project.design_repo_status
    # Off, nothing runs and nothing is offered: a repo set up before is not
    # "Ready" (and the controller links to none of its previews).
    status = "off" if status == "ready" && !project.designs_enabled?
    error = project.design_repo_error
    tone = { "ready" => "clar-text-success", "initializing" => "clar-text-warn", "error" => "clar-text-danger" }.fetch(status, "clar-text-faint")
  %>

  <%= form_with model: project, url: workshop_configuration_path, method: :patch, class: "flex flex-col gap-4.5",
        data: { controller: "clar-toggle" } do |f| %>
    <%= hidden_field_tag :tab, "designs" %>

    <div class="clar-card p-4.5">
      <div class="flex items-center justify-between gap-3.5">
        <div>
          <div class="font-bold text-[14px] clar-text-text mb-1">Designs on this project</div>
          <div class="text-[12.5px] clar-text-muted">AI-made, clickable designs for this project's tasks, kept in the GitHub repository below.</div>
        </div>
        <%= f.check_box :designs_enabled, class: "sr-only", tabindex: -1,
              data: { clar_toggle_target: "input", action: "change->clar-toggle#render" } %>
        <button type="button" role="switch" class="clar-toggle" aria-label="Designs on this project"
                aria-checked="<%= project.designs_enabled? ? 'true' : 'false' %>"
                data-clar-toggle-target="button" data-action="clar-toggle#toggle">
          <span class="knob"></span>
        </button>
      </div>
    </div>

    <div class="clar-card p-4.5">
      <%= f.label :design_repo, "DESIGN REPOSITORY", class: "clar-field-label" %>
      <%= f.text_field :design_repo, placeholder: "owner/name", autocomplete: "off", spellcheck: false,
            class: "clar-input clar-mono mb-1.5" %>
      <div class="text-[11px] clar-text-faint mb-4">An empty GitHub repository. Flosis pushes only the design system, components, designs and the files needed to open them.</div>

      <%= f.label :design_repo_token, "ACCESS TOKEN", class: "clar-field-label" %>
      <%= f.password_field :design_repo_token, value: nil, placeholder: token_placeholder,
            autocomplete: "new-password", class: "clar-input clar-mono mb-1.5" %>
      <div class="text-[11px] clar-text-faint mb-4">Needs write access to this repository only. Leave blank to keep the current token.</div>

      <%= f.label :design_base_kit, "BASE KIT", class: "clar-field-label" %>
      <%= f.select :design_base_kit, Project::DESIGN_BASE_KITS.map { |kit| [ kit_labels.fetch(kit, kit), kit ] }, {},
            class: "clar-select mb-1.5" %>
      <div class="text-[11px] clar-text-faint">The CSS the starter files are built on. It is used when the repository is set up; changing it later does not rewrite what is already there.</div>
    </div>

    <%= f.submit "Save changes", class: "clar-btn clar-btn-primary self-start" %>
  <% end %>

  <div class="flex flex-col gap-4.5 mt-4.5">
    <div class="clar-card p-4.5" data-design-status="<%= status || 'not_set_up' %>">
      <div class="font-bold text-[14px] clar-text-text mb-2.5">Status</div>
      <div class="flex flex-wrap items-start justify-between gap-3.5">
        <div class="flex items-start gap-2 min-w-0 text-[13px] font-semibold <%= tone %>">
          <span class="w-1.5 h-1.5 rounded-full bg-current flex-none mt-[7px]"></span>
          <% if status == "ready" %>
            <span>Ready</span>
          <% elsif status == "initializing" %>
            <%# A save queues the set-up again, so a run that died (a deploy stops jobs) is retried that way. %>
            <span>Setting up&hellip; <span class="font-normal clar-text-muted">If this takes more than a few minutes, save again to retry.</span></span>
          <% elsif status == "off" %>
            <span>Designs is off</span>
          <% elsif status == "error" %>
            <%# One line, so no template whitespace lands in the pre-wrapped text. %>
            <span class="min-w-0 break-words whitespace-pre-wrap">Failed<% if error.present? %>: <span class="font-normal clar-text-muted"><%= error %></span><% end %></span>
          <% else %>
            <span>Not set up</span>
          <% end %>
        </div>
        <% if @master_preview_url %>
          <%= link_to "Open master preview ↗", @master_preview_url, target: "_blank", rel: "noopener noreferrer",
                class: "clar-btn !text-[12px] !py-1.5 !px-3 flex-none whitespace-nowrap no-underline" %>
        <% end %>
      </div>
    </div>

    <div class="clar-card p-4.5">
      <div class="flex flex-wrap items-start justify-between gap-3.5">
        <div>
          <div class="font-bold text-[14px] clar-text-text mb-1">Preview links</div>
          <div class="text-[12.5px] clar-text-muted">Rotating makes every preview link sent so far, including those in Jira, stop working.</div>
        </div>
        <%= button_to "Rotate preview links", workshop_rotate_design_preview_token_configuration_path, method: :post,
              class: "clar-btn !text-[12px] !py-1.5 !px-3 flex-none whitespace-nowrap",
              form: { data: { turbo_confirm: "Rotate the preview links? Every link sent so far, including those in Jira, will stop working." } } %>
      </div>
    </div>
  </div>
<% end %>
