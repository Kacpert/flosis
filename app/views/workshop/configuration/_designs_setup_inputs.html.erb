<%# Staff only (rendered by _designs_tab for staff; the controller 404s
    anyone else). Role passwords are never rendered back. %>
<div class="clar-card p-4.5" data-design-setup-inputs>
  <div class="font-bold text-[14px] clar-text-text mb-1">Setup run inputs <span class="clar-badge clar-badge-primary ml-1">Flosis staff</span></div>
  <div class="text-[12.5px] clar-text-muted mb-4">What a setup run reads to recreate the app in the design repo: the running app, logged in as each role, Figma files and other materials.</div>
  <div class="mb-5">
    <% if project.design_setups.active.exists? %>
      <%= link_to "Open setup run", workshop_design_setup_path, class: "clar-btn no-underline" %>
    <% else %>
      <%= button_to "Start setup run", start_workshop_design_setup_path, class: "clar-btn",
                    form: { data: { turbo_confirm: "Start a setup run? It crawls the app as each role, then works on wip/setup." } } %>
    <% end %>
  </div>

  <%= form_with model: project, url: workshop_design_setup_inputs_path, method: :patch, multipart: true, class: "flex flex-col gap-1.5 mb-5" do |f| %>
    <%= f.label :design_app_url, "APP URL", class: "clar-field-label" %>
    <%= f.url_field :design_app_url, class: "clar-input clar-mono mb-3", placeholder: "https://app.example.com" %>

    <%= f.label :design_figma_urls, "FIGMA FILES", class: "clar-field-label" %>
    <%= f.text_area :design_figma_urls, value: Array(project.design_figma_urls).join("\n"), rows: 3,
                    class: "clar-textarea clar-mono mb-1", placeholder: "One Figma URL per line" %>
    <div class="text-[11px] clar-text-faint mb-3">One URL per line.</div>

    <%= f.label :design_materials, "MATERIALS", class: "clar-field-label" %>
    <%= f.file_field :design_materials, multiple: true, class: "text-[12.5px] mb-3" %>

    <%= f.submit "Save inputs", class: "clar-btn clar-btn-primary self-start" %>
  <% end %>

  <% if project.design_materials.attached? %>
    <div class="flex flex-col gap-1.5 mb-5">
      <% project.design_materials.each do |material| %>
        <div class="flex items-center justify-between gap-3 text-[12.5px]">
          <span class="clar-text-text"><%= material.filename %></span>
          <%= button_to "Remove", remove_material_workshop_design_setup_inputs_path, method: :delete,
                        params: { attachment_id: material.id }, class: "clar-btn !text-[12px] !py-1 !px-2.5" %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="clar-field-label">ROLES</div>
  <div class="text-[11px] clar-text-faint mb-2.5">The crawl logs in as each one. Passwords are write-only: leave blank to keep.</div>
  <div class="flex flex-col gap-3">
    <% project.design_setup_roles.each do |role| %>
      <div class="border clar-divider rounded-[10px] p-3">
        <%= form_with scope: :role, url: update_role_workshop_design_setup_inputs_path, method: :patch, class: "grid gap-2 grid-cols-1 md:grid-cols-2" do |f| %>
          <%= hidden_field_tag :id, role.id %>
          <%= f.text_field :name, value: role.name, class: "clar-input", placeholder: "Name" %>
          <%= f.url_field :login_url, value: role.login_url, class: "clar-input clar-mono", placeholder: "Login URL" %>
          <%= f.text_field :username, value: role.username, class: "clar-input", autocomplete: "off", placeholder: "Username" %>
          <%= f.password_field :password, value: nil, class: "clar-input", autocomplete: "new-password", placeholder: "Leave blank to keep" %>
          <%= f.text_area :notes, value: role.notes, rows: 1, class: "clar-textarea md:col-span-2", placeholder: "Notes (what this role can see)" %>
          <%= f.submit "Save role", class: "clar-btn !text-[12px] !py-1.5 justify-self-start" %>
        <% end %>
        <%= button_to "Remove role", remove_role_workshop_design_setup_inputs_path, method: :delete, params: { id: role.id },
                      class: "clar-btn clar-btn-danger !text-[12px] !py-1 !px-2.5 mt-2",
                      form: { data: { turbo_confirm: "Remove #{role.name}?" } } %>
      </div>
    <% end %>

    <%= form_with scope: :role, url: add_role_workshop_design_setup_inputs_path, class: "grid gap-2 grid-cols-1 md:grid-cols-2 border border-dashed clar-divider rounded-[10px] p-3" do |f| %>
      <%= f.text_field :name, class: "clar-input", placeholder: "Name, e.g. Admin" %>
      <%= f.url_field :login_url, class: "clar-input clar-mono", placeholder: "Login URL" %>
      <%= f.text_field :username, class: "clar-input", autocomplete: "off", placeholder: "Username" %>
      <%= f.password_field :password, class: "clar-input", autocomplete: "new-password", placeholder: "Password" %>
      <%= f.text_area :notes, rows: 1, class: "clar-textarea md:col-span-2", placeholder: "Notes (what this role can see)" %>
      <%= f.submit "Add role", class: "clar-btn !text-[12px] !py-1.5 justify-self-start" %>
    <% end %>
  </div>
</div>
