<%# The AI costs card (design component ai-costs-card, SCRUM-70): whether this
    person sees what Claude costs on the thing itself. The switch is the
    Workshop's own (.clar-toggle) and saves the moment it is flipped: it
    submits the opposite of what is stored. While the organization hides costs
    for everyone, it is drawn off and unusable with UNAVAILABLE under it; the
    personal setting is remembered underneath. %>
<% allowed = current_workspace.ai_costs_enabled? %>
<% shown = allowed && current_user.show_ai_costs? %>
<% admin = workspace_admin? %>
<% organizations = current_user.workspaces.order(:name).to_a %>
<% wallet = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-none" aria-hidden="true"><path d="M3 7h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 7V6a2 2 0 0 1 2-2h11"/></svg>'.html_safe %>
<% configuration_link = admin ? link_to("Configuration › AI", workshop_configuration_path(tab: "ai"), class: "font-semibold clar-text-primary no-underline") : "Configuration › AI" %>
<% consumption_link = link_to("Consumption", workshop_consumption_path, class: "font-semibold clar-text-primary no-underline") %>
<section class="clar-card mt-4.5 p-4.5" data-ai-costs-card>
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-60 flex-1">
      <h2 class="m-0 text-[14px] font-bold clar-text-text">AI costs</h2>
      <p class="mt-1 mb-0 text-[12.5px] leading-[1.4] clar-text-muted">
        Show what Claude costs on the thing itself: a task conversation, a PR review, an AI estimate, a design
        thread, a design import and a bug analysis &mdash; and each area&rsquo;s month in its own tab.
        <% if organizations.size > 1 %>
          This choice is yours in <%= organizations.size == 2 ? "both organizations" : "every organization you are in" %>.
        <% end %>
      </p>
    </div>

    <%= form_with model: current_user, url: workshop_profile_path, method: :patch, class: "flex flex-col items-end gap-1.5" do |f| %>
      <%= f.hidden_field :show_ai_costs, value: current_user.show_ai_costs? ? "0" : "1", id: nil %>
      <button type="submit" role="switch" aria-checked="<%= shown %>"
              aria-label="<%= allowed ? "Show AI costs on my screens" : "Show AI costs on my screens — off for the whole organization" %>"
              class="clar-toggle flex-none disabled:cursor-not-allowed disabled:opacity-50" <%= "disabled" unless allowed %>>
        <span class="knob" aria-hidden="true"></span>
      </button>
      <% unless allowed %>
        <span class="text-[11px] font-bold tracking-[.4px] clar-text-faint">UNAVAILABLE</span>
      <% end %>
    <% end %>
  </div>

  <% if !allowed %>
    <div class="mt-3.5 flex items-start gap-2 rounded-[10px] bg-[color:var(--warn-soft)] px-3.25 py-2.75">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-0.5 flex-none clar-text-warn" aria-hidden="true"><path d="M3 3l18 18M10.6 5.1A9.6 9.6 0 0 1 12 5c5 0 9 4.5 9 7 0 .9-.5 2-1.4 3.1M6.3 7.4C3.9 9 2 11.2 2 12c0 2.5 4 7 10 7 1.6 0 3-.3 4.3-.8"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg>
      <span class="text-[12.5px] leading-[1.4] clar-text-text">
        <b class="font-bold clar-text-warn">Costs are off for the whole organization.</b>
        <%= current_workspace.name %> has turned cost display off in Configuration &rsaquo; AI, so nobody sees a
        price or a token figure anywhere in the product &mdash; whatever each person has chosen here.
      </span>
    </div>
    <% if admin %>
      <p class="mt-3 mb-0 border-t border-[color:var(--border)] pt-3 text-[11.5px] leading-[1.4] clar-text-faint">
        You are an organization administrator, so you can turn it back on in <%= configuration_link %>.
        The organization&rsquo;s own total is on <%= consumption_link %>, which this switch never hides.
      </p>
    <% end %>
  <% elsif organizations.size > 1 %>
    <%# The choice travels with the person; whether it does anything is each
        organization's own switch, so both are named. %>
    <div class="mt-3 flex flex-col gap-1.5 border-t border-[color:var(--border)] pt-3">
      <% organizations.each do |workspace| %>
        <div class="flex flex-wrap items-center gap-2 text-[11.5px] clar-text-faint">
          <% if workspace.ai_costs_enabled? %>
            <span class="clar-badge clar-badge-success">SHOWN</span>
            <b class="font-semibold clar-text-text"><%= workspace.name %></b> &mdash;
            <% if workspace == current_workspace %>
              you are working here, so costs appear.
              <%= consumption_link if admin %>
            <% else %>
              costs appear while you are in it.
            <% end %>
          <% else %>
            <span class="clar-badge clar-badge-muted">OFF FOR EVERYONE</span>
            <b class="font-semibold clar-text-text"><%= workspace.name %></b> &mdash; its administrators have turned
            cost display off, so nothing shows there while you are in it.
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# The three shapes the figure takes, so turning it on holds no surprise. %>
    <div class="mt-3.5 flex flex-col gap-1.5 rounded-[10px] border border-[color:var(--border)] bg-[color:var(--bg)] px-3.25 py-2.75">
      <span class="inline-flex items-center gap-1.25 text-[11.5px] clar-text-faint"><%= wallet %><b class="font-semibold clar-text-text">$0.68</b> &mdash; the total so far, all of it spent this month.</span>
      <span class="inline-flex items-center gap-1.25 text-[11.5px] clar-text-faint"><%= wallet %><b class="font-semibold clar-text-text">$1.86 ($0.94 this month)</b> &mdash; older than this month, so the month is named.</span>
      <span class="inline-flex items-center gap-1.25 text-[11.5px] clar-text-faint"><%= wallet %><b class="font-semibold clar-text-text">$0.74 (none this month)</b> &mdash; nothing has been spent on it since the month turned.</span>
    </div>

    <p class="mt-3 mb-0 border-t border-[color:var(--border)] pt-3 text-[11.5px] leading-[1.4] clar-text-faint">
      <b class="font-semibold clar-text-text"><%= current_workspace.name %> shows AI costs.</b> An organization
      administrator can turn them off for everyone in <%= configuration_link %>; this setting only works while that
      one is on.<% if admin %> What the organization spends in total is on <%= consumption_link %>.<% end %>
    </p>
  <% end %>
</section>
