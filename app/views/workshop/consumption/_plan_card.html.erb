<%# The month's total against the plan. The plan's monthly price is the limit;
    going over it blocks nothing, so the card says so where somebody would
    otherwise fear it did. Then the three notes that keep the arithmetic honest. %>
<%# locals: (limit:) %>
<% total = @summary.total %>
<% cap = limit&.limit_usd %>
<% percent = consumption_percent(total, cap) %>
<% current_plan = limit&.ai_plan_id.present? && limit.ai_plan_id == current_workspace.ai_plan_id %>
<section class="clar-card mb-4.5 p-4.5" data-plan-card>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="mb-1 text-[11px] font-bold tracking-[.4px] clar-text-faint">USED IN <%= @month.strftime("%B").upcase %></div>
      <div class="flex items-baseline gap-2.5">
        <span class="text-[30px] font-bold tracking-[-.5px] clar-text-text"><%= AiCostFormatter.money(total) %></span>
        <span class="text-[14px] clar-text-muted"><%= cap ? "of #{AiCostFormatter.money(cap)}" : "no limit set" %></span>
      </div>
    </div>
    <div class="text-right">
      <div class="mb-1 text-[11px] font-bold tracking-[.4px] clar-text-faint">PLAN</div>
      <% if limit&.plan_name %>
        <div class="text-[13.5px] font-semibold clar-text-text"><%= limit.plan_name %> &middot; <%= AiCostFormatter.money(cap) %> / month</div>
        <% if current_plan && current_workspace.ai_plan_assigned_at %>
          <div class="mt-[3px] text-[11.5px] clar-text-faint">assigned <%= current_workspace.ai_plan_assigned_at.strftime("%-d %b %Y") %></div>
        <% end %>
      <% else %>
        <span class="clar-badge clar-badge-muted">NO PLAN</span>
        <div class="mt-[3px] text-[11.5px] clar-text-faint">Flosis assigns the plan &middot; usage is priced until then</div>
      <% end %>
    </div>
  </div>

  <% if cap %>
    <div class="mt-3.5 h-2.5 w-full overflow-hidden rounded-full bg-[var(--surface-2)]" role="img" aria-label="<%= percent %>% of the monthly limit used">
      <div class="h-full rounded-full <%= total > cap ? 'bg-[var(--warn)]' : 'bg-[var(--primary)]' %>" style="width: <%= [ percent, 100 ].min %>%;"></div>
    </div>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-2.5">
      <span class="text-[12.5px] clar-text-muted">
        <%= percent %>% of the limit &middot;
        <% if total > cap %>
          <b class="font-semibold clar-text-warn"><%= AiCostFormatter.money(total - cap) %> over</b>
        <% else %>
          <b class="font-semibold clar-text-text"><%= AiCostFormatter.money(cap - total) %> left</b>
        <% end %>
      </span>
      <span class="text-[11.5px] clar-text-faint">
        <%= @month < Date.current.beginning_of_month ? "#{@month.strftime('%B')} is closed — a past month never changes." : "Nothing is ever blocked at the limit — going over is only shown here." %>
      </span>
    </div>
  <% else %>
    <div class="mt-3.5 rounded-[10px] bg-[var(--surface-2)] px-3.5 py-3 text-[12.5px] clar-text-muted">
      <b class="clar-text-text"><%= current_workspace.name %> has no plan assigned</b>, so there is no monthly limit and no plan
      price. Every run is still recorded and priced, and these figures stand once a plan arrives &mdash; past months never
      change. Ask Flosis to assign one.
    </div>
  <% end %>

  <div class="mt-4 grid grid-cols-1 gap-2.5 border-t border-[color:var(--border)] pt-4 md:grid-cols-3">
    <%= render "workshop/consumption/note", label: "What you are charged" do %>
      Every AI run the organization made, priced on the plan that stood on the day it ran.
    <% end %>
    <%= render "workshop/consumption/note", label: "On their own key" do %>
      <% if @summary.own_key_projects.any? %>
        <b class="font-semibold clar-text-text"><%= AiCostFormatter.money(@summary.own_key_total) %></b>
        on <%= @summary.own_key_projects.map(&:first).to_sentence %> &mdash; recorded, marked
        <b class="font-semibold clar-text-text">own key</b>, not counted toward the limit.
      <% else %>
        No project ran on its own Anthropic key in <%= @month.strftime("%B") %>.
      <% end %>
    <% end %>
    <%= render "workshop/consumption/note", label: "Unknown cost", warn: @summary.unknown_runs.positive? do %>
      <% if @summary.unknown_runs.positive? %>
        <b class="font-semibold clar-text-text"><%= pluralize(@summary.unknown_runs, "run") %></b> came back with no cost.
        Their tokens are kept, the price shows as unknown, and none counts as $0.
      <% else %>
        No run in <%= @month.strftime("%B") %> came back without a cost.
      <% end %>
    <% end %>
  </div>
</section>
