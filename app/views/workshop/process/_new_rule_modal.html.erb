<div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="new-alert-rule"
     data-action="click->clar-modal#close">
  <%# Grows with its content (the Send-notification switch reveals the channel
      picker) and only scrolls once it genuinely can't fit the viewport — the
      overlay's own 24px padding is what the calc() subtracts. %>
  <div class="clar-modal p-5.5 max-w-[520px] max-h-[calc(100vh-48px)] overflow-y-auto" data-action="click->clar-modal#stopPropagation">
    <div class="flex items-center justify-between mb-1">
      <h2 class="text-lg font-bold clar-text-text m-0">New alert rule</h2>
      <button type="button" class="clar-text-faint flex p-1" data-action="clar-modal#close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <p class="text-[13px] leading-normal clar-text-muted mb-4.5">A scheduled prompt. On its schedule the AI inspects the live Jira board state and posts to the channel only if the condition is met.</p>

    <%= form_with model: AlertRule.new, url: workshop_alert_rules_path, method: :post,
          data: { controller: "clar-required clar-alert-rule-form", turbo: false } do |f| %>
      <label class="clar-field-label">NAME <span class="clar-text-danger">*</span></label>
      <%= f.text_field :name, value: nil, autofocus: true, placeholder: "e.g. QA backlog watch",
            class: "clar-input !text-[14px] mb-4", data: { clar_required_target: "input", action: "input->clar-required#toggle" } %>

      <label class="clar-field-label">WHAT TO WATCH FOR <span class="clar-text-danger">*</span></label>
      <%= f.text_area :prompt, value: nil, rows: 3,
            placeholder: "If more than 4 tasks have been in QA for longer than 3 days, send a notification.",
            class: "clar-textarea mb-1.5" %>
      <div class="text-[11px] clar-text-faint mb-4">Write it as a condition &mdash; natural language is fine.</div>

      <%= render "workshop/process/schedule_builder", rule: AlertRule.new %>

      <%# Notifications are opt-in: flip the switch ON to reveal the channel
          picker. Off = the automation runs but posts nothing. %>
      <div data-controller="clar-notify-toggle" class="mb-5.5">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="clar-field-label !mb-1">Send notification</div>
            <p class="text-[12.5px] leading-normal clar-text-muted m-0">Post to Discord when the condition is met. Off &mdash; runs are only logged in history.</p>
          </div>
          <input type="hidden" name="alert_rule[notify_enabled]" value="0">
          <input type="checkbox" name="alert_rule[notify_enabled]" value="1" class="sr-only"
                 data-clar-notify-toggle-target="input" data-action="change->clar-notify-toggle#sync">
          <button type="button" class="clar-toggle mt-0.5" data-clar-notify-toggle-target="button"
                  aria-checked="false" aria-label="Send a Discord notification"
                  data-action="clar-notify-toggle#toggle">
            <span class="knob"></span>
          </button>
        </div>

        <div data-clar-notify-toggle-target="channels" class="hidden mt-4">
          <label class="clar-field-label">DEFAULT CHANNEL <span class="font-medium clar-text-faint">&middot; Discord</span></label>
          <% if @discord_webhooks.present? %>
            <div class="flex flex-wrap gap-1.5">
              <% @discord_webhooks.each_with_index do |webhook, i| %>
                <label class="clar-chip <%= "clar-chip-active" if i.zero? %>" data-clar-alert-rule-form-target="channelChip" data-action="click->clar-alert-rule-form#selectChannel">
                  <input type="radio" name="alert_rule[discord_webhook_id]" value="<%= webhook.id %>" <%= "checked" if i.zero? %> class="hidden">
                  <%= webhook.channel_name %>
                </label>
              <% end %>
            </div>
          <% else %>
            <div class="text-[12.5px] clar-text-muted">
              No Discord webhooks configured yet.
              <%= link_to "Go to Configuration → Integrations → Discord", workshop_configuration_path, class: "font-semibold clar-text-primary no-underline" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex gap-2.5 justify-end">
        <button type="button" class="clar-btn" data-action="clar-modal#close">Cancel</button>
        <%= f.submit "Create rule", class: "clar-btn clar-btn-primary", disabled: true,
              data: { clar_required_target: "submit" } %>
      </div>
    <% end %>
  </div>
</div>
