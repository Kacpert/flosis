<% content_for :title, "Agents & Automations · Flosis" %>

<%# The title's row carries the open tab's area cost at its right end (SCRUM-70). %>
<div class="flex flex-wrap items-baseline justify-between gap-x-5 gap-y-1">
  <h1 class="clar-h1">Agents &amp; Automations</h1>
  <%= render "workshop/shared/area_cost", area: { "pr" => "pr_reviews", "estimate" => "estimates", "alerts" => "agents" }.fetch(@tab) %>
</div>
<p class="clar-sub">Three AI automations watching this project. They comment and propose — humans decide.</p>

<div class="clar-tabs mb-6">
  <%= link_to "AI PR Reviews", workshop_process_path(tab: "pr"),
        class: "clar-tab #{'clar-tab-active' if @tab == 'pr'}" %>
  <%= link_to "AI Estimate", workshop_process_path(tab: "estimate"),
        class: "clar-tab #{'clar-tab-active' if @tab == 'estimate'}" %>
  <%= link_to "AI Agents & Alerts", workshop_process_path(tab: "alerts"),
        class: "clar-tab #{'clar-tab-active' if @tab == 'alerts'}" %>
</div>

<% if @tab == "pr" %>
  <%= render "pr_tab" %>
<% elsif @tab == "estimate" %>
  <%= render "estimate_tab" %>
<% else %>
  <%= render "alerts_tab" %>
<% end %>
