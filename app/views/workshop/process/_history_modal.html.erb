<turbo-frame id="clar-alert-history-<%= @alert_rule.id %>" class="overflow-auto flex-1 flex flex-col">
  <div class="px-[22px] py-[18px] border-b clar-divider">
    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="font-bold text-[17px] clar-text-text"><%= @alert_rule.name %></div>
        <div class="text-[12.5px] clar-text-muted mt-1 italic">&ldquo;<%= @alert_rule.prompt %>&rdquo;</div>
      </div>
      <button type="button" class="clar-text-faint flex p-1 flex-none" data-action="clar-modal#close" aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex gap-4 mt-3.5 flex-wrap">
      <span class="inline-flex items-center gap-1.5 text-[12px] clar-text-faint">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        <%= @alert_rule.schedule_label %>
      </span>
      <span class="inline-flex items-center gap-1.5 text-[12px] clar-text-faint">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        <%# Notifications are opt-in — a rule with them off has no webhook. %>
        <% if @alert_rule.notify_enabled? && @alert_rule.discord_webhook %>
          <%= @alert_rule.discord_webhook.channel_name %> &middot; Discord
        <% else %>
          Notifications off
        <% end %>
      </span>
      <span class="text-[12px] clar-text-faint">Fired <%= @fired_count %> of <%= @runs.size %> runs</span>
    </div>
  </div>

  <div class="flex-1 overflow-y-auto px-[22px] py-2">
    <div class="text-[11px] font-bold tracking-[.4px] clar-text-faint py-3">RUN HISTORY</div>
    <% if @runs.empty? %>
      <div class="text-[13px] clar-text-faint italic pb-4">No runs yet.</div>
    <% else %>
      <% @runs.each_with_index do |run, i| %>
        <div class="flex gap-3 py-3 <%= "border-b border-[color:var(--border)]" unless i == @runs.size - 1 %>">
          <span class="flex-none w-[26px] h-[26px] rounded-full flex items-center justify-center mt-0.5 <%= run.fired? ? "bg-[color:var(--success-soft)] text-[color:var(--success)]" : "bg-[color:var(--surface-2)] clar-text-faint" %>">
            <% if run.fired? %>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <% else %>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
            <% end %>
          </span>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2.5">
              <span class="font-semibold text-[13px] clar-text-text"><%= run.summary.presence || (run.status == "error" ? "Run failed" : "No condition met") %></span>
              <span class="text-[10.5px] font-bold px-2 py-0.5 rounded-[6px] whitespace-nowrap <%= run.fired? ? "text-[color:var(--success)] bg-[color:var(--success-soft)]" : "clar-text-faint bg-[color:var(--surface-2)]" %>">
                <%= run.fired? ? "NOTIFIED" : "NO ACTION" %>
              </span>
            </div>
            <div class="text-[11.5px] clar-text-faint mt-0.5"><%= clar_time_ago(run.ran_at) %></div>
            <% if run.detail.present? %>
              <div class="text-[12px] clar-text-muted leading-relaxed mt-1"><%= run.detail %></div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="px-[22px] py-3.5 border-t clar-divider flex justify-end">
    <button type="button" class="clar-btn" data-action="clar-modal#close">Close</button>
  </div>
</turbo-frame>
