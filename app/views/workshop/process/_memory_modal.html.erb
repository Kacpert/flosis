<%# Read-only view of an automation's AI-managed memory + reported issues, for
    debugging. Loaded into a turbo-frame from the rule card's "Memory" button.
    Memory is NOT editable — only viewable and clearable. `rule` is the AlertRule. %>
<turbo-frame id="clar-alert-memory-<%= rule.id %>" class="overflow-auto flex-1 flex flex-col">
  <div class="px-[22px] py-[18px] border-b clar-divider">
    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="font-bold text-[17px] clar-text-text"><%= rule.name %> · memory</div>
        <div class="text-[12px] clar-text-faint mt-1">The AI manages this itself across runs. Read-only — clear it to make the automation rebuild from scratch.</div>
      </div>
      <%# turbo_frame "_top": this button lives INSIDE the lazy memory frame, so a
          plain submit makes Turbo swap the frame for the redirect's copy of
          itself — which is the "Loading memory…" placeholder, and being lazy
          inside a hidden modal it never loads. The modal then sits there empty
          until a full refresh. Reload the page instead. %>
      <%= button_to clear_memory_workshop_alert_rule_path(rule), method: :post,
            form: { data: { turbo_frame: "_top",
                            turbo_confirm: "Clear this automation's memory? It will rebuild from scratch on the next run." } },
            class: "clar-btn !py-[5px] !px-[10px] !text-[12px] clar-text-danger whitespace-nowrap" do %>
        Clear memory
      <% end %>
    </div>
  </div>

  <div class="px-[22px] py-4 overflow-auto flex-1 flex flex-col gap-4">
    <% if rule.ai_issues_text.present? %>
      <div>
        <div class="flex items-center justify-between gap-3 mb-1.5">
          <div class="text-[11px] font-bold tracking-[.4px] clar-text-danger">⚠ ISSUES REPORTED BY THE AI</div>
          <%# The report only changes on the automation's next run, so a problem
              you have already fixed keeps this card flagged red for hours.
              Dismiss it on its own — the memory is untouched. %>
          <%= button_to clear_ai_issues_workshop_alert_rule_path(rule), method: :post,
                form: { data: { turbo_frame: "_top",
                                turbo_confirm: "Dismiss the reported issues? The memory is kept — the AI will report again on the next run if the problem is still there." } },
                class: "clar-btn !py-[3px] !px-[9px] !text-[11.5px] clar-text-muted whitespace-nowrap" do %>
            Dismiss
          <% end %>
        </div>
        <pre class="text-[12px] leading-[1.5] whitespace-pre-wrap break-words clar-mono px-3.5 py-3 rounded-[10px] bg-[var(--danger-soft)] border border-[color:var(--danger)] clar-text-text"><%= rule.ai_issues_text %></pre>
      </div>
    <% end %>

    <div>
      <div class="text-[11px] font-bold tracking-[.4px] clar-text-faint mb-1.5">MEMORY (<%= number_to_human_size(rule.memory_text.bytesize) %> / 200 KB)</div>
      <% if rule.memory_text.present? %>
        <pre class="text-[12px] leading-[1.5] whitespace-pre-wrap break-words clar-mono px-3.5 py-3 rounded-[10px] bg-[var(--surface-2)] border clar-divider clar-text-text"><%= rule.memory_text %></pre>
      <% else %>
        <div class="text-[13px] clar-text-faint italic">No memory yet — the automation hasn't stored anything (runs once, then it fills in).</div>
      <% end %>
    </div>
  </div>
</turbo-frame>
