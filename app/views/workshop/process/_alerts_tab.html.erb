<div data-controller="clar-modal">
  <div class="flex items-center justify-between mb-3.5">
    <% paused_count = @alert_rules.count { |r| !r.active? } %>
    <span class="text-[13px] clar-text-muted"><%= pluralize(@alert_rules.size, "rule") %><% if paused_count.positive? %> &middot; <%= paused_count %> paused<% end %> &middot; scheduled prompts that notify a channel when conditions are met</span>
    <button type="button" class="clar-btn clar-btn-primary !gap-1.5 !py-[9px] !px-3.5" data-action="clar-modal#open" data-clar-modal-id-param="new-alert-rule">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      New rule
    </button>
  </div>

  <% if @alert_rules.empty? %>
    <div class="clar-card p-8 text-center clar-text-muted text-[13.5px]" data-empty>No alert rules yet.</div>
  <% else %>
    <div class="flex flex-col gap-3">
      <% @alert_rules.each do |rule| %>
        <div class="clar-row clar-row-hover !rounded-[13px] py-4 px-4.5">
          <%# Top row: name (left) + last-run status chip and the pause switch
              (right). A paused rule is kept in full — prompt, schedule, memory
              and history — it just stops being dispatched, so the card only
              dims and swaps its status chip for "Paused". %>
          <div class="flex items-center justify-between gap-3.5 mb-[9px]">
            <%# The name dims too when paused, but less than the body — it stays
                the card's identifier, so it must remain easy to scan. %>
            <span class="font-[650] text-[14px] clar-text-text <%= "opacity-65" unless rule.active? %>"><%= rule.name %></span>
            <div class="flex items-center gap-3">
              <% if rule.active? %>
                <span class="inline-flex items-center gap-1.5 text-[11.5px] font-semibold <%= alert_last_run_color_class(rule.last_run_status) %>">
                  <span class="w-1.5 h-1.5 rounded-full bg-current"></span><%= rule.last_run_chip_label %>
                </span>
              <% else %>
                <span class="inline-flex items-center gap-1.5 text-[11.5px] font-semibold clar-text-faint">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 5v14M15 5v14"/></svg>
                  Paused
                </span>
              <% end %>
              <%= button_to toggle_active_workshop_alert_rule_path(rule), method: :patch,
                    class: "clar-toggle", form: { class: "inline-flex" },
                    title: rule.active? ? "Pause this automation" : "Resume this automation",
                    aria: { checked: rule.active?.to_s, label: "#{rule.active? ? 'Pause' : 'Resume'} #{rule.name}" } do %>
                <span class="knob"></span>
              <% end %>
            </div>
          </div>
          <div class="text-[13px] clar-text-muted leading-[1.5] mb-3 italic <%= "opacity-55" unless rule.active? %>">&ldquo;<%= rule.prompt %>&rdquo;</div>
          <%# Footer: schedule · channel · last run on the left, then Edit +
              View history as buttons on the right. %>
          <div class="flex gap-[18px] text-[12px] clar-text-faint flex-wrap items-center <%= "opacity-55" unless rule.active? %>">
            <span class="inline-flex items-center gap-1.5">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
              <%= rule.schedule_label %>
            </span>
            <%# A rule with notifications off has no webhook — say so rather
                than rendering an empty channel. %>
            <% if rule.notify_enabled? && rule.discord_webhook %>
              <span class="inline-flex items-center gap-1.5">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <%= rule.discord_webhook.channel_name %> &middot; Discord
              </span>
            <% else %>
              <span class="inline-flex items-center gap-1.5 opacity-80">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13.73 21a2 2 0 0 1-3.46 0M18.63 13A17.9 17.9 0 0 1 18 8M6.26 6.26A5.86 5.86 0 0 0 6 8c0 7-3 9-3 9h14M18 8a6 6 0 0 0-9.33-5M1 1l22 22"/></svg>
                Notifications off
              </span>
            <% end %>
            <span>Last run <%= clar_time_ago(rule.last_run_at) || "&mdash;".html_safe %></span>
            <span class="flex-1"></span>
            <%# Footer actions: the design draws these at 12px/600 in a 7px-radius
                outline button, and turns Memory red when the AI reported issues. %>
            <% footer_btn = "inline-flex items-center gap-[5px] text-[12px] font-semibold rounded-[7px] py-1 px-2.5 cursor-pointer bg-[color:var(--surface)] border" %>
            <% flagged = rule.ai_issues_text.present? %>
            <button type="button" title="View this automation's AI memory"
                    class="<%= footer_btn %> <%= flagged ? 'border-[color:var(--danger)] clar-text-danger' : 'clar-divider clar-text-muted' %>"
                    data-action="click->clar-modal#open" data-clar-modal-id-param="alert-memory-<%= rule.id %>">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Memory
              <% if flagged %>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></svg>
              <% end %>
            </button>
            <button type="button" title="Edit this rule"
                    class="<%= footer_btn %> clar-divider clar-text-muted"
                    data-action="click->clar-modal#open" data-clar-modal-id-param="edit-alert-rule-<%= rule.id %>">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>
              Edit
            </button>
            <%# The design renders "View history" as a plain primary-coloured
                affordance, not an outlined button. %>
            <button type="button" title="View this rule's run history"
                    class="inline-flex items-center gap-[5px] text-[12px] font-semibold clar-text-primary bg-transparent border-0 p-0 cursor-pointer"
                    data-action="click->clar-modal#open" data-clar-modal-id-param="alert-history-<%= rule.id %>">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 8v4l3 2M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0"/></svg>
              View history
            </button>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= render "new_rule_modal" %>

  <% @alert_rules.each do |rule| %>
    <%= render "edit_rule_modal", rule: rule %>
  <% end %>

  <% @alert_rules.each do |rule| %>
    <div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="alert-history-<%= rule.id %>"
         data-action="click->clar-modal#close">
      <div class="clar-modal max-w-[560px] max-h-[86vh] overflow-hidden flex flex-col" data-action="click->clar-modal#stopPropagation">
        <turbo-frame id="clar-alert-history-<%= rule.id %>" src="<%= history_workshop_alert_rule_path(rule) %>" loading="lazy" class="overflow-auto flex-1 flex flex-col">
          <div class="p-8.5 text-center clar-text-faint text-[13px]">Loading history&hellip;</div>
        </turbo-frame>
      </div>
    </div>
  <% end %>

  <% @alert_rules.each do |rule| %>
    <div class="hidden clar-modal-overlay" data-clar-modal-target="panel" data-clar-modal-panel-id-value="alert-memory-<%= rule.id %>"
         data-action="click->clar-modal#close">
      <div class="clar-modal max-w-[640px] max-h-[86vh] overflow-hidden flex flex-col" data-action="click->clar-modal#stopPropagation">
        <turbo-frame id="clar-alert-memory-<%= rule.id %>" src="<%= memory_workshop_alert_rule_path(rule) %>" loading="lazy" class="overflow-auto flex-1 flex flex-col">
          <div class="p-8.5 text-center clar-text-faint text-[13px]">Loading memory&hellip;</div>
        </turbo-frame>
      </div>
    </div>
  <% end %>
</div>
