<div class="space-y-5">
  <div class="flex justify-between items-center">
    <div class="flex items-center gap-3">
      <%= project_color_dot(@project.color) %>
      <h1 class="text-2xl font-bold tracking-tight"><%= @project.name %></h1>
      <% if @project.client %>
        <span class="text-base-content/45">·</span>
        <span class="text-sm text-base-content/50"><%= @project.client.name %></span>
      <% end %>
    </div>
    <div class="flex gap-2">
      <%= link_to "Edit", edit_project_path(@project), class: "btn btn-ghost btn-sm" %>
      <%= link_to "Back", projects_path, class: "btn btn-ghost btn-sm" %>
    </div>
  </div>

  <%# Stats %>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
    <div class="stat-card">
      <div class="stat-label">Total Time</div>
      <div class="stat-number"><%= format_duration_hm(@total_seconds) %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Tasks</div>
      <div class="stat-number"><%= @tasks.size %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Billable</div>
      <div class="stat-number"><%= @project.billable? ? "Yes" : "No" %></div>
    </div>
    <% if @project.budget_type != "no_budget" %>
      <div class="stat-card">
        <div class="stat-label">Budget</div>
        <div class="stat-number"><%= @project.budget_percentage %>%</div>
      </div>
    <% end %>
  </div>

  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem;">
    <%# Tasks %>
    <div class="stat-card">
      <h2 class="section-header mb-3">Tasks</h2>
      <div id="tasks-list" class="space-y-1">
        <% @tasks.each do |task| %>
          <%= render "tasks/task", task: task %>
        <% end %>
      </div>
      <%= form_with model: [@project, Task.new], class: "flex gap-2 mt-3" do |f| %>
        <%= f.text_field :name, placeholder: "Add task...", class: "input input-bordered input-sm flex-1 rounded-lg", required: true %>
        <%= f.submit "Add", class: "btn btn-primary btn-sm rounded-lg" %>
      <% end %>
    </div>

    <%# Recent entries %>
    <div class="stat-card">
      <h2 class="section-header mb-3">Recent Entries</h2>
      <% if @time_entries.any? %>
        <div class="space-y-0.5">
          <% @time_entries.each do |entry| %>
            <div class="flex items-center justify-between p-2 rounded-lg hover:bg-base-200/50 transition-colors text-sm">
              <div class="min-w-0">
                <div class="font-medium truncate"><%= entry.description.presence || "No description" %></div>
                <div class="text-xs text-base-content/45">
                  <%= entry.user.name %> · <%= entry.started_at.strftime("%b %-d") %>
                </div>
              </div>
              <span class="mono-duration font-medium text-base-content/60 ml-3"><%= entry.formatted_duration %></span>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-base-content/40 py-4 text-center">No entries yet</p>
      <% end %>
    </div>
  </div>

  <%# Time by Task %>
  <% if @task_time_recap.any? %>
    <div class="stat-card">
      <h2 class="section-header mb-4">Time by Task</h2>
      <% max_seconds = @task_time_recap.map { |_, s| s }.max %>
      <div class="space-y-3">
        <% @task_time_recap.each do |(task_id, task_name, task_status), seconds| %>
          <div>
            <div class="flex justify-between items-center mb-1.5">
              <span class="text-sm font-medium flex items-center gap-2">
                <%= task_name %>
                <% if task_status == "done" %>
                  <span class="text-[10px] font-medium text-base-content/40 bg-base-200/80 px-2 py-0.5 rounded-full">Done</span>
                <% end %>
              </span>
              <span class="text-sm mono-duration text-base-content/60"><%= format_duration_hm(seconds) %></span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-base-200 overflow-hidden">
              <div class="h-full rounded-full bg-primary/70 transition-all" style="width: <%= max_seconds > 0 ? (seconds.to_f / max_seconds * 100).round(1) : 0 %>%"></div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
