<div class="space-y-5">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold tracking-tight" style="color: var(--color-on-surface)">Projects</h1>
    <div class="flex items-center gap-3">
      <label class="flex items-center gap-2 cursor-pointer">
        <%= check_box_tag :show_archived, "1", params[:show_archived] == "1",
            onchange: "window.location.search = this.checked ? '?show_archived=1' : ''",
            class: "m3-checkbox" %>
        <span class="text-sm" style="color: var(--color-on-surface-variant)">Show archived</span>
      </label>
      <%= link_to "New Project", new_project_path, class: "m3-btn m3-btn-filled" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
    <% @projects.each do |project| %>
      <div class="project-card">
        <div class="flex items-start justify-between mb-1">
          <div class="flex items-center gap-2">
            <%= project_color_dot(project.color) %>
            <%= link_to project.name, project_path(project), class: "font-semibold text-sm transition-colors", style: "color: var(--color-on-surface);", onmouseover: "this.style.color='var(--color-primary)'", onmouseout: "this.style.color='var(--color-on-surface)'" %>
          </div>
          <% if project.archived? %>
            <span class="text-[10px] font-medium px-2 py-0.5 rounded-full" style="color: var(--color-outline); background: var(--color-surface-container)">Archived</span>
          <% end %>
        </div>

        <% if project.client %>
          <p class="text-xs ml-5" style="color: var(--color-on-surface-variant)"><%= project.client.name %></p>
        <% end %>

        <div class="flex items-center gap-2 mt-3 ml-5">
          <span class="text-[10px] font-medium px-2 py-0.5 rounded-full" style="color: var(--color-outline); background: var(--color-surface-container)"><%= project.tasks.size %> tasks</span>
        </div>

        <% if project.budget_type != "no_budget" && (project.budget_hours.present? || project.budget_cents.present?) %>
          <div class="mt-3 ml-5">
            <div class="flex justify-between text-[10px] mb-1" style="color: var(--color-on-surface-variant)">
              <span>Budget</span>
              <span class="font-medium"><%= project.budget_percentage %>%</span>
            </div>
            <div class="w-full h-1.5 rounded-full overflow-hidden" style="background: var(--color-surface-container-highest)">
              <div class="h-full rounded-full transition-all" style="width: <%= [project.budget_percentage, 100].min %>%; background-color: <%= project.budget_percentage > 90 ? 'var(--color-error)' : project.budget_percentage > 75 ? '#FB8C00' : 'var(--color-success)' %>"></div>
            </div>
          </div>
        <% end %>

        <div class="flex justify-end gap-1 mt-4 pt-3" style="border-top: 1px solid var(--color-outline-variant)">
          <%= link_to "Edit", edit_project_path(project), class: "m3-btn m3-btn-text m3-btn-sm" %>
          <% if project.archived? %>
            <%= button_to "Restore", unarchive_project_path(project), method: :patch, class: "m3-btn m3-btn-text m3-btn-sm" %>
          <% else %>
            <%= button_to "Archive", archive_project_path(project), method: :patch, class: "m3-btn m3-btn-text m3-btn-sm" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @projects.empty? %>
      <div class="col-span-full empty-state">
        <div class="empty-state-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        </div>
        <p class="empty-state-title">No projects yet</p>
        <p class="empty-state-desc">Create your first project to get started</p>
      </div>
    <% end %>
  </div>
</div>
