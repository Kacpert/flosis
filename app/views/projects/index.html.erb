<div class="space-y-5">
  <div class="flex justify-between items-center">
    <h1 class="text-2xl font-bold tracking-tight">Projects</h1>
    <div class="flex items-center gap-3">
      <label class="flex items-center gap-2 cursor-pointer">
        <%= check_box_tag :show_archived, "1", params[:show_archived] == "1",
            onchange: "window.location.search = this.checked ? '?show_archived=1' : ''",
            class: "checkbox checkbox-sm" %>
        <span class="text-sm text-base-content/60">Show archived</span>
      </label>
      <%= link_to "New Project", new_project_path, class: "btn btn-primary btn-sm" %>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem;">
    <% @projects.each do |project| %>
      <div class="project-card">
        <div class="flex items-start justify-between mb-1">
          <div class="flex items-center gap-2">
            <%= project_color_dot(project.color) %>
            <%= link_to project.name, project_path(project), class: "font-semibold text-sm hover:text-primary transition-colors" %>
          </div>
          <% if project.archived? %>
            <span class="text-[10px] font-medium text-base-content/40 bg-base-200 px-2 py-0.5 rounded-full">Archived</span>
          <% end %>
        </div>

        <% if project.client %>
          <p class="text-xs text-base-content/50 ml-5"><%= project.client.name %></p>
        <% end %>

        <div class="flex items-center gap-2 mt-3 ml-5">
          <% if project.billable? %>
            <span class="text-[10px] font-medium text-success bg-success/10 px-2 py-0.5 rounded-full">Billable</span>
          <% end %>
          <span class="text-[10px] font-medium text-base-content/40 bg-base-200/80 px-2 py-0.5 rounded-full"><%= project.tasks.size %> tasks</span>
        </div>

        <% if project.budget_type != "no_budget" && (project.budget_hours.present? || project.budget_cents.present?) %>
          <div class="mt-3 ml-5">
            <div class="flex justify-between text-[10px] text-base-content/50 mb-1">
              <span>Budget</span>
              <span class="font-medium"><%= project.budget_percentage %>%</span>
            </div>
            <div class="w-full h-1.5 rounded-full bg-base-200 overflow-hidden">
              <div class="h-full rounded-full transition-all <%= project.budget_percentage > 90 ? 'bg-error' : project.budget_percentage > 75 ? 'bg-warning' : 'bg-success' %>"
                   style="width: <%= [project.budget_percentage, 100].min %>%"></div>
            </div>
          </div>
        <% end %>

        <div class="flex justify-end gap-1 mt-4 pt-3 border-t border-base-200/60">
          <%= link_to "Edit", edit_project_path(project), class: "btn btn-ghost btn-xs text-base-content/50" %>
          <% if project.archived? %>
            <%= button_to "Restore", unarchive_project_path(project), method: :patch, class: "btn btn-ghost btn-xs text-base-content/50" %>
          <% else %>
            <%= button_to "Archive", archive_project_path(project), method: :patch, class: "btn btn-ghost btn-xs text-base-content/50" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if @projects.empty? %>
      <div class="col-span-full empty-state">
        <div class="empty-state-icon">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
        </div>
        <p class="empty-state-title">No projects yet</p>
        <p class="empty-state-desc">Create your first project to get started</p>
      </div>
    <% end %>
  </div>
</div>
