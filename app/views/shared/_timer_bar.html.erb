<% if @running_timer %>
  <div class="flex items-center gap-3 w-full" data-controller="timer" data-timer-started-at-value="<%= @running_timer.started_at.iso8601 %>">
    <%= form_with url: update_running_timer_path, method: :patch, class: "flex items-center gap-2.5 flex-1 min-w-0", data: { controller: "auto-save jira-task-search", jira_task_search_jira_connected_value: @running_timer.project&.jira_connected? || false } do |f| %>
      <%# Description in bordered input-like area %>
      <div class="flex items-center gap-2.5 flex-1 min-w-0 px-5 py-2.5 rounded-full relative" style="border: 1px solid var(--color-primary); background: var(--color-surface-container-lowest);">
        <span class="relative flex h-2.5 w-2.5 flex-shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background: var(--color-primary)"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5" style="background: var(--color-primary)"></span>
        </span>
        <%= f.text_field "time_entry[description]", value: @running_timer.description,
            placeholder: "What are you working on?",
            class: "bg-transparent border-none flex-1 min-w-[120px] text-[0.9375rem] font-medium focus:outline-none",
            style: "color: var(--color-on-surface)",
            autocomplete: "off",
            data: { action: "blur->auto-save#save focus->jira-task-search#focus input->jira-task-search#filter keydown->jira-task-search#keydown", jira_task_search_target: "input" } %>
        <%= f.hidden_field "time_entry[task_id]", value: @running_timer.task_id, data: { jira_task_search_target: "taskId" } %>
        <div class="hidden absolute left-0 top-full mt-1 w-full rounded-xl shadow-lg z-50 max-h-64 overflow-y-auto" style="background: var(--color-surface-container); border: 1px solid var(--color-outline-variant);" data-jira-task-search-target="dropdown">
          <div data-jira-task-search-target="list"></div>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-2 flex-shrink-0">
        <div class="m3-timer-pill-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" style="color: var(--color-outline)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.75V12A2.25 2.25 0 014.5 9.75h15A2.25 2.25 0 0121.75 12v.75m-8.69-6.44l-2.12-2.12a1.5 1.5 0 00-1.061-.44H4.5A2.25 2.25 0 002.25 6v12a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9a2.25 2.25 0 00-2.25-2.25h-5.379a1.5 1.5 0 01-1.06-.44z" /></svg>
          <%= f.select "time_entry[project_id]",
              options_from_collection_for_select(Current.workspace&.projects&.active&.order(:name) || [], :id, :name, @running_timer.project_id),
              { include_blank: "Project" },
              class: "m3-timer-pill-select",
              data: { controller: "task-loader", action: "change->task-loader#load change->auto-save#save change->jira-task-search#projectChanged" } %>
        </div>
        <div class="m3-timer-pill-wrap" data-jira-task-select style="<%= @running_timer.project&.jira_connected? ? 'display:none' : '' %>">
          <%= f.select "time_entry[task_id]",
              @running_timer.project ? options_from_collection_for_select(@running_timer.project.tasks.active, :id, :name, @running_timer.task_id) : [],
              { include_blank: "Task" },
              class: "m3-timer-pill-select",
              data: { action: "change->auto-save#save" } %>
        </div>
      </div>

      <div class="hidden md:flex items-center gap-1 flex-shrink-0">
        <button type="button" class="m3-icon-btn m3-icon-btn-sm" title="Tags">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
        </button>
        <button type="button" class="m3-icon-btn m3-icon-btn-sm" title="Edit">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
        </button>
      </div>
    <% end %>

    <div class="flex items-center gap-3 ml-auto flex-shrink-0">
      <span class="mono-duration text-lg font-semibold tracking-tight px-5 py-1.5 rounded-full" data-timer-target="display" style="color: var(--color-on-primary-container); background: var(--color-primary-container);">00:00:00</span>
      <%= button_to stop_timer_path, method: :patch, class: "flex items-center gap-2 px-5 py-2 rounded-full text-sm font-medium border-none cursor-pointer", style: "background: var(--color-error); color: var(--color-on-error);" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
        Stop
      <% end %>
    </div>
  </div>
<% else %>
  <div data-controller="timer-mode" class="w-full">
    <%# Timer mode %>
    <div data-timer-mode-target="timerMode">
      <%= form_with url: start_timer_path, method: :post, class: "flex items-center gap-2 w-full", data: { controller: "jira-task-search" } do |f| %>
        <div class="relative flex-1 min-w-[120px]">
          <%= f.text_field :description, placeholder: "What are you working on?",
              class: "bg-transparent border-none w-full text-[0.9375rem] focus:outline-none",
              style: "color: var(--color-on-surface);",
              autocomplete: "off",
              data: { action: "focus->jira-task-search#focus input->jira-task-search#filter keydown->jira-task-search#keydown", jira_task_search_target: "input" } %>
          <%= f.hidden_field :task_id, data: { jira_task_search_target: "taskId" } %>
          <div class="hidden absolute left-0 top-full mt-1 w-full rounded-xl shadow-lg z-50 max-h-64 overflow-y-auto" style="background: var(--color-surface-container); border: 1px solid var(--color-outline-variant); min-width: 320px;" data-jira-task-search-target="dropdown">
            <div data-jira-task-search-target="list"></div>
          </div>
        </div>

        <div class="h-5 w-px timer-desktop-only" style="background: var(--color-outline-variant)"></div>

        <div class="timer-desktop-only">
          <%= f.select :project_id,
              options_from_collection_for_select(Current.workspace&.projects&.active&.order(:name) || [], :id, :name),
              { include_blank: "Project" },
              class: "m3-timer-pill",
              data: { controller: "task-loader", action: "change->task-loader#load change->jira-task-search#projectChanged" } %>
        </div>

        <div class="timer-desktop-only" data-jira-task-select>
          <%= f.select :task_id, [],
              { include_blank: "Task" },
              class: "m3-timer-pill" %>
        </div>

        <%# Tag button %>
        <div class="relative timer-desktop-only" data-controller="tag-selector">
          <button type="button" tabindex="0" class="m3-icon-btn m3-icon-btn-sm" onclick="this.nextElementSibling.classList.toggle('hidden')">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
          </button>
          <div class="hidden absolute right-0 top-full mt-1 m3-menu z-50 w-48">
            <% (Current.workspace&.tags&.order(:name) || []).each do |tag| %>
              <label class="flex items-center gap-2 p-1.5 rounded-[var(--radius-xs)] cursor-pointer" style="transition: background 0.15s" onmouseover="this.style.background='rgba(28,27,31,0.08)'" onmouseout="this.style.background='transparent'">
                <input type="checkbox" name="tag_ids[]" value="<%= tag.id %>" class="m3-checkbox"
                       data-action="change->tag-selector#update" data-tag-selector-target="checkbox">
                <span class="text-xs" style="color: <%= tag.color %>"><%= tag.name %></span>
              </label>
            <% end %>
          </div>
          <div data-tag-selector-target="hiddenInputs"></div>
        </div>

        <button type="button" class="m3-icon-btn m3-icon-btn-sm" data-action="click->timer-mode#toggle" title="Manual entry">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
        </button>

        <button type="submit" class="m3-fab">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Start
        </button>
      <% end %>
    </div>

    <%# Manual mode %>
    <div data-timer-mode-target="manualMode" class="hidden">
      <%= form_with url: time_entries_path, method: :post, class: "flex items-center gap-2 w-full", data: { controller: "jira-task-search" } do |f| %>
        <input type="hidden" name="time_entry[workspace_id]" value="">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" style="color: var(--color-outline)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" /></svg>
        <div class="relative flex-1 min-w-[100px]">
          <%= f.text_field "time_entry[description]", placeholder: "What did you work on?",
              class: "bg-transparent border-none w-full text-[0.9375rem] focus:outline-none",
              style: "color: var(--color-on-surface)",
              autocomplete: "off",
              data: { action: "focus->jira-task-search#focus input->jira-task-search#filter keydown->jira-task-search#keydown", jira_task_search_target: "input" } %>
          <%= f.hidden_field "time_entry[task_id]", data: { jira_task_search_target: "taskId" } %>
          <div class="hidden absolute left-0 top-full mt-1 w-full rounded-xl shadow-lg z-50 max-h-64 overflow-y-auto" style="background: var(--color-surface-container); border: 1px solid var(--color-outline-variant); min-width: 320px;" data-jira-task-search-target="dropdown">
            <div data-jira-task-search-target="list"></div>
          </div>
        </div>
        <div class="h-5 w-px timer-desktop-only" style="background: var(--color-outline-variant)"></div>
        <div class="timer-desktop-only">
          <%= f.select "time_entry[project_id]",
              options_from_collection_for_select(Current.workspace&.projects&.active&.order(:name) || [], :id, :name),
              { include_blank: "Project" },
              class: "m3-timer-pill",
              data: { controller: "task-loader", action: "change->task-loader#load change->jira-task-search#projectChanged" } %>
        </div>
        <div class="timer-desktop-only" data-jira-task-select>
          <%= f.select "time_entry[task_id]", [],
              { include_blank: "Task" },
              class: "m3-timer-pill" %>
        </div>
        <div class="h-5 w-px timer-desktop-only" style="background: var(--color-outline-variant)"></div>
        <%= f.datetime_local_field "time_entry[started_at]", value: Time.current.strftime("%Y-%m-%dT%H:%M"),
            class: "bg-transparent border-none text-sm focus:outline-none w-[155px] timer-desktop-only",
            style: "color: var(--color-on-surface-variant)" %>
        <%= f.text_field "time_entry[duration_manual]", placeholder: "0:00",
            class: "bg-transparent border-none text-sm focus:outline-none w-14 text-center mono-duration",
            style: "color: var(--color-on-surface-variant)" %>

        <button type="button" class="m3-icon-btn m3-icon-btn-sm" data-action="click->timer-mode#toggle" title="Timer mode">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" /></svg>
        </button>

        <button type="submit" class="m3-fab" style="background: var(--color-success); color: var(--color-on-success);">Save</button>
      <% end %>
    </div>
  </div>
<% end %>
