<% if @running_timer %>
  <div class="flex items-center gap-3 w-full" data-controller="timer" data-timer-started-at-value="<%= @running_timer.started_at.iso8601 %>">
    <div class="flex items-center gap-2">
      <span class="relative flex h-3 w-3">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background: var(--color-error)"></span>
        <span class="relative inline-flex rounded-full h-3 w-3" style="background: var(--color-error)"></span>
      </span>
      <span class="mono-duration text-xl font-bold tracking-tight" data-timer-target="display">00:00:00</span>
    </div>

    <div class="flex items-center gap-2 flex-1 min-w-0">
      <% if @running_timer.project %>
        <span class="flex items-center gap-1.5 px-2 py-1 rounded-[var(--radius-sm)]" style="background: var(--color-surface-container)">
          <span class="w-2.5 h-2.5 rounded-full" style="background-color: <%= @running_timer.project.color %>"></span>
          <span class="text-sm font-medium"><%= @running_timer.project.name %></span>
        </span>
      <% end %>
      <% if @running_timer.task %>
        <span class="text-sm" style="color: var(--color-on-surface-variant)"><%= @running_timer.task.name %></span>
      <% end %>
      <span class="text-sm truncate" style="color: var(--color-on-surface-variant)"><%= @running_timer.description %></span>
    </div>

    <% if @running_timer.tags.any? %>
      <div class="hidden sm:flex gap-1">
        <% @running_timer.tags.each do |tag| %>
          <span class="m3-tag-chip" style="color: <%= tag.color %>; border-color: <%= tag.color %>40; background-color: <%= tag.color %>10"><%= tag.name %></span>
        <% end %>
      </div>
    <% end %>

    <div class="flex items-center gap-1.5 ml-auto">
      <%= button_to stop_timer_path, method: :patch, class: "m3-btn m3-btn-error m3-btn-sm" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><rect x="6" y="6" width="12" height="12" rx="2"/></svg>
        Stop
      <% end %>
      <%= button_to discard_timer_path, method: :delete, class: "m3-icon-btn m3-icon-btn-sm",
          data: { turbo_confirm: "Discard this timer?" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
      <% end %>
    </div>
  </div>
<% else %>
  <div data-controller="timer-mode" class="w-full">
    <%# Timer mode %>
    <div data-timer-mode-target="timerMode">
      <%= form_with url: start_timer_path, method: :post, class: "flex items-center gap-2 w-full" do |f| %>
        <%= f.text_field :description, placeholder: "What are you working on?",
            class: "bg-transparent border-none flex-1 min-w-[120px] text-[0.9375rem] focus:outline-none",
            style: "color: var(--color-on-surface); --tw-placeholder-opacity: 1;",
            placeholder: "What are you working on?" %>

        <div class="h-5 w-px timer-desktop-only" style="background: var(--color-outline-variant)"></div>

        <div class="timer-desktop-only">
          <%= f.select :project_id,
              options_from_collection_for_select(Current.workspace&.projects&.active&.order(:name) || [], :id, :name),
              { include_blank: "Project" },
              class: "m3-timer-pill",
              data: { controller: "task-loader", action: "change->task-loader#load" } %>
        </div>

        <div class="timer-desktop-only">
          <%= f.select :task_id, [],
              { include_blank: "Task" },
              class: "m3-timer-pill" %>
        </div>

        <%# Tag button %>
        <div class="relative timer-desktop-only" data-controller="tag-selector">
          <button type="button" tabindex="0" class="m3-icon-btn m3-icon-btn-sm" onclick="this.nextElementSibling.classList.toggle('hidden')">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 003 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 005.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 009.568 3z" /><path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6z" /></svg>
          </button>
          <div class="hidden absolute right-0 top-full mt-1 m3-menu z-50 w-48">
            <% (Current.workspace&.tags&.order(:name) || []).each do |tag| %>
              <label class="flex items-center gap-2 p-1.5 rounded-[var(--radius-xs)] cursor-pointer" style="transition: background 0.15s" onmouseover="this.style.background='rgba(28,27,31,0.08)'" onmouseout="this.style.background='transparent'">
                <input type="checkbox" name="tag_ids[]" value="<%= tag.id %>" class="m3-checkbox"
                       data-action="change->tag-selector#update" data-tag-selector-target="checkbox">
                <span class="text-xs" style="color: <%= tag.color %>"><%= tag.name %></span>
              </label>
            <% end %>
          </div>
          <div data-tag-selector-target="hiddenInputs"></div>
        </div>

        <button type="button" class="m3-icon-btn m3-icon-btn-sm" data-action="click->timer-mode#toggle" title="Manual entry">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" /></svg>
        </button>

        <button type="submit" class="m3-fab">
          <svg xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Start
        </button>
      <% end %>
    </div>

    <%# Manual mode %>
    <div data-timer-mode-target="manualMode" class="hidden">
      <%= form_with url: time_entries_path, method: :post, class: "flex items-center gap-2 w-full" do |f| %>
        <input type="hidden" name="time_entry[workspace_id]" value="">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" style="color: var(--color-outline)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z" /></svg>
        <%= f.text_field "time_entry[description]", placeholder: "What did you work on?",
            class: "bg-transparent border-none flex-1 min-w-[100px] text-[0.9375rem] focus:outline-none",
            style: "color: var(--color-on-surface)" %>
        <div class="h-5 w-px timer-desktop-only" style="background: var(--color-outline-variant)"></div>
        <div class="timer-desktop-only">
          <%= f.select "time_entry[project_id]",
              options_from_collection_for_select(Current.workspace&.projects&.active&.order(:name) || [], :id, :name),
              { include_blank: "Project" },
              class: "m3-timer-pill",
              data: { controller: "task-loader", action: "change->task-loader#load" } %>
        </div>
        <div class="timer-desktop-only">
          <%= f.select "time_entry[task_id]", [],
              { include_blank: "Task" },
              class: "m3-timer-pill" %>
        </div>
        <div class="h-5 w-px timer-desktop-only" style="background: var(--color-outline-variant)"></div>
        <%= f.datetime_local_field "time_entry[started_at]", value: Time.current.strftime("%Y-%m-%dT%H:%M"),
            class: "bg-transparent border-none text-sm focus:outline-none w-[155px] timer-desktop-only",
            style: "color: var(--color-on-surface-variant)" %>
        <%= f.text_field "time_entry[duration_manual]", placeholder: "0:00",
            class: "bg-transparent border-none text-sm focus:outline-none w-14 text-center mono-duration",
            style: "color: var(--color-on-surface-variant)" %>

        <button type="button" class="m3-icon-btn m3-icon-btn-sm" data-action="click->timer-mode#toggle" title="Timer mode">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M5.25 5.653c0-.856.917-1.398 1.667-.986l11.54 6.348a1.125 1.125 0 010 1.971l-11.54 6.347a1.125 1.125 0 01-1.667-.985V5.653z" /></svg>
        </button>

        <button type="submit" class="m3-fab" style="background: var(--color-success); color: var(--color-on-success);">Save</button>
      <% end %>
    </div>
  </div>
<% end %>
