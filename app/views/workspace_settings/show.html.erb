<div class="max-w-2xl mx-auto space-y-6">
  <h1 class="text-2xl font-bold" style="color: var(--color-on-surface)">Workspace Settings</h1>

  <%= form_with model: Current.workspace, url: workspace_settings_path, method: :patch, class: "space-y-6" do |f| %>
    <% if Current.workspace.errors.any? %>
      <div class="m3-alert m3-alert-error">
        <ul><% Current.workspace.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
      </div>
    <% end %>

    <div class="m3-card-elevated p-6">
      <h2 class="text-lg font-semibold mb-4" style="color: var(--color-on-surface)">General</h2>

      <div class="space-y-4">
        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Workspace Name</label>
          <%= f.text_field :name, class: "m3-text-field w-full", required: true %>
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Default Currency</label>
          <%= f.select :default_currency,
              [["USD ($)", "USD"], ["EUR (\u20AC)", "EUR"], ["GBP (\u00A3)", "GBP"], ["CAD (C$)", "CAD"], ["AUD (A$)", "AUD"], ["JPY (\u00A5)", "JPY"], ["CHF (CHF)", "CHF"], ["PLN (z\u0142)", "PLN"]],
              {}, class: "m3-text-field w-full" %>
        </div>
      </div>
    </div>

    <div class="m3-card-elevated p-6">
      <h2 class="text-lg font-semibold mb-4" style="color: var(--color-on-surface)">Time Tracking</h2>

      <div class="space-y-4">
        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Week Starts On</label>
          <%= f.select :week_start, [["Monday", 1], ["Sunday", 0]],
              {}, class: "m3-text-field w-full" %>
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Time Format</label>
          <%= f.select :time_format, [["24-hour (14:00)", "twenty_four_hour"], ["12-hour (2:00 PM)", "twelve_hour"]],
              {}, class: "m3-text-field w-full" %>
        </div>

        <div class="space-y-1">
          <label class="text-sm font-medium" style="color: var(--color-on-surface-variant)">Default Hourly Rate ($)</label>
          <input type="number" name="workspace[default_hourly_rate_dollars]" step="0.01" min="0"
                 value="<%= Current.workspace.default_hourly_rate_cents ? (Current.workspace.default_hourly_rate_cents / 100.0) : '' %>"
                 class="m3-text-field w-full"
                 placeholder="Default rate for new projects">
        </div>
      </div>
    </div>

    <div class="flex gap-2">
      <%= f.submit "Save Settings", class: "m3-btn m3-btn-filled" %>
    </div>
  <% end %>
</div>
