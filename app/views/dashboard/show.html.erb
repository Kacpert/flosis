<div class="space-y-6">
  <%# Greeting %>
  <div>
    <h1 class="text-2xl font-bold tracking-tight">
      Good <%= Time.current.hour < 12 ? "morning" : Time.current.hour < 17 ? "afternoon" : "evening" %>, <%= current_user.name.split.first %>
    </h1>
    <p class="text-base-content/50 text-sm mt-0.5"><%= Date.current.strftime("%A, %B %-d") %></p>
  </div>

  <%# Empty state for new users %>
  <% if @active_projects_count == 0 && @today_entries.empty? %>
    <div class="stat-card text-center py-10">
      <h2 class="text-lg font-semibold">Welcome to Gold</h2>
      <p class="text-sm text-base-content/50 max-w-sm mx-auto mt-2">Create a project and start your first timer to see how your time flows.</p>
      <div class="flex justify-center gap-3 mt-5">
        <%= link_to new_project_path, class: "btn btn-primary btn-sm" do %>
          Create Project
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Stats — four clean cards, no icon badges. Let the numbers speak. %>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem;">
    <div class="stat-card">
      <div class="stat-label">Today</div>
      <div class="stat-number"><%= format_duration_hm(@today_seconds) %></div>
      <div class="stat-detail"><%= @today_entries.size %> entries</div>
    </div>

    <div class="stat-card">
      <div class="stat-label">This Week</div>
      <div class="stat-number"><%= format_duration_hm(@week_seconds) %></div>
      <div class="stat-detail">
        <% if @last_week_seconds > 0 %>
          <% diff = ((@week_seconds - @last_week_seconds).to_f / @last_week_seconds * 100).round %>
          <span class="<%= diff >= 0 ? 'text-success' : 'text-error' %> font-medium"><%= diff >= 0 ? '+' : '' %><%= diff %>%</span>
          <span class="text-base-content/35">vs last week</span>
        <% else %>
          <span>No data last week</span>
        <% end %>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Billable</div>
      <div class="stat-number text-success"><%= format_duration_hm(@week_billable_seconds) %></div>
      <div class="stat-detail">$<%= '%.2f' % @billable_amount %> this week</div>
    </div>

    <div class="stat-card">
      <div class="stat-label">Active Projects</div>
      <div class="stat-number"><%= @active_projects_count %></div>
      <div class="stat-detail">
        <%= link_to "View all", projects_path, class: "text-primary hover:underline" %>
      </div>
    </div>
  </div>

  <%# Two-column: Breakdown + Recent Entries %>
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem;">
    <%# Today's Breakdown %>
    <div class="stat-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-header">Today's Breakdown</h2>
        <span class="text-xs text-base-content/40 mono-duration"><%= format_duration_hm(@today_seconds) %></span>
      </div>

      <% if @projects_breakdown.any? %>
        <div class="breakdown-bar mb-5">
          <% total = @projects_breakdown.values.sum.to_f %>
          <% @projects_breakdown.each do |(name, color), seconds| %>
            <div style="width: <%= (seconds / total * 100).round(1) %>%; background-color: <%= color %>;" title="<%= name %>: <%= format_duration_hm(seconds) %>"></div>
          <% end %>
        </div>

        <div class="space-y-2.5">
          <% @projects_breakdown.each do |(name, color), seconds| %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background-color: <%= color %>"></span>
                <span class="text-sm font-medium"><%= name %></span>
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs text-base-content/40 w-8 text-right"><%= total > 0 ? (seconds / total * 100).round : 0 %>%</span>
                <span class="text-sm font-medium mono-duration w-14 text-right"><%= format_duration_hm(seconds) %></span>
              </div>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state py-8">
          <div class="empty-state-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <p class="empty-state-title">No time tracked today</p>
          <p class="empty-state-desc">Start a timer to see your breakdown</p>
        </div>
      <% end %>
    </div>

    <%# Recent Entries %>
    <div class="stat-card">
      <div class="flex items-center justify-between mb-4">
        <h2 class="section-header">Recent Entries</h2>
        <%= link_to "View all", time_entries_path, class: "text-xs text-primary hover:underline" %>
      </div>

      <% if @today_entries.any? %>
        <div class="space-y-0.5">
          <% @today_entries.first(6).each do |entry| %>
            <div class="flex items-center gap-3 p-2 rounded-lg hover:bg-base-200/50 transition-colors group">
              <span class="w-0.5 h-7 rounded-full flex-shrink-0" style="background-color: <%= entry.project&.color || '#CBD5E1' %>"></span>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium truncate"><%= entry.description.presence || "No description" %></div>
                <div class="text-xs text-base-content/45">
                  <%= entry.project&.name %><% if entry.task %> · <%= entry.task.name %><% end %>
                </div>
              </div>
              <span class="mono-duration text-sm text-base-content/60"><%= entry.formatted_duration %></span>
              <%= button_to start_timer_path(description: entry.description, project_id: entry.project_id, task_id: entry.task_id),
                  method: :post, class: "btn btn-ghost btn-xs opacity-0 group-hover:opacity-100 transition-opacity", title: "Continue" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state py-8">
          <div class="empty-state-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          </div>
          <p class="empty-state-title">No entries today yet</p>
          <p class="empty-state-desc">Start tracking to see entries here</p>
        </div>
      <% end %>
    </div>
  </div>
</div>
