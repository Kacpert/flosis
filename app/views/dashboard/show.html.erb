<div class="space-y-6">
  <%# Greeting %>
  <div>
    <h1 class="text-2xl font-bold">
      Good <%= Time.current.hour < 12 ? "morning" : Time.current.hour < 17 ? "afternoon" : "evening" %>, <%= current_user.name.split.first %>
    </h1>
    <p class="text-base-content/60 mt-1"><%= Date.current.strftime("%A, %B %d, %Y") %></p>
  </div>

  <%# Empty state for new users %>
  <% if @active_projects_count == 0 && @today_entries.empty? %>
    <div class="card bg-gradient-to-r from-primary/5 to-secondary/5 border border-primary/10">
      <div class="card-body text-center py-12">
        <div class="text-5xl mb-4">&#9201;</div>
        <h2 class="text-xl font-bold">Welcome to Gold!</h2>
        <p class="text-base-content/60 max-w-md mx-auto mt-2">Start tracking your time to gain insights into how you spend your day. Create a project and start your first timer.</p>
        <div class="flex justify-center gap-3 mt-6">
          <%= link_to new_project_path, class: "btn btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Create Project
          <% end %>
          <button class="btn btn-ghost" onclick="document.querySelector('input[name=description]')?.focus()">Start Timer</button>
        </div>
      </div>
    </div>
  <% end %>

  <%# Stats Grid %>
  <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;">
    <%# Today card with primary accent %>
    <div class="bg-base-100 shadow-sm border border-base-300/50 rounded-xl">
      <div class="p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-base-content/60">Today</span>
          <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span class="text-2xl font-bold"><%= format_duration_hm(@today_seconds) %></span>
        </div>
        <div class="text-xs text-base-content/50 mt-1"><%= @today_entries.size %> entries</div>
      </div>
    </div>

    <%# This Week with comparison arrow %>
    <div class="bg-base-100 shadow-sm border border-base-300/50 rounded-xl">
      <div class="p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-base-content/60">This Week</span>
          <div class="w-8 h-8 rounded-lg bg-info/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span class="text-2xl font-bold"><%= format_duration_hm(@week_seconds) %></span>
        </div>
        <div class="text-xs mt-1">
          <% if @last_week_seconds > 0 %>
            <% diff = ((@week_seconds - @last_week_seconds).to_f / @last_week_seconds * 100).round %>
            <span class="inline-flex items-center gap-0.5 <%= diff >= 0 ? 'text-success' : 'text-error' %>">
              <% if diff >= 0 %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
              <% else %>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
              <% end %>
              <%= diff.abs %>%
            </span>
            <span class="text-base-content/40">vs last week</span>
          <% else %>
            <span class="text-base-content/40">No data last week</span>
          <% end %>
        </div>
      </div>
    </div>

    <%# Billable %>
    <div class="bg-base-100 shadow-sm border border-base-300/50 rounded-xl">
      <div class="p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-base-content/60">Billable</span>
          <div class="w-8 h-8 rounded-lg bg-success/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span class="text-2xl font-bold text-success"><%= format_duration_hm(@week_billable_seconds) %></span>
        </div>
        <div class="text-xs text-base-content/50 mt-1">$<%= '%.2f' % @billable_amount %> this week</div>
      </div>
    </div>

    <%# Active Projects %>
    <div class="bg-base-100 shadow-sm border border-base-300/50 rounded-xl">
      <div class="p-4">
        <div class="flex items-center justify-between">
          <span class="text-sm font-medium text-base-content/60">Active Projects</span>
          <div class="w-8 h-8 rounded-lg bg-warning/10 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
          </div>
        </div>
        <div class="mt-2">
          <span class="text-2xl font-bold"><%= @active_projects_count %></span>
        </div>
        <div class="text-xs text-base-content/50 mt-1">
          <%= link_to "View all →", projects_path, class: "hover:text-primary" %>
        </div>
      </div>
    </div>
  </div>

  <%# Two column layout %>
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem;">
    <%# Today's Breakdown %>
    <div class="card bg-base-100 shadow-sm border border-base-300/50">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-semibold">Today's Breakdown</h2>
          <span class="text-sm text-base-content/50"><%= format_duration_hm(@today_seconds) %> total</span>
        </div>
        <% if @projects_breakdown.any? %>
          <%# Stacked bar at top %>
          <div class="flex rounded-full h-3 overflow-hidden mb-6 bg-base-200">
            <% total = @projects_breakdown.values.sum.to_f %>
            <% @projects_breakdown.each do |(name, color), seconds| %>
              <div style="width: <%= (seconds / total * 100).round(1) %>%; background-color: <%= color %>" title="<%= name %>: <%= format_duration_hm(seconds) %>"></div>
            <% end %>
          </div>

          <div class="space-y-3">
            <% @projects_breakdown.each do |(name, color), seconds| %>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full" style="background-color: <%= color %>"></span>
                  <span class="text-sm font-medium"><%= name %></span>
                </div>
                <div class="flex items-center gap-3">
                  <span class="text-sm text-base-content/50"><%= total > 0 ? (seconds / total * 100).round : 0 %>%</span>
                  <span class="text-sm font-mono font-medium"><%= format_duration_hm(seconds) %></span>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="text-4xl mb-3">&#9728;&#65039;</div>
            <p class="text-base-content/50">No time tracked today</p>
            <p class="text-sm text-base-content/40 mt-1">Start a timer to see your breakdown</p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Recent Entries %>
    <div class="card bg-base-100 shadow-sm border border-base-300/50">
      <div class="card-body">
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-semibold">Recent Entries</h2>
          <%= link_to "View all →", time_entries_path, class: "text-sm text-primary hover:underline" %>
        </div>
        <% if @today_entries.any? %>
          <div class="space-y-1">
            <% @today_entries.first(6).each do |entry| %>
              <div class="flex items-center gap-3 p-2.5 rounded-lg hover:bg-base-200/50 transition-colors group">
                <% if entry.project %>
                  <span class="w-2 h-8 rounded-full flex-shrink-0" style="background-color: <%= entry.project.color %>"></span>
                <% else %>
                  <span class="w-2 h-8 rounded-full flex-shrink-0 bg-base-300"></span>
                <% end %>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium truncate"><%= entry.description.presence || "No description" %></div>
                  <div class="text-xs text-base-content/50">
                    <%= entry.project&.name %>
                    <% if entry.task %> &middot; <%= entry.task.name %><% end %>
                  </div>
                </div>
                <span class="font-mono text-sm font-medium text-base-content/70"><%= entry.formatted_duration %></span>
                <%= button_to start_timer_path(description: entry.description, project_id: entry.project_id, task_id: entry.task_id),
                    method: :post, class: "btn btn-ghost btn-xs opacity-0 group-hover:opacity-100 transition-opacity", title: "Continue" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                <% end %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="text-center py-8">
            <div class="text-4xl mb-3">&#128221;</div>
            <p class="text-base-content/50">No entries today yet</p>
            <p class="text-sm text-base-content/40 mt-1">Start tracking to see your entries here</p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
