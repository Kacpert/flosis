  [1m[36mTask Update (1.6ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:37.271623', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"I invited Dan Hi Dan to Bright Data. A company that develops LinkedIn Scraper API we may be able to use and also they have access to millions of already scraped profiles. I think we can change our Plugin to work with their API so we do not have to maintain our own scraper when linkedin changes something - they have a full time working 24/7 to keep the scraper alive and it is low cost."}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Keep the LinkedIN Plugin"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Sent the profile URL to the service through the API "}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Make sure that it can be ranned on the background (recruiter can switch between profiles during the scanning process) "}]}]}]}]}' WHERE "tasks"."id" = 138 /*application='Gold'*/[0m
