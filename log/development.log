  [1m[36mTask Update (1.9ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:37.483072', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"AWS has sent a notification regarding the upcoming expiration of SSL/TLS certificates for Amazon RDS and Aurora database instances in the EU-WEST-1 Region. "},{"type":"hardBreak"},{"type":"text","text":"We need to make the transition of these certificates to prevent connectivity failures to existing database instances."}]},{"type":"paragraph","content":[{"type":"text","text":"Message is attached below:","marks":[{"type":"strong"}]},{"type":"hardBreak"},{"type":"mediaInline","attrs":{"id":"cb03b07a-91c2-4eed-8461-c680540ff06f","collection":"","type":"file"}},{"type":"text","text":" "}]},{"type":"paragraph","content":[{"type":"text","text":"ToDo:"}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Update Client Trust Store:","marks":[{"type":"strong"}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Update the trust stores of client applications with the new CA certificates provided by RDS. These certificates can be downloaded from the AWS User Guide. Refer to documentation [3] for detailed instructions on updating trust stores."}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Update Server Certificates:","marks":[{"type":"strong"}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Identify all affected database instances listed in the ''Affected resources'' tab of the AWS Health Dashboard."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Update the SSL/TLS certificates on these instances to one of the newly issued CAs (''rds-ca-rsa2048-g1'' is recommended). Ensure compatibility with your client setup through thorough testing. Refer to documentation [4] for more information on new CAs."}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Set Account Level CA Override (Optional):","marks":[{"type":"strong"}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"If you choose to use a different CA than the default ''rds-ca-rsa2048-g1'', set an account level CA override. Utilize the modify-certificates API provided by AWS CLI version 1.17 or later. Refer to documentation [1] for API details."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Use the describe-certificates API to verify current default CA override settings. If necessary, use the ca-certificate-identifier option on the create-db-instance API to specify a specific CA during instance creation. Refer to documentation [5] and [6] for API details."}]}]}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"Deadline:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Immediate Action Required:","marks":[{"type":"strong"}]},{"type":"text","text":" Update client trust store and then update server certificates on affected instances."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"After January 26, 2024:","marks":[{"type":"strong"}]},{"type":"text","text":" New database instances default to using the ''rds-ca-rsa2048-g1'' certificate. Specify desired certificates for new instances using AWS console or CLI."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Before August 22, 2024:","marks":[{"type":"strong"}]},{"type":"text","text":" ''rds-ca-2019'' will expire. Complete all certificate updates to prevent connectivity failures to existing database instances."}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"References:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"AWS User Guide for CA certificates download links","marks":[{"type":"link","attrs":{"href":"https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/UsingWithRDS.SSL.html#UsingWithRDS.SSL.CertificatesAllRegions"}}]},{"type":"text","text":" [2]."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Amazon RDS instances documentation","marks":[{"type":"link","attrs":{"href":"https://docs.aws.amazon.com/AmazonRDS/latest/UserGuide/UsingWithRDS.SSL-certificate-rotation.html"}}]},{"type":"text","text":" [7]."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Amazon Aurora instances documentation","marks":[{"type":"link","attrs":{"href":"https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/UsingWithRDS.SSL-certificate-rotation.html"}}]},{"type":"text","text":" [8]."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"AWS modify-certificates API documentation","marks":[{"type":"link","attrs":{"href":"https://docs.aws.amazon.com/cli/latest/reference/rds/modify-certificates.html"}}]},{"type":"text","text":" [1]."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"AWS describe-certificates API documentation","marks":[{"type":"link","attrs":{"href":"https://docs.aws.amazon.com/cli/latest/reference/rds/describe-certificates.html"}}]},{"type":"text","text":" [5]."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"AWS create-db-instance API documentation","marks":[{"type":"link","attrs":{"href":"https://docs.aws.amazon.com/cli/latest/reference/rds/create-db-instance.html"}}]},{"type":"text","text":" [6]."}]}]}]}]}' WHERE "tasks"."id" = 182 /*application='Gold'*/[0m
