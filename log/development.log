  [1m[36mTask Update (1.1ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:37.493497', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"UPDATE 12.01","marks":[{"type":"strong"}]},{"type":"hardBreak"},{"type":"text","text":"Currently, we have around 170 CircleCI tests which are failing. We’re going to ‘flag-out’ all of them and fix them 2 times per sprint (1 day per week)."},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"Process:","marks":[{"type":"strong"}]},{"type":"hardBreak"},{"type":"text","text":"Regarding the CircleCI tests, we have discussed how to approach this and have reached the following resolution:"}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Divide tests among developers by category (for instance, Dan is more familiar with the calendar will take calendar-related tests, while Marcin will handle contract module tests due to his knowledge in that area of the application)."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Developer should mark which test you are currently working on to avoid confusion and ensure visibility of who is working on which tests in development: "},{"type":"inlineCard","attrs":{"url":"https://docs.google.com/document/d/12rlPdb_j1V8PH9qzrG2lbUMboDXjiJGJoiafJ9PfQJU/edit"}},{"type":"text","text":" "}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Rewrite tests that are no longer relevant instead of deleting them."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Kacper suggested creating a separate branch and deploying file by file (for instance, one file may contain multiple tests, and after a developer fixes them all, they commit immediately to the branch)."}]}]}]},{"type":"mediaSingle","attrs":{"layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"fe11bb04-4c52-486c-832a-ee9d6901d6f1","collection":"","height":294,"width":1450}}]}]}' WHERE "tasks"."id" = 184 /*application='Gold'*/[0m
