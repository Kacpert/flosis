  [1m[36mTask Update (2.0ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:37.281780', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"As a recruiter I would like to be able to transfer hired candidates basic data to Timeplan (workforce management system)"},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"The integration is similar to:"}]},{"type":"paragraph","content":[{"type":"hardBreak"},{"type":"text","text":"Tamigo"},{"type":"hardBreak"},{"type":"text","text":"Quinyx"},{"type":"hardBreak"},{"type":"text","text":"2People"},{"type":"hardBreak"},{"type":"text","text":"Catalystone"},{"type":"hardBreak"},{"type":"text","text":"Sympa"}]},{"type":"paragraph"},{"type":"paragraph","content":[{"type":"text","text":"Documentation attached "},{"type":"hardBreak"},{"type":"text","text":"Sandbox ETA Dec 4th and we will have a meeting with their architect"}]}]}' WHERE "tasks"."id" = 140 /*application='Gold'*/[0m
