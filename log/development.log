  [1m[36mTask Update (2.2ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:36.955300', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"User story"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"As a product owner, when a child organisation is created, I want it to have the same settings as the HQ so that it ensures consistency across organisations."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"As a product owner, when an existing child organisation is present, I want the option to \"copy settings from HQ\" so that I can easily update its settings to match HQ."}]}]}]},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"Context"}]},{"type":"paragraph","content":[{"type":"text","text":"The product owner requires that child organisations have identical settings to the HQ. This includes both newly created child organisations and existing ones."}]},{"type":"heading","attrs":{"level":2},"content":[{"type":"text","text":"Acceptance criteria"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Newly created child organisations must inherit the same settings as the HQ."}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Existing child organisations must have an option to \"copy settings from HQ\""}]}]}]}]}' WHERE "tasks"."id" = 77 /*application='Gold'*/[0m
