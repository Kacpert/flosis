  [1m[36mTask Update (2.5ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:36.680928', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"I think we should not have an organization flag to enable the requisition feature - it should be a level in the user role. Please recompose you answer and make it less technical and more suitable for a product owner."}]},{"type":"paragraph","content":[{"type":"text","text":"Thoughtfor 9s"}]},{"type":"paragraph","content":[{"type":"text","text":"3 of 9 DoneView all"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Add org-level setting to enable position requisition approvals","marks":[{"type":"strike"}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Create PositionRequisition model with state machine and associations"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Hook publish guard in Position to require approved requisition based on role policy"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Add minimal UI: role-based setup and approval inbox"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Define role/permission policy for requisition requirement and approver capability"}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"Thoughtfor 4s"}]},{"type":"paragraph","content":[{"type":"text","text":"I’ve adjusted the approach to be role-based (no organization toggle) and reframed it for product and stakeholders."}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"What we’re solving"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"As an organization owner, I want a recruitment requisition flow before a position can be posted, so we can control headcount and spend."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Roles and permissions"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Creator: Anyone allowed to create a draft position."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Approver: Users with an “Approver” capability in their role (e.g., Owner, HR Lead, Finance). You decide which roles have this."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Optional: Delegated approvers at department level (later phase)."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"How the flow works"}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Draft creation"}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Recruiter creates a draft position as today."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"If their role requires approval, they see a banner: “Approval required to publish”. A “Request approval” button opens the requisition form."}]}]}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Requisition request"}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Form collects: job title, department, headcount, budget (optional), justification."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"On submit, approvers are notified and the draft shows “Approval pending”."}]}]}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Approve or reject"}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Approvers see an inbox of pending requisitions (filters by department if needed)."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Approve: the associated draft can be published immediately."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Reject: the recruiter is notified with the reason and can resubmit."}]}]}]},{"type":"orderedList","attrs":{"order":1},"content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Publish control"}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Users whose role requires approval cannot publish unless the linked requisition is approved."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Users with publish rights and “Approver” capability can publish without requesting, or they can approve and publish in one step."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"What changes for users"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Recruiters: One extra step before publishing when their role requires it (quick form + status chip)."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Approvers: A simple inbox to review and decide, with email notifications and one-click actions."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Owners/Admins: Decide which roles require approval and which roles can approve."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Default configuration"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Out of the box:"}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Recruiters require approval before publishing."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Owners and HR Leads can approve."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"You can adjust which roles require approval and which can approve."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Edge cases and safeguards"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Multiple drafts for the same role/team: each draft needs approval; we’ll show a helpful hint if a similar requisition was recently approved."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Changes after approval: significant changes (e.g., department or headcount) trigger a “re-approval required” badge."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Time-bound approvals (optional): approvals can expire after X days."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Reporting and oversight"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Dashboard cards:"}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"“Pending requisitions” count by department."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"“Time to approval” median and outliers."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Export: list of approvals with requester, approver, timestamps, and notes."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Phase 2 ideas (optional)"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Multi-step approvals (e.g., Department → Finance → HR)."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Budget caps per department with auto-routing."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"SLA nudges and escalations."}]}]}]},{"type":"heading","attrs":{"level":3},"content":[{"type":"text","text":"Rollout plan"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Week 1: Enable permissions for roles, add requisition request UI, single-step approval, and publish gating."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Week 2: Add approver inbox, notifications, and basic reporting."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Week 3+: Add re-approval on major changes and (optionally) expirations."}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"Status update: I replaced the organization toggle with a role-based requirement and simplified the flow for a product owner audience, including roles, user experience, and rollout."}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Roles determine who needs approval and who can approve."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Recruiters request; approvers decide; publish is blocked until approval for those roles."}]}]}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Minimal changes to current drafting flow; clear status and notifications."}]}]}]}]}' WHERE "tasks"."id" = 33 /*application='Gold'*/[0m
