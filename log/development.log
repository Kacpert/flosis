on from us."}]}]}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"We could consider using position labels as part of this module for example some fixed Elvium labels like “Response missing”, “No hires”, “Attention needed”"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Notification on dashboard in todo section and via. email // consider notification center like in HR"}]}]}]}]}' WHERE "tasks"."id" = 239 /*application='Gold'*/[0m
