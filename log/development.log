  [1m[36mTask Update (1.3ms)[0m  [1m[33mUPDATE "tasks" SET "updated_at" = '2026-03-16 20:11:37.488653', "description_adf" = '{"type":"doc","version":1,"content":[{"type":"paragraph","content":[{"type":"text","text":"Link: "},{"type":"text","text":"https://appsignal.com/softmaker-1/sites/5b02aa812213934f854d766b/exceptions","marks":[{"type":"link","attrs":{"href":"https://appsignal.com/softmaker-1/sites/5b02aa812213934f854d766b/exceptions"}}]},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"Regarding the AppSignals, which we will start fixing immediately after the tests:"}]},{"type":"bulletList","content":[{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Sort the list of AppSignal by “last” and take the item at the top of the list."},{"type":"hardBreak"}]},{"type":"mediaSingle","attrs":{"layout":"align-start"},"content":[{"type":"media","attrs":{"type":"file","id":"57c88302-a57d-424a-acf6-b009689bf54b","collection":"","height":169,"width":200}}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"For each of these issues a task should be created in Jira."},{"type":"hardBreak"},{"type":"hardBreak"},{"type":"text","text":"Workflow for devs:"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"Change the status of the task which you took from “To Do” to “In Progress”"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"If you wasn’t able to make a fix → write a report in comments → move to “Blocked”"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"If you prepared a fix → post a PR → move to “Done”"}]}]},{"type":"listItem","content":[{"type":"paragraph","content":[{"type":"text","text":"If you (as a developer) encounter something unclear or difficult to understand the cause of/re-create the issue, "},{"type":"text","text":"write a detailed report","marks":[{"type":"strong"}]},{"type":"text","text":" on what you were able to find out while investigating the task. Then, move on to the next task. In this case, "},{"type":"text","text":"the quantity of fixed issues is a priority.","marks":[{"type":"strong"}]},{"type":"hardBreak"}]}]}]},{"type":"paragraph","content":[{"type":"text","text":"At the end of the sprint, we will collectively review what we couldn''t fix and decide whether to postpone this task for the future or get back to it now."}]}]}' WHERE "tasks"."id" = 183 /*application='Gold'*/[0m
